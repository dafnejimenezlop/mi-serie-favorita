---
// src/components/AsistenteWinden.astro
// Asistente guiado (sin backend): un menú de respuestas rápidas
// predefinidas presentado como conversación. Todo el contenido es estático,
// igual que el resto del sitio — no hay IA ni llamadas a ningún servicio.
import { recommendations } from '../data/recomendaciones';
import { songs } from '../data/bandaSonora';

// Las cifras de las respuestas estaban escritas a mano y se quedaron atrás
// cuando crecieron los datos: el asistente prometía "quince candidatas"
// cuando ya había 24, y la propia sección, dos clics después, mostraba
// "24 Títulos". Ahora salen de la misma fuente que la sección.
const totalRecomendaciones = recommendations.length;
const totalCanciones = songs.length;

const icons: Record<string, string> = {
  sparkles: 'M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z',
  loop: 'M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15',
  users: 'M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87m6-1.13a4 4 0 10-4-4 4 4 0 004 4zm6-1a4 4 0 10-4-4',
  info: 'M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  calendar: 'M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z',
  music: 'M9 19V6l12-2v13M9 19a3 3 0 11-6 0 3 3 0 016 0zm12-2a3 3 0 11-6 0 3 3 0 016 0z',
  bulb: 'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z',
  play: 'M14 4h6m0 0v6m0-6L10 14M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4',
  eye: 'M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z M15 12a3 3 0 11-6 0 3 3 0 016 0z',
  send: 'M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z',
};

// El panel abría con las doce preguntas a la vez, en una rejilla con scroll
// propio: un muro de opciones justo cuando el usuario todavía no sabe qué
// quiere. Se entra por estos cuatro temas y cada paso enseña como mucho
// cuatro botones — la conversación estrecha en vez de volcarlo todo.
const temas = [
  {
    id: 'trama',
    label: 'Entender la trama',
    hint: 'El final, los mundos, el 33',
    icon: 'loop',
  },
  {
    id: 'sitio',
    label: 'Recorrer el archivo',
    hint: 'Resumen, familias, música',
    icon: 'calendar',
  },
  {
    id: 'empezar',
    label: 'Aún no la he visto',
    hint: 'Por dónde empezar, sin spoilers',
    icon: 'eye',
  },
  {
    id: 'proyecto',
    label: 'Sobre este sitio',
    hint: 'Quién lo hace y cómo escribirme',
    icon: 'info',
  },
];

const quickReplies = [
  {
    id: 'recomienda',
    tema: 'sitio',
    label: 'Recomiéndame algo',
    icon: 'sparkles',
    reply:
      `Si ya te has terminado DARK, tengo ${totalRecomendaciones} candidatas a tu próxima obsesión: de "1899" (de los mismos creadores) a "Twin Peaks". Puedes filtrarlas por plataforma.`,
    cta: { label: 'Ver recomendaciones', href: '#recomendaciones' },
  },
  {
    id: 'final',
    tema: 'trama',
    label: 'No entiendo el final',
    icon: 'loop',
    reply:
      'Tranquilo, a casi todo el mundo le pasa. La clave está en entender que no son dos mundos, sino tres: el Mundo de Adam, el Mundo de Eva y el Origen. Lo desgloso con calma en Aclaraciones.',
    cta: { label: 'Leer la explicación completa', href: '#aclaraciones' },
  },
  {
    id: 'quien-es-quien',
    tema: 'trama',
    label: '¿Quién es quién?',
    icon: 'users',
    reply:
      'Con cuatro familias y hasta cuatro versiones de cada personaje en distintas épocas, es normal perderse. Tienes el árbol genealógico completo, interactivo, por familia.',
    cta: { label: 'Explorar las familias', href: '#personajes' },
  },
  {
    id: 'resumen',
    tema: 'sitio',
    label: 'Resumen de temporadas',
    icon: 'calendar',
    reply:
      '26 episodios, tres temporadas, un solo misterio. Tienes el resumen de cada temporada explicado por bloques, con vídeo incluido.',
    cta: { label: 'Ver resumen', href: '#resumen' },
  },
  {
    id: 'banda-sonora',
    tema: 'sitio',
    label: 'Banda sonora y fotos',
    icon: 'music',
    reply:
      `La música de DARK está elegida con muchísimo mimo. Tienes las ${totalCanciones} canciones de la serie para escuchar, más una galería de fotogramas.`,
    cta: { label: 'Escuchar y ver', href: '#galeria' },
  },
  {
    id: 'numero-33',
    tema: 'trama',
    label: '¿Qué significa el 33?',
    icon: 'bulb',
    reply:
      'Es el ciclo que tarda la órbita de la luna en concordar con el sol — y el número que une todas las líneas temporales de la serie (1953, 1986, 2019...). Hay más simbología como esta en Aclaraciones.',
    cta: { label: 'Ver simbología', href: '#aclaraciones' },
  },
  {
    id: 'orden',
    tema: 'empezar',
    label: '¿En qué orden la veo?',
    icon: 'calendar',
    reply:
      'Las tres temporadas se ven en orden, episodio a episodio — DARK no es una antología. Si vienes con dudas de la trama antes de continuar, tienes el resumen completo por temporada.',
    cta: { label: 'Ver resumen', href: '#resumen' },
  },
  {
    id: 'sic-mundus',
    tema: 'trama',
    label: '¿Qué es Sic Mundus?',
    icon: 'loop',
    reply:
      'La organización de viajeros del tiempo liderada por Adam, con origen en 1921. Su nombre en latín significa "y así se creó el mundo". Tienes toda la simbología de la serie explicada con calma en Aclaraciones.',
    cta: { label: 'Ver simbología', href: '#aclaraciones' },
  },
  {
    id: 'nuevo-espectador',
    tema: 'empezar',
    label: 'Nunca he visto la serie',
    icon: 'eye',
    reply:
      'Buena decisión pasar primero por aquí. Evita Resumen y Aclaraciones por ahora — van cargados de spoilers — y empieza directamente por la serie. Vuelve cuando la termines para desentrañarla con calma.',
    cta: { label: 'Ver DARK en Netflix', href: 'https://www.netflix.com/title/80100172', external: true },
  },
  {
    id: 'sobre-el-sitio',
    tema: 'proyecto',
    label: 'Sobre este sitio',
    icon: 'info',
    reply:
      'Este es un proyecto de fan hecho con cariño: resumen de temporadas, aclaraciones, árbol genealógico, banda sonora y recomendaciones. No está afiliado con Netflix.',
    cta: null,
  },
  {
    id: 'sugerencia',
    tema: 'proyecto',
    label: '¿Alguna sugerencia o fallo?',
    icon: 'send',
    reply:
      'Toda ayuda es bienvenida. Escríbeme directamente por WhatsApp y lo reviso en persona.',
    cta: { label: 'Escribir por WhatsApp', href: 'https://wa.me/34644594975?text=Hola!%20Tengo%20una%20sugerencia%20sobre%20la%20web%20de%20DARK.', external: true },
  },
  {
    id: 'ver-dark',
    tema: 'empezar',
    label: 'Ver DARK en Netflix',
    icon: 'play',
    reply: 'Aquí la tienes, directa desde la fuente. Que disfrutes el viaje — o el bucle.',
    cta: { label: 'Abrir en Netflix', href: 'https://www.netflix.com/title/80100172', external: true },
  },
];
---

<div id="asistente-winden-root" class="fixed bottom-6 right-6 z-[105] flex flex-col items-end">
  <!-- Panel del asistente -->
  <div
    id="asistente-panel"
    role="dialog"
    aria-label="Asistente de Winden"
    aria-hidden="true"
    class="hidden mb-4 w-[calc(100vw-3rem)] max-w-sm sm:w-96 h-[34rem] max-h-[80vh] flex-col rounded-2xl border border-stone-700/60 bg-stone-950/95 backdrop-blur-xl shadow-2xl shadow-black/50 overflow-hidden origin-bottom-right opacity-0 scale-95 translate-y-2 transition-all duration-300 ease-out"
  >
    <div
      class="shrink-0 flex items-center justify-between gap-3 px-4 md:px-5 py-4 border-b border-stone-800 bg-stone-900/80"
    >
      <div class="flex items-center gap-3 min-w-0">
        <div
          class="relative shrink-0 w-9 h-9 rounded-full bg-black border border-amber-500/40 flex items-center justify-center"
        >
          <svg class="w-4 h-4 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.8"
              d="M8 10.5h.01M12 10.5h.01M16 10.5h.01M21 12c0 4.418-4.03 8-9 8-1.06 0-2.077-.162-3.02-.46L3 21l1.53-3.83A7.947 7.947 0 013 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
            ></path>
          </svg>
          <span
            class="absolute -bottom-0.5 -right-0.5 w-2.5 h-2.5 rounded-full bg-amber-500 border-2 border-stone-950"
          ></span>
        </div>
        <div class="min-w-0">
          <p class="font-cinzel text-xs tracking-[0.2em] uppercase text-amber-500 font-bold truncate">
            Asistente de Winden
          </p>
          <p class="flex items-center gap-1.5 text-[10px] text-stone-500 font-mono tracking-wide">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
            En línea
          </p>
        </div>
      </div>
      <button
        type="button"
        id="asistente-close"
        aria-label="Cerrar asistente"
        class="shrink-0 p-1.5 rounded-full text-stone-400 hover:text-amber-500 hover:bg-stone-800 transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"
          ></path>
        </svg>
      </button>
    </div>

    <div
      id="asistente-transcript"
      role="log"
      aria-live="polite"
      class="flex-1 min-h-0 overflow-y-auto custom-scrollbar px-4 py-4 space-y-3"
    >
      <div class="asistente-bubble asistente-bubble--bot flex items-end gap-2 max-w-[88%] w-fit">
        <span
          aria-hidden="true"
          class="shrink-0 w-6 h-6 rounded-full bg-black border border-amber-500/40 flex items-center justify-center"
        >
          <svg class="w-3 h-3 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.8"
              d="M8 10.5h.01M12 10.5h.01M16 10.5h.01M21 12c0 4.418-4.03 8-9 8-1.06 0-2.077-.162-3.02-.46L3 21l1.53-3.83A7.947 7.947 0 013 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
            ></path>
          </svg>
        </span>
        <span class="flex flex-col gap-1 min-w-0">
          <p class="text-sm leading-relaxed bg-stone-800 text-stone-200 rounded-2xl rounded-bl-sm px-4 py-2.5">
            Hola, soy el asistente de este archivo. ¿En qué te ayudo?
          </p>
          <span class="asistente-timestamp pl-1 text-[10px] font-mono tracking-wide text-stone-600"></span>
        </span>
      </div>
    </div>

    <!-- Zona de sugerencias. Arranca con los cuatro temas; a partir de ahí
         la rellena el script según dónde esté la conversación. Al ser como
         mucho cuatro botones, ya no necesita scroll propio dentro de un panel
         que ya se desplaza. -->
    <div class="shrink-0 border-t border-stone-800 bg-stone-950/80">
      <div class="flex items-center justify-between gap-2 px-4 pt-2.5 pb-1.5">
        <p
          id="asistente-sugerencias-titulo"
          class="font-mono text-[9px] tracking-[0.25em] uppercase text-stone-600"
        >
          ¿Por dónde empezamos?
        </p>
        <button
          type="button"
          id="asistente-volver"
          class="hidden items-center gap-1 rounded-full border border-stone-700 px-2 py-1 font-mono text-[9px] uppercase tracking-widest text-stone-400 hover:border-amber-500/60 hover:text-amber-500 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400"
        >
          <svg
            class="w-2.5 h-2.5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="3"
              d="M15 19l-7-7 7-7"></path>
          </svg>
          Temas
        </button>
      </div>
      <div
        id="asistente-sugerencias"
        class="grid grid-cols-1 gap-2 px-3 pb-3"
        aria-live="polite"
      >
        {
          temas.map((tema) => (
            <button
              type="button"
              data-asistente-tema={tema.id}
              class="asistente-chip flex items-center gap-3 rounded-xl border border-stone-700 bg-stone-900 px-3 py-2.5 text-left text-stone-300 hover:border-amber-500/60 hover:text-amber-500 hover:bg-stone-800 hover:-translate-y-0.5 transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400"
            >
              <svg
                class="w-4 h-4 shrink-0 text-amber-500/80"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.8"
                  d={icons[tema.icon]}
                />
              </svg>
              <span class="min-w-0">
                <span class="block text-[12px] font-semibold leading-tight">
                  {tema.label}
                </span>
                <span class="block text-[10px] leading-tight text-stone-500">
                  {tema.hint}
                </span>
              </span>
            </button>
          ))
        }
      </div>
    </div>
  </div>

  <!-- Aviso de descubrimiento: aparece una sola vez, unos segundos después de
       cargar, y no vuelve (queda registrado en localStorage). El asistente es
       la pieza más útil para quien llega perdido con la trama, pero un icono
       mudo en una esquina no se pulsa; una frase corta sí. -->
  <div
    id="asistente-nudge"
    class="hidden mb-3 mr-1 max-w-[15rem] items-start gap-2 rounded-2xl rounded-br-sm border border-amber-500/30 bg-stone-950/95 backdrop-blur-md px-3.5 py-2.5 shadow-2xl shadow-black/50 opacity-0 translate-y-2 transition-all duration-300"
  >
    <p class="text-[11px] leading-snug text-stone-300">
      ¿Te has perdido con la trama? Pregúntame.
    </p>
    <button
      type="button"
      id="asistente-nudge-close"
      aria-label="Descartar aviso"
      class="shrink-0 -mt-0.5 -mr-1 p-1 rounded-full text-stone-500 hover:text-amber-500 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400"
    >
      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <!-- Botón flotante.
       Sube de 44px a 56px y pasa a fondo ámbar sólido: como acción primaria
       de la columna flotante competía con el botón de WhatsApp, que era el
       único con color de relleno y se llevaba toda la atención. -->
  <button
    type="button"
    id="asistente-toggle"
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-controls="asistente-panel"
    aria-label="Abrir asistente de Winden"
    class="group relative w-14 h-14 rounded-full bg-amber-500 text-black shadow-[0_8px_24px_-6px_rgba(245,158,11,0.65)] flex items-center justify-center hover:bg-amber-400 hover:-translate-y-1 active:scale-95 transition-all duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-300 focus-visible:ring-offset-2 focus-visible:ring-offset-black"
  >
    <span
      id="asistente-ping"
      aria-hidden="true"
      class="absolute inset-0 rounded-full ring-2 ring-amber-500/60 pointer-events-none"
    ></span>
    <svg
      id="asistente-icon-open"
      class="w-6 h-6 transition-transform duration-300"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="1.8"
        d="M8 10.5h.01M12 10.5h.01M16 10.5h.01M21 12c0 4.418-4.03 8-9 8-1.06 0-2.077-.162-3.02-.46L3 21l1.53-3.83A7.947 7.947 0 013 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
      ></path>
    </svg>
    <svg
      id="asistente-icon-close"
      class="hidden w-5 h-5 transition-transform duration-300"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M6 18L18 6M6 6l12 12"
      ></path>
    </svg>
  </button>
</div>

<style>
  .custom-scrollbar::-webkit-scrollbar {
    width: 4px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: rgba(245, 158, 11, 0.35);
    border-radius: 10px;
  }

  .asistente-bubble {
    animation: asistente-bubble-in 0.35s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }
  @keyframes asistente-bubble-in {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.97);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .asistente-typing-dot {
    animation: asistente-typing 1s ease-in-out infinite;
  }
  .asistente-typing-dot:nth-child(2) {
    animation-delay: 0.15s;
  }
  .asistente-typing-dot:nth-child(3) {
    animation-delay: 0.3s;
  }
  @keyframes asistente-typing {
    0%,
    60%,
    100% {
      transform: translateY(0);
      opacity: 0.5;
    }
    30% {
      transform: translateY(-3px);
      opacity: 1;
    }
  }

  /* Latido del anillo mientras el aviso está en pantalla. Solo transform y
     opacity sobre un pseudo-anillo, y únicamente durante esos segundos:
     nunca queda una animación corriendo de fondo el resto de la sesión. */
  .asistente-ping-active {
    animation: asistente-ping 2s cubic-bezier(0, 0, 0.2, 1) 3;
  }
  @keyframes asistente-ping {
    0% {
      transform: scale(1);
      opacity: 0.8;
    }
    70%,
    100% {
      transform: scale(1.5);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .asistente-bubble,
    .asistente-typing-dot,
    .asistente-ping-active,
    #asistente-panel,
    #asistente-nudge,
    #asistente-icon-open,
    #asistente-icon-close {
      animation: none !important;
      transition: none !important;
    }
  }
</style>

<script is:inline define:vars={{ quickReplies, temas, icons }}>
  document.addEventListener('DOMContentLoaded', () => {
    const root = document.getElementById('asistente-winden-root');
    const toggleBtn = document.getElementById('asistente-toggle');
    const closeBtn = document.getElementById('asistente-close');
    const panel = document.getElementById('asistente-panel');
    const transcript = document.getElementById('asistente-transcript');
    const iconOpen = document.getElementById('asistente-icon-open');
    const iconClose = document.getElementById('asistente-icon-close');
    if (!root || !toggleBtn || !panel || !transcript) return;

    let isOpen = false;
    let lastFocused = null;

    function scrollTranscriptToBottom() {
      transcript.scrollTop = transcript.scrollHeight;
    }

    function timestampNow() {
      return new Date().toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' });
    }

    // Sella la burbuja de bienvenida (ya presente en el HTML) al montar.
    const initialTimestamp = document.querySelector('.asistente-timestamp');
    if (initialTimestamp) initialTimestamp.textContent = timestampNow();

    function addUserBubble(text) {
      const wrap = document.createElement('div');
      wrap.className = 'asistente-bubble asistente-bubble--user flex flex-col items-end gap-1 max-w-[85%] w-fit ml-auto';
      wrap.innerHTML = `
        <p class="text-sm leading-relaxed bg-amber-500 text-black font-medium rounded-2xl rounded-br-sm px-4 py-2.5">${text}</p>
        <span class="asistente-timestamp pr-1 text-[10px] font-mono tracking-wide text-stone-600">${timestampNow()}</span>
      `;
      transcript.appendChild(wrap);
      scrollTranscriptToBottom();
    }

    function addTypingBubble() {
      const wrap = document.createElement('div');
      wrap.className = 'asistente-bubble asistente-bubble--typing flex items-end gap-2 max-w-[60%] w-fit';
      wrap.innerHTML = `
        <span aria-hidden="true" class="shrink-0 w-6 h-6 rounded-full bg-black border border-amber-500/40 flex items-center justify-center">
          <svg class="w-3 h-3 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 10.5h.01M12 10.5h.01M16 10.5h.01M21 12c0 4.418-4.03 8-9 8-1.06 0-2.077-.162-3.02-.46L3 21l1.53-3.83A7.947 7.947 0 013 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
          </svg>
        </span>
        <div class="flex items-center gap-1 bg-stone-800 rounded-2xl rounded-bl-sm px-4 py-3">
          <span class="asistente-typing-dot w-1.5 h-1.5 rounded-full bg-stone-400"></span>
          <span class="asistente-typing-dot w-1.5 h-1.5 rounded-full bg-stone-400"></span>
          <span class="asistente-typing-dot w-1.5 h-1.5 rounded-full bg-stone-400"></span>
        </div>`;
      transcript.appendChild(wrap);
      scrollTranscriptToBottom();
      return wrap;
    }

    function addBotBubble(option) {
      const wrap = document.createElement('div');
      wrap.className = 'asistente-bubble asistente-bubble--bot flex items-end gap-2 max-w-[88%] w-fit';
      const ctaHtml = option.cta
        ? `<a href="${option.cta.href}" data-asistente-cta ${option.cta.external ? 'data-asistente-cta-external target="_blank" rel="noopener noreferrer"' : ''} class="inline-flex items-center gap-1.5 self-start rounded-full border border-amber-500/50 px-3 py-1.5 text-[11px] font-bold uppercase tracking-wide text-amber-500 hover:bg-amber-500 hover:text-black transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400">
            ${option.cta.label}
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
          </a>`
        : '';
      wrap.innerHTML = `
        <span aria-hidden="true" class="shrink-0 w-6 h-6 rounded-full bg-black border border-amber-500/40 flex items-center justify-center">
          <svg class="w-3 h-3 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 10.5h.01M12 10.5h.01M16 10.5h.01M21 12c0 4.418-4.03 8-9 8-1.06 0-2.077-.162-3.02-.46L3 21l1.53-3.83A7.947 7.947 0 013 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
          </svg>
        </span>
        <span class="flex flex-col items-start gap-1 min-w-0">
          <p class="text-sm leading-relaxed bg-stone-800 text-stone-200 rounded-2xl rounded-bl-sm px-4 py-2.5">${option.reply}</p>
          ${ctaHtml}
          <span class="asistente-timestamp pl-1 text-[10px] font-mono tracking-wide text-stone-600">${timestampNow()}</span>
        </span>
      `;
      transcript.appendChild(wrap);
      scrollTranscriptToBottom();

      const cta = wrap.querySelector('[data-asistente-cta]');
      if (cta && !cta.hasAttribute('data-asistente-cta-external')) {
        cta.addEventListener('click', () => closeAsistente());
      }
    }

    // ===== SUGERENCIAS EN TRES NIVELES =====
    // 1. cuatro temas  ->  2. las preguntas de ese tema  ->  3. lo que queda
    // por preguntar del mismo tema, ya con la respuesta en pantalla. En
    // ningún momento hay más de cuatro botones a la vez.
    const zonaSugerencias = document.getElementById('asistente-sugerencias');
    const tituloSugerencias = document.getElementById(
      'asistente-sugerencias-titulo',
    );
    const botonVolver = document.getElementById('asistente-volver');
    const yaPreguntado = new Set();
    let temaActual = null;

    const CLASE_CHIP =
      'asistente-chip flex items-center gap-2 rounded-xl border border-stone-700 bg-stone-900 px-2.5 py-2 text-left text-[11px] leading-tight font-semibold text-stone-300 hover:border-amber-500/60 hover:text-amber-500 hover:bg-stone-800 hover:-translate-y-0.5 transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400';

    function icono(nombre) {
      return `<svg class="w-3.5 h-3.5 shrink-0 text-amber-500/80" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="${icons[nombre]}" /></svg>`;
    }

    function pintarTemas() {
      temaActual = null;
      if (tituloSugerencias) {
        tituloSugerencias.textContent = yaPreguntado.size
          ? '¿Algo más?'
          : '¿Por dónde empezamos?';
      }
      botonVolver?.classList.add('hidden');
      botonVolver?.classList.remove('flex');
      zonaSugerencias.className = 'grid grid-cols-1 gap-2 px-3 pb-3';
      zonaSugerencias.innerHTML = temas
        .map(
          (tema) => `
        <button type="button" data-asistente-tema="${tema.id}"
          class="asistente-chip flex items-center gap-3 rounded-xl border border-stone-700 bg-stone-900 px-3 py-2.5 text-left text-stone-300 hover:border-amber-500/60 hover:text-amber-500 hover:bg-stone-800 hover:-translate-y-0.5 transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400">
          <svg class="w-4 h-4 shrink-0 text-amber-500/80" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="${icons[tema.icon]}" /></svg>
          <span class="min-w-0">
            <span class="block text-[12px] font-semibold leading-tight">${tema.label}</span>
            <span class="block text-[10px] leading-tight text-stone-500">${tema.hint}</span>
          </span>
        </button>`,
        )
        .join('');
    }

    function pintarOpciones(idTema, titulo) {
      temaActual = idTema;
      const tema = temas.find((t) => t.id === idTema);
      if (tituloSugerencias) {
        tituloSugerencias.textContent = titulo || tema?.label || 'Preguntas';
      }
      botonVolver?.classList.remove('hidden');
      botonVolver?.classList.add('flex');
      zonaSugerencias.className = 'grid grid-cols-1 gap-2 px-3 pb-3';
      zonaSugerencias.innerHTML = quickReplies
        .filter((o) => o.tema === idTema)
        .map(
          (o) => `
        <button type="button" data-asistente-option="${o.id}" class="${CLASE_CHIP}${yaPreguntado.has(o.id) ? ' opacity-55' : ''}">
          ${icono(o.icon)}<span>${o.label}</span>
        </button>`,
        )
        .join('');
    }

    function pintarSeguimiento(option) {
      const pendientes = quickReplies.filter(
        (o) => o.tema === option.tema && !yaPreguntado.has(o.id),
      );

      if (!pendientes.length) {
        pintarTemas();
        return;
      }

      temaActual = option.tema;
      if (tituloSugerencias) tituloSugerencias.textContent = 'Y ya que estamos…';
      botonVolver?.classList.remove('hidden');
      botonVolver?.classList.add('flex');
      zonaSugerencias.className = 'grid grid-cols-1 gap-2 px-3 pb-3';
      zonaSugerencias.innerHTML = pendientes
        .slice(0, 3)
        .map(
          (o) => `
        <button type="button" data-asistente-option="${o.id}" class="${CLASE_CHIP}">
          ${icono(o.icon)}<span>${o.label}</span>
        </button>`,
        )
        .join('');
    }

    function handleOptionClick(optionId) {
      const option = quickReplies.find((o) => o.id === optionId);
      if (!option) return;
      yaPreguntado.add(option.id);
      addUserBubble(option.label);
      const typingEl = addTypingBubble();
      // Mientras "escribe", las sugerencias se vacían: ofrecer el siguiente
      // paso antes de haber contestado al anterior es justo la sensación de
      // amontonamiento que se quería quitar.
      zonaSugerencias.innerHTML = '';
      window.setTimeout(() => {
        typingEl.remove();
        addBotBubble(option);
        pintarSeguimiento(option);
      }, 550);
    }

    // Un solo escuchador para toda la zona: los botones se repintan en cada
    // paso, así que atarlos uno a uno obligaría a re-atarlos cada vez.
    zonaSugerencias?.addEventListener('click', (evento) => {
      const opcion = evento.target.closest('[data-asistente-option]');
      if (opcion) {
        handleOptionClick(opcion.dataset.asistenteOption);
        return;
      }
      const tema = evento.target.closest('[data-asistente-tema]');
      if (tema) pintarOpciones(tema.dataset.asistenteTema);
    });

    botonVolver?.addEventListener('click', pintarTemas);

    // ===== AVISO DE DESCUBRIMIENTO (una sola vez por navegador) =====
    const NUDGE_KEY = 'asistenteWindenNudgeVisto';
    const nudge = document.getElementById('asistente-nudge');
    const nudgeClose = document.getElementById('asistente-nudge-close');
    const ping = document.getElementById('asistente-ping');
    let nudgeTimer = null;

    function hasSeenNudge() {
      try {
        return localStorage.getItem(NUDGE_KEY) === '1';
      } catch {
        // Modo privado o cookies bloqueadas: se trata como "ya visto" para no
        // insistir en cada carga sin poder recordar nada.
        return true;
      }
    }

    function markNudgeSeen() {
      try {
        localStorage.setItem(NUDGE_KEY, '1');
      } catch {
        /* sin almacenamiento disponible: nada que recordar */
      }
    }

    function hideNudge({ remember = true } = {}) {
      if (nudgeTimer) {
        window.clearTimeout(nudgeTimer);
        nudgeTimer = null;
      }
      ping?.classList.remove('asistente-ping-active');
      if (!nudge || nudge.classList.contains('hidden')) {
        if (remember) markNudgeSeen();
        return;
      }
      nudge.classList.add('opacity-0', 'translate-y-2');
      window.setTimeout(() => {
        nudge.classList.add('hidden');
        nudge.classList.remove('flex');
      }, 300);
      if (remember) markNudgeSeen();
    }

    if (nudge && !hasSeenNudge()) {
      nudgeTimer = window.setTimeout(() => {
        if (isOpen) return;
        nudge.classList.remove('hidden');
        nudge.classList.add('flex');
        ping?.classList.add('asistente-ping-active');
        requestAnimationFrame(() =>
          nudge.classList.remove('opacity-0', 'translate-y-2'),
        );
        // Si nadie lo toca, se retira solo: un aviso permanente deja de ser
        // una sugerencia y pasa a ser un estorbo.
        nudgeTimer = window.setTimeout(() => hideNudge(), 12000);
      }, 6000);
    }

    nudgeClose?.addEventListener('click', () => hideNudge());

    // El FAB de WhatsApp queda justo encima del panel; se aparta mientras el
    // asistente está abierto en vez de asomar por detrás.
    const whatsappFab = document.getElementById('whatsapp-fab');

    function openAsistente() {
      isOpen = true;
      hideNudge();
      lastFocused = document.activeElement;
      // Marca en <body> para que la regla que esconde los FAB sobre el hero
      // no se lleve por delante un panel que el usuario tiene abierto.
      document.body.classList.add('asistente-open');
      whatsappFab?.classList.add('is-tucked');
      panel.classList.remove('hidden');
      panel.classList.add('flex');
      panel.setAttribute('aria-hidden', 'false');
      requestAnimationFrame(() => {
        panel.classList.remove('opacity-0', 'scale-95', 'translate-y-2');
      });
      toggleBtn.setAttribute('aria-expanded', 'true');
      toggleBtn.setAttribute('aria-label', 'Cerrar asistente de Winden');
      iconOpen?.classList.add('hidden');
      iconClose?.classList.remove('hidden');
      window.setTimeout(() => closeBtn?.focus(), 320);
      document.addEventListener('keydown', onKeydown);
    }

    function closeAsistente() {
      isOpen = false;
      document.body.classList.remove('asistente-open');
      whatsappFab?.classList.remove('is-tucked');
      panel.classList.add('opacity-0', 'scale-95', 'translate-y-2');
      panel.setAttribute('aria-hidden', 'true');
      toggleBtn.setAttribute('aria-expanded', 'false');
      toggleBtn.setAttribute('aria-label', 'Abrir asistente de Winden');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      window.setTimeout(() => {
        if (!isOpen) {
          panel.classList.add('hidden');
          panel.classList.remove('flex');
        }
      }, 300);
      document.removeEventListener('keydown', onKeydown);
      if (lastFocused instanceof HTMLElement) lastFocused.focus();
      else toggleBtn.focus();
    }

    function onKeydown(event) {
      if (event.key === 'Escape') {
        closeAsistente();
        return;
      }
      if (event.key === 'Tab') {
        const focusables = panel.querySelectorAll(
          'button, a[href], [tabindex]:not([tabindex="-1"])',
        );
        if (!focusables.length) return;
        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      }
    }

    toggleBtn.addEventListener('click', () => (isOpen ? closeAsistente() : openAsistente()));
    closeBtn?.addEventListener('click', closeAsistente);
  });
</script>
