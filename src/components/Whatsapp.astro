---
// src/components/Whatsapp.astro
// Acción secundaria de la columna flotante. La primaria es el asistente
// (AsistenteWinden.astro), que vive justo debajo en `bottom-6`: este botón se
// ancla en `bottom-24` para dejarle sitio, y ambos comparten tamaño (44px) y
// eje derecho para que se lean como una sola columna y no como dos elementos
// sueltos que casualmente cayeron en la misma esquina.
---

<a
  id="whatsapp-fab"
  href="https://wa.me/34644594975?text=Hola!%20He%20visto%20tu%20web%20y%20quiero%20recomendarte%20algo."
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Escribir por WhatsApp"
  class="whatsapp-fab group fixed bottom-24 right-6 z-[100] w-11 h-11 flex items-center justify-center rounded-full bg-[#25d366] shadow-lg shadow-black/40 transition-all duration-300 hover:scale-110 hover:shadow-[0_0_20px_rgba(37,211,102,0.5)] active:scale-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#25d366] focus-visible:ring-offset-2 focus-visible:ring-offset-black"
>
  <!-- El halo era un div desenfocado con `animate-pulse` corriendo en bucle
       para siempre; un anillo que solo se expande al pasar el cursor comunica
       lo mismo sin repintar nada mientras nadie lo mira. -->
  <span
    aria-hidden="true"
    class="absolute inset-0 rounded-full ring-2 ring-[#25d366]/50 scale-100 opacity-0 group-hover:scale-125 group-hover:opacity-100 transition-all duration-500 pointer-events-none"
  ></span>

  <svg class="w-5 h-5 text-white relative" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <path
      d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.316 1.592 5.43 0 9.856-4.426 9.858-9.855.002-5.43-4.425-9.856-9.853-9.856-5.431 0-9.856 4.426-9.858 9.854 0 2.117.575 3.905 1.638 5.637l-.993 3.634 3.702-.971z"
    ></path>
  </svg>
</a>

<style>
  /* Se aparta cuando el panel del asistente está abierto: si no, el botón
     verde queda asomando por detrás del panel. La clase la pone/quita
     AsistenteWinden.astro al abrir y cerrar. */
  .whatsapp-fab.is-tucked {
    opacity: 0;
    transform: translateY(8px) scale(0.9);
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .whatsapp-fab,
    .whatsapp-fab span {
      transition-duration: 0.01ms;
    }
  }
</style>
