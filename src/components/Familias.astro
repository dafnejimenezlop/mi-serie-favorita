<style is:global>
  @media (min-width: 1024px) {
    .family-card {
      flex: 1;
    }
    .group\/container:hover .family-card {
      flex: 1;
    }
    .group\/container .family-card:hover {
      flex: 3;
    }
  }

  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .custom-scrollbar::-webkit-scrollbar {
    width: 4px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: rgba(245, 158, 11, 0.4);
    border-radius: 10px;
  }

  /* MÁSCARA TIPO TYPEWRITER (Evita que corte el span naranja) */
  .text-reveal {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 1s ease 0.3s,
      transform 1s ease 0.3s;
  }

  /* SUBRAYADO MÁGICO INFALIBLE EN MULTILINEA */
  .magic-highlight {
    color: white;
    font-weight: 600;
    /* Usamos un linear gradient de fondo para que no se rompa si hay salto de linea */
    background-image: linear-gradient(
      rgba(245, 158, 11, 0.4),
      rgba(245, 158, 11, 0.4)
    );
    background-repeat: no-repeat;
    background-position: left bottom;
    background-size: 0% 35%; /* Empieza al 0% de ancho */
    transition: background-size 1s cubic-bezier(0.25, 1, 0.5, 1);
    padding-bottom: 2px;
  }

  /* EFECTOS AL ENTRAR EN PANTALLA (.in-view) */
  .scroll-scene {
    opacity: 0.1;
    transform: translateY(30px);
    transition: all 1s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .scroll-scene.in-view {
    opacity: 1;
    transform: translateY(0);
  }
  .scroll-scene.in-view .text-reveal {
    opacity: 1;
    transform: translateY(0);
  }

  /* El subrayado arranca un poco después de que el texto suba */
  .scroll-scene.in-view .magic-highlight {
    background-size: 100% 35%;
    transition-delay: 1.2s;
  }

  .timeline-line {
    width: 0px;
    transition: width 1s ease-out 0.5s;
  }
  .scroll-scene.in-view .timeline-line {
    width: 3rem;
  }
  @media (min-width: 768px) {
    .scroll-scene.in-view .timeline-line {
      width: 5rem;
    }
  }

  .timeline-dot {
    opacity: 0;
    transform: scale(0);
    transition: all 0.5s ease 1s;
    box-shadow: 0 0 10px rgba(245, 158, 11, 0.8);
  }
  .scroll-scene.in-view .timeline-dot {
    opacity: 1;
    transform: scale(1);
  }

  /* Animación de barras de audio */
  @keyframes audio-bar {
    0% {
      height: 4px;
    }
    50% {
      height: 16px;
    }
    100% {
      height: 4px;
    }
  }
  .animate-audio-bar-1 {
    animation: audio-bar 1.2s ease-in-out infinite;
  }
  .animate-audio-bar-2 {
    animation: audio-bar 0.9s ease-in-out infinite 0.3s;
  }
  .animate-audio-bar-3 {
    animation: audio-bar 1.5s ease-in-out infinite 0.6s;
  }

  /* Animación Fin de Ciclo */
  .triqueta-animada {
    stroke-dasharray: 200;
    stroke-dashoffset: 200;
    transition: stroke-dashoffset 2s ease-out 0.5s;
  }
  .scroll-scene.in-view .triqueta-animada {
    stroke-dashoffset: 0;
  }

  body.hide-global-ui #netflix-header,
  body.hide-global-ui #btnScrollToTop,
  body.hide-global-ui #btnScrollToBottom {
    opacity: 0 !important;
    pointer-events: none !important;
    display: none !important;
  }
</style>

