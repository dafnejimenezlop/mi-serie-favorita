---
// src/components/Familias.astro

import { familiasData, relationshipData } from '../data/familias';
import { validateRelationships } from '../utils/familyTree';

const relationshipValidation = validateRelationships(
  familiasData,
  relationshipData,
);
---

<style is:global>
  /* === BLOQUEO TOTAL DE SCROLL Y UI CUANDO ESTAMOS EN MODO INMERSIVO === */
  body.hide-global-ui {
    overflow: hidden !important;
  }
  body.hide-global-ui footer,
  body.hide-global-ui #netflix-header,
  body.hide-global-ui #btnScrollToTop,
  body.hide-global-ui #btnScrollToBottom,
  body.hide-global-ui .whatsapp-btn {
    opacity: 0 !important;
    pointer-events: none !important;
    display: none !important;
  }

  @media (min-width: 1024px) {
    .family-card {
      flex: 1;
    }
    .group\/container:hover .family-card {
      flex: 1;
    }
    .group\/container .family-card:hover {
      flex: 3;
    }
  }

  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .custom-scrollbar::-webkit-scrollbar {
    width: 4px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: rgba(245, 158, 11, 0.4);
    border-radius: 10px;
  }

  /* TEXT REVEAL: De izquierda a derecha */
  .text-reveal {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 1s ease 0.3s,
      transform 1s ease 0.3s;
  }

  /* SUBRAYADO MÁGICO INFALIBLE EN MULTILINEA */
  .magic-highlight {
    color: white;
    font-weight: 600;
    background-image: linear-gradient(
      rgba(245, 158, 11, 0.45),
      rgba(245, 158, 11, 0.45)
    );
    background-repeat: no-repeat;
    background-position: left bottom;
    background-size: 0% 35%;
    transition: background-size 1.2s cubic-bezier(0.25, 1, 0.5, 1);
    padding-bottom: 2px;
  }

  /* EFECTO TYPEWRITER EN HIGHLIGHTS */
  /* Cursor parpadeante de máquina de escribir */
  @keyframes blink-cursor {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }
  .tw-cursor::after {
    content: '|';
    color: rgba(245, 158, 11, 0.8);
    animation: blink-cursor 0.6s step-end infinite;
    margin-left: 1px;
    font-weight: 300;
  }
  /* Cursor de rebobinar — color rojizo */
  .tw-cursor-rev::after {
    content: '◂';
    color: rgba(200, 80, 60, 0.7);
    animation: blink-cursor 0.35s step-end infinite;
    margin-left: 1px;
    font-size: 0.7em;
    vertical-align: middle;
  }

  /* ZOOM/PAN TREE */
  #tree-pan-area {
    user-select: none;
    cursor: none;
  }
  #tree-viewer,
  #tree-viewer *,
  #netflix-sidebar,
  #netflix-sidebar * {
    cursor: none !important;
  }
  #tree-zoom-container {
    transition: transform 0.08s ease-out;
  }
  #tree-zoom-container.smooth-reset {
    transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  /* El cursor triqueta se gestiona 100% por inline style en JS */

  /* NODO ÁRBOL: halo de luz al hover */
  .tree-node-wrap {
    position: relative;
  }
  .tree-node-wrap::before {
    content: '';
    position: absolute;
    inset: -6px;
    border-radius: 4px;
    background: radial-gradient(
      circle,
      rgba(245, 158, 11, 0) 0%,
      transparent 70%
    );
    transition: background 0.4s ease;
    pointer-events: none;
    z-index: 0;
  }
  .tree-node-wrap:hover::before {
    background: radial-gradient(
      circle,
      rgba(245, 158, 11, 0.35) 0%,
      transparent 70%
    );
  }

  /* TOOLTIP del nodo */
  .tree-tooltip {
    position: absolute;
    bottom: calc(100% + 10px);
    left: 50%;
    transform: translateX(-50%) translateY(6px);
    background: rgba(10, 10, 10, 0.95);
    border: 1px solid rgba(245, 158, 11, 0.3);
    color: #d4af72;
    font-family: 'Cinzel', serif;
    font-size: 9px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    padding: 5px 10px;
    white-space: nowrap;
    border-radius: 2px;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.25s ease,
      transform 0.25s ease;
    z-index: 100;
    backdrop-filter: blur(4px);
    box-shadow: 0 0 12px rgba(245, 158, 11, 0.15);
  }
  .tree-tooltip::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    border: 4px solid transparent;
    border-top-color: rgba(245, 158, 11, 0.3);
  }
  .tree-node-wrap:hover .tree-tooltip {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  .complete-tree-grid {
    width: 2530px;
    height: 1415px;
    min-width: 2530px;
    min-height: 1415px;
    position: relative;
    padding: 0;
  }

  .family-tree-canvas {
    width: 980px;
    height: 920px;
    min-width: 980px;
    min-height: 920px;
    position: relative;
    padding: 0;
  }

  /* Árbol Completo redisñado: mapa único sin bloques separados por familia —
     las etiquetas de familia son texto flotante sin caja/borde. */
  .complete-family-label {
    --family-accent: #d97706;
    position: absolute;
    z-index: 2;
    margin: 0;
    color: color-mix(in srgb, var(--family-accent), white 18%);
    font-family: 'Cinzel', serif;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    text-shadow: 0 0 12px rgba(0, 0, 0, 0.8);
    opacity: 0.55;
    pointer-events: none;
    white-space: nowrap;
    transform: translateY(-100%);
  }

  /* Nodo/conector central: Jonas + Martha + símbolo de infinito */
  .complete-tree-infinity {
    font-family: 'Cinzel', serif;
    fill: rgba(245, 158, 11, 0.85);
    text-anchor: middle;
    dominant-baseline: middle;
  }

  /* Resaltado de linaje al pasar el cursor (Task 11) */
  .complete-tree-node.is-dimmed,
  #tree-svg-lines .tree-line.is-dimmed,
  #tree-svg-lines polygon.is-dimmed {
    opacity: 0.12;
    transition: opacity 0.35s ease;
  }
  .complete-tree-node:not(.is-dimmed),
  #tree-svg-lines .tree-line:not(.is-dimmed),
  #tree-svg-lines polygon:not(.is-dimmed) {
    transition: opacity 0.35s ease;
  }
  .complete-tree-node.is-active .tree-node-wrap > div {
    border-color: rgba(245, 158, 11, 0.9);
    box-shadow: 0 0 30px rgba(245, 158, 11, 0.4);
  }

  .complete-tree-node {
    position: absolute;
    z-index: 10;
    transform: translate(-50%, -50%);
  }

  .family-tree-node {
    position: absolute;
    z-index: 10;
    transform: translate(-50%, -50%);
  }

  .complete-tree-node[data-core='1'] .tree-node-wrap > div {
    border-color: rgba(245, 158, 11, 0.75);
    box-shadow:
      0 0 26px rgba(245, 158, 11, 0.28),
      0 0 2px rgba(255, 255, 255, 0.35);
  }

  /* LÍNEAS DE GENERACIÓN CON PULSO */
  @keyframes line-pulse {
    0% {
      background-position: 0% 0%;
    }
    100% {
      background-position: 0% 100%;
    }
  }
  .gen-connector-line {
    width: 1px;
    min-width: 1px;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      rgba(245, 158, 11, 0.5) 20%,
      rgba(245, 158, 11, 0.75) 50%,
      rgba(245, 158, 11, 0.5) 80%,
      transparent 100%
    );
    background-size: 100% 300%;
    background-position: 0% 0%;
    animation: line-pulse 2.5s ease-in-out infinite;
    box-shadow: 0 0 4px rgba(245, 158, 11, 0.25);
    display: block;
  }

  /* EFECTOS AL ENTRAR EN PANTALLA (.in-view) */
  .scroll-scene {
    opacity: 0.1;
    transform: translateY(30px);
    transition: all 1s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .scroll-scene.in-view {
    opacity: 1;
    transform: translateY(0);
  }
  .scroll-scene.in-view .text-reveal {
    opacity: 1;
    transform: translateY(0);
  }
  .scroll-scene.in-view .magic-highlight {
    background-size: 100% 35%;
    transition-delay: 1.2s;
  }
  .scroll-scene.in-view .timeline-line {
    width: 3rem;
  }
  @media (min-width: 768px) {
    .scroll-scene.in-view .timeline-line {
      width: 5rem;
    }
  }
  .scroll-scene.in-view .timeline-dot {
    opacity: 1;
    transform: scale(1);
  }

  #cinematic-bg {
    --tilt-x: 0deg;
    --tilt-y: 0deg;
    --scan-y: 52%;
    --drift-x: 0px;
    --drift-y: 0px;
  }

  #cinematic-bg {
    --scroll-y: 0px;
  }

  #cinematic-bg.temporal-bg {
    transform:
      translate(var(--drift-x), calc(var(--drift-y) + var(--scroll-y)))
      rotateX(var(--tilt-y))
      rotateY(var(--tilt-x))
      scale(1.08);
    filter: url(#cinematic-ripple) grayscale(0.2) contrast(1.02) brightness(1.18) saturate(1.05);
  }

  .cinematic-temporal-overlay {
    background:
      linear-gradient(
        to bottom,
        transparent calc(var(--scan-y) - 8%),
        rgba(245, 158, 11, 0.16) var(--scan-y),
        transparent calc(var(--scan-y) + 8%)
      ),
      repeating-linear-gradient(
        to bottom,
        rgba(255, 255, 255, 0.045) 0,
        rgba(255, 255, 255, 0.045) 1px,
        transparent 1px,
        transparent 7px
      );
    mix-blend-mode: screen;
    opacity: 0.18;
  }

  /* Sin caja/fondo opaco detrás del texto — el texto se apoya solo en el
     degradado global de la imagen (ver #cinematic-viewer) y en su propio
     text-shadow, al estilo Netflix, en vez de una tarjeta negra sólida. */
  .cinematic-panel {
    padding: 1.5rem 1.65rem;
  }

  .cinematic-panel h2,
  .cinematic-panel p {
    text-shadow:
      0 2px 10px rgba(0, 0, 0, 0.9),
      0 0 32px rgba(0, 0, 0, 0.7);
  }

  .cinematic-insight {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 0.9s ease 0.55s,
      transform 0.9s ease 0.55s;
  }

  .scroll-scene.in-view .cinematic-insight {
    opacity: 1;
    transform: translateY(0);
  }

  .next-panel-cue {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.8s ease 0.8s,
      transform 0.8s ease 0.8s;
  }

  .scroll-scene.in-view .next-panel-cue {
    opacity: 0.85;
    transform: translateY(0);
  }

  @keyframes cue-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.55);
    }
    50% {
      transform: scale(1.5);
      box-shadow: 0 0 0 9px rgba(245, 158, 11, 0);
    }
  }

  .next-panel-cue-dot {
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: rgb(245, 158, 11);
    animation: cue-pulse 1.6s ease-in-out infinite;
  }

  .next-panel-cue-line {
    width: 1px;
    height: 30px;
    background: linear-gradient(
      to bottom,
      rgba(245, 158, 11, 0.7),
      rgba(245, 158, 11, 0)
    );
  }

  .temporal-image-wrap {
    --tilt-x: 0deg;
    --tilt-y: 0deg;
    --scan-y: 52%;
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: 1px solid rgba(245, 158, 11, 0.18);
    background: rgba(0, 0, 0, 0.55);
    perspective: 900px;
    transform: translateY(26px) scale(0.96);
    opacity: 0;
    transition:
      opacity 0.9s ease,
      transform 0.9s cubic-bezier(0.2, 0.8, 0.2, 1),
      border-color 0.35s ease;
  }

  .scroll-scene.in-view .temporal-image-wrap {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .temporal-image-wrap:nth-child(2) {
    transition-delay: 120ms;
  }

  .temporal-image-wrap:nth-child(3) {
    transition-delay: 240ms;
  }

  .temporal-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05) brightness(0.72);
    transform: rotateX(var(--tilt-y)) rotateY(var(--tilt-x)) scale(1.04);
    transition:
      transform 0.18s ease,
      filter 0.35s ease,
      opacity 0.35s ease;
  }

  .temporal-image-wrap::before,
  .temporal-image-wrap::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .temporal-image-wrap::before {
    background:
      linear-gradient(
        to bottom,
        transparent calc(var(--scan-y) - 8%),
        rgba(245, 158, 11, 0.28) var(--scan-y),
        transparent calc(var(--scan-y) + 8%)
      ),
      repeating-linear-gradient(
        to bottom,
        rgba(255, 255, 255, 0.06) 0,
        rgba(255, 255, 255, 0.06) 1px,
        transparent 1px,
        transparent 6px
      );
    mix-blend-mode: screen;
  }

  .temporal-image-wrap::after {
    border: 1px solid rgba(245, 158, 11, 0.38);
    box-shadow:
      inset 0 0 28px rgba(245, 158, 11, 0.16),
      0 0 24px rgba(245, 158, 11, 0.14);
  }

  .temporal-image-wrap.is-interacting {
    border-color: rgba(245, 158, 11, 0.55);
  }

  .temporal-image-wrap.is-interacting .temporal-image {
    filter: grayscale(0.2) contrast(1.18) brightness(0.92) saturate(1.1);
  }

  .temporal-image-wrap.is-interacting::before,
  .temporal-image-wrap.is-interacting::after {
    opacity: 1;
  }

  @media (max-width: 767px) {
    .temporal-gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      max-width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .temporal-image-wrap,
    .temporal-image {
      transition: none;
      transform: none;
    }
  }

  .timeline-line {
    width: 0px;
    transition: width 1s ease-out 0.5s;
  }
  .timeline-dot {
    opacity: 0;
    transform: scale(0);
    transition: all 0.5s ease 1s;
    box-shadow: 0 0 10px rgba(245, 158, 11, 0.8);
  }

  /* ANIMACIÓN DE FONDO DEL ÁRBOL */
  @keyframes slow-spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes slow-spin-reverse {
    from {
      transform: rotate(360deg);
    }
    to {
      transform: rotate(0deg);
    }
  }
  .animate-slow-spin {
    animation: slow-spin 60s linear infinite;
  }
  .animate-slow-spin-reverse {
    animation: slow-spin-reverse 40s linear infinite;
  }

  /* Animación de barras de audio */
  @keyframes audio-bar {
    0% {
      height: 4px;
    }
    50% {
      height: 16px;
    }
    100% {
      height: 4px;
    }
  }
  .animate-audio-bar-1 {
    animation: audio-bar 1.2s ease-in-out infinite;
  }
  .animate-audio-bar-2 {
    animation: audio-bar 0.9s ease-in-out infinite 0.3s;
  }
  .animate-audio-bar-3 {
    animation: audio-bar 1.5s ease-in-out infinite 0.6s;
  }
</style>

<audio id="dark-ambient-audio" loop src="/audio/dark-theme.mp3"></audio>

<button
  id="btn-audio-toggle"
  class="fixed bottom-6 right-6 z-[450] text-stone-400 hover:text-white transition-all hidden flex-col items-center justify-center group bg-black/80 w-12 h-12 rounded-full border border-stone-800 backdrop-blur-md hover:border-amber-500 shadow-xl"
>
  <div
    class="flex items-end justify-center h-4 gap-[3px] overflow-hidden"
    id="audio-bars"
  >
    <div class="w-[3px] bg-amber-500 h-2 animate-audio-bar-1 rounded-sm"></div>
    <div class="w-[3px] bg-amber-500 h-4 animate-audio-bar-2 rounded-sm"></div>
    <div class="w-[3px] bg-amber-500 h-3 animate-audio-bar-3 rounded-sm"></div>
  </div>

  <svg
    id="audio-muted-icon"
    class="w-5 h-5 hidden text-stone-500"
    fill="none"
    stroke="currentColor"
    viewBox="0 0 24 24"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"
    ></path>
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d="M17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2"></path>
  </svg>
</button>

<div
  id="netflix-sidebar"
  class="fixed inset-y-0 left-0 w-80 bg-[#0a0a0a] border-r border-stone-800 z-[400] transform -translate-x-full transition-transform duration-500 overflow-y-auto custom-scrollbar flex flex-col shadow-[20px_0_50px_rgba(0,0,0,0.9)]"
>
  <div
    class="p-6 border-b border-stone-800 flex justify-between items-center sticky top-0 bg-[#0a0a0a]/95 backdrop-blur-md z-10"
  >
    <h2
      class="font-cinzel text-xl text-amber-500 tracking-[0.2em] uppercase font-bold"
    >
      Quién
    </h2>
    <button
      onclick="toggleSidebar()"
      class="text-stone-400 hover:text-white transition-colors"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"
        ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M6 18L18 6M6 6l12 12"></path></svg
      >
    </button>
  </div>
  <div class="p-4 border-b border-stone-800/50">
    <button
      onclick="goToFamiliasOverview()"
      class="w-full py-3 bg-stone-900 border border-stone-700 hover:border-amber-500 text-stone-300 hover:text-amber-500 rounded font-cinzel tracking-widest text-sm uppercase transition-all flex items-center justify-center gap-2 group"
    >
      <svg
        class="w-4 h-4 transform group-hover:-translate-y-1 transition-transform"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"
        ></path></svg
    >
      Ver Familias
    </button>
    <button
      onclick="openCompleteTreeViewer()"
      class="w-full mt-3 py-3 bg-black/60 border border-amber-700/50 hover:border-amber-500 text-amber-500/80 hover:text-amber-300 rounded font-cinzel tracking-widest text-sm uppercase transition-all flex items-center justify-center gap-2 group"
    >
      <svg
        class="w-4 h-4 transform group-hover:scale-110 transition-transform"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="1.8"
          d="M12 3v5m0 0H7m5 0h5M7 8v5m10-5v5M7 13h10M7 13v5m10-5v5M4 18h6m4 0h6"
        ></path></svg
      >
      Arbol Completo
    </button>
  </div>
  <div id="sidebar-content" class="p-6 flex flex-col gap-8"></div>
</div>

<div
  id="sidebar-overlay"
  onclick="toggleSidebar()"
  class="fixed inset-0 bg-black/60 z-[350] hidden opacity-0 transition-opacity duration-500 backdrop-blur-sm"
>
</div>

<div
  id="familias-main-view"
  class="pt-40 md:pt-48 pb-24 relative z-10 w-full min-h-screen flex flex-col transition-opacity duration-700 block"
>
  <div class="container mx-auto px-4 md:px-6 max-w-7xl flex-grow flex flex-col">
    <div class="text-center space-y-4 mb-20" data-aos="fade-down">
      <h2
        class="text-4xl md:text-6xl font-cinzel text-amber-600 dark:text-amber-500 font-bold tracking-[0.2em] uppercase drop-shadow-lg"
      >
        Los Linajes
      </h2>
      <p
        class="text-stone-500 dark:text-stone-400 font-light tracking-widest uppercase text-xs md:text-sm"
      >
        Selecciona una familia para explorar su árbol genealógico
      </p>
    </div>

    <div
      class="flex-grow w-full flex flex-col lg:flex-row gap-2 md:gap-4 h-[65vh] lg:h-[70vh] group/container"
    >
      {
        familiasData.map((familia) => (
          <div
            class="family-card relative overflow-hidden rounded-xl cursor-pointer bg-stone-900 border border-stone-800 shadow-2xl flex-1 group"
            style={`--family-accent: ${familia.accent};`}
            onclick={`openTreeViewer('${familia.id}')`}
          >
            <img
              src={familia.cover}
              class="absolute inset-0 w-full h-full object-cover opacity-40 group-hover:opacity-100 transition-opacity duration-700 mix-blend-luminosity grayscale group-hover:grayscale-0"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black via-black/50 to-transparent" />
            {/* Línea de acento lateral — visible solo en hover */}
            <div
              class="absolute left-0 top-0 bottom-0 w-[3px] opacity-0 group-hover:opacity-100 transition-opacity duration-500"
              style={`background: linear-gradient(to bottom, transparent, ${familia.accent}, transparent);`}
            />
