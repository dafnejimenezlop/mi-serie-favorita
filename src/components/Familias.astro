</div>

<div
  id="cinematic-viewer"
  class="fixed inset-0 z-[200] bg-[#050505] hidden opacity-0 transition-opacity duration-1000 overflow-y-auto snap-y snap-mandatory hide-scrollbar scroll-smooth"
>
  <button
    onclick="toggleSidebar()"
    class="fixed top-8 left-8 z-[260] text-white/50 hover:text-white transition-all group"
  >
    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"
      ><path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="1.5"
        d="M4 6h16M4 12h16M4 18h16"></path></svg
    >
  </button>

  <button
    onclick="closeCinematicViewer()"
    class="fixed top-8 right-8 z-[260] text-white/50 hover:text-white transition-all group"
  >
    <div
      class="w-10 h-10 rounded-full border border-stone-600 group-hover:border-white flex items-center justify-center bg-black/50 backdrop-blur-sm shadow-[0_0_15px_rgba(0,0,0,0.5)]"
    >
      <svg
        class="w-5 h-5 transform group-hover:rotate-90 transition-transform duration-300"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M6 18L18 6M6 6l12 12"></path></svg
      >
    </div>
  </button>

  <div
    class="fixed inset-0 w-full h-full z-0 overflow-hidden pointer-events-none"
  >
    <img
      id="cinematic-bg"
      src=""
      class="w-full h-full object-cover object-[70%_center] opacity-100 scale-100 transition-all duration-[1s] ease-out"
    />
    <div
      class="absolute inset-0 bg-gradient-to-t from-[#020202] via-[#020202]/80 to-transparent md:bg-gradient-to-r md:from-[#020202] md:via-[#020202]/80 md:to-transparent"
    >
    </div>
  </div>

  <div
    id="cinematic-content"
    class="relative z-10 w-full flex flex-col items-start pointer-events-none"
  >
  </div>
</div>

<style is:global>
  @media (min-width: 1024px) {
    .family-card {
      flex: 1;
    }
    .group\/container:hover .family-card {
      flex: 1;
    }
    .group\/container .family-card:hover {
      flex: 3;
    }
  }

  /* Ocultar scrollbars */
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .custom-scrollbar::-webkit-scrollbar {
    width: 4px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: rgba(245, 158, 11, 0.4);
    border-radius: 10px;
  }

  /* 1. MÁSCARA TIPO TYPEWRITER */
  .text-reveal {
    -webkit-mask-image: linear-gradient(
      to right,
      black 0%,
      black 50%,
      transparent 50%,
      transparent 100%
    );
    -webkit-mask-size: 200% 100%;
    -webkit-mask-position: 100% 0;
    transition: -webkit-mask-position 1.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* 2. SUBRAYADO MÁGICO */
  .magic-highlight {
    position: relative;
    display: inline-block;
    color: white;
    font-weight: 500;
  }
  .magic-highlight::after {
    content: '';
    position: absolute;
    bottom: 0px;
    left: 0;
    height: 40%;
    width: 0;
    background: rgba(245, 158, 11, 0.4);
    z-index: -1;
    transition: width 0.6s cubic-bezier(0.25, 1, 0.5, 1);
  }

  /* EFECTOS AL ENTRAR EN PANTALLA (.in-view) */
  .scroll-scene {
    opacity: 0.1;
    transform: translateY(30px);
    transition: all 1s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .scroll-scene.in-view {
    opacity: 1;
    transform: translateY(0);
  }
  .scroll-scene.in-view .text-reveal {
    -webkit-mask-position: 0% 0;
  }
  .scroll-scene.in-view .magic-highlight::after {
    width: 100%;
    transition-delay: 1.2s;
  }
  .scroll-scene.in-view .timeline-line {
    width: 6rem;
  }
  .scroll-scene.in-view .timeline-dot {
    opacity: 1;
  }

  .timeline-line {
    width: 0px;
    transition: width 1s ease-out 0.3s;
  }
  .timeline-dot {
    box-shadow: 0 0 10px rgba(245, 158, 11, 0.8);
    opacity: 0;
    transition: opacity 0.5s ease 1s;
  }

  /* Animación de barras de audio */
  @keyframes audio-bar {
    0% {
      height: 4px;
    }
    50% {
      height: 16px;
    }
    100% {
      height: 4px;
    }
  }
  .animate-audio-bar-1 {
    animation: audio-bar 1.2s ease-in-out infinite;
  }
  .animate-audio-bar-2 {
    animation: audio-bar 0.9s ease-in-out infinite 0.3s;
  }
  .animate-audio-bar-3 {
    animation: audio-bar 1.5s ease-in-out infinite 0.6s;
  }

  /* Ocultar botones y header global cuando entramos a familias */
  body.hide-global-ui #netflix-header,
  body.hide-global-ui #btnScrollToTop,
  body.hide-global-ui #btnScrollToBottom {
    opacity: 0 !important;
    pointer-events: none !important;
    display: none !important;
  }
</style>

<script is:inline define:vars={{ familiasData }}>
  let currentFamilyId = '';
  let observer = null;
  const audioEl = document.getElementById('dark-ambient-audio');
  if (audioEl) audioEl.volume = 0.5; // Volumen al 50% para no asustar

  let isAudioPlaying = false;

  // Lógica Botón Audio
  const btnAudio = document.getElementById('btn-audio-toggle');
  const audioBars = document.getElementById('audio-bars');
  const audioMutedIcon = document.getElementById('audio-muted-icon');

  if (btnAudio) {
    btnAudio.addEventListener('click', () => {
      if (!audioEl) return;
      if (isAudioPlaying) {
        audioEl.pause();
        audioBars.classList.add('hidden');
        audioMutedIcon.classList.remove('hidden');
      } else {
        audioEl.play().catch((e) => console.log(e));
        audioBars.classList.remove('hidden');
        audioMutedIcon.classList.add('hidden');
      }
      isAudioPlaying = !isAudioPlaying;
    });
  }

  // CONSTRUCCIÓN DEL SIDEBAR DINÁMICO
  function buildSidebar() {
    const sidebarContent = document.getElementById('sidebar-content');
    sidebarContent.innerHTML = '';

    familiasData.forEach((familia) => {
      if (!familia.generations || familia.generations.length === 0) return;
      const flatChars = familia.generations.flat();

      let html = `<div class="mb-6"><h3 class="font-cinzel text-stone-500 tracking-[0.2em] uppercase text-xs mb-4 border-b border-stone-800 pb-2">${familia.name}</h3><div class="grid grid-cols-2 gap-4">`;
      flatChars.forEach((char) => {
        html += `
          <div class="flex flex-col items-center gap-2 cursor-pointer group" onclick="jumpToCharacter('${familia.id}', '${char.id}')">
            <img src="${char.avatar}" class="w-16 h-16 object-cover grayscale opacity-60 group-hover:grayscale-0 group-hover:opacity-100 transition-all border border-transparent group-hover:border-amber-500 rounded">
            <span class="text-[10px] font-cinzel text-stone-400 group-hover:text-white uppercase text-center">${char.name}</span>
          </div>`;
      });
      html += `</div></div>`;
      sidebarContent.innerHTML += html;
    });
  }

  window.toggleSidebar = () => {
    const sidebar = document.getElementById('netflix-sidebar');
    const overlay = document.getElementById('sidebar-overlay');
    if (sidebar.classList.contains('-translate-x-full')) {
      buildSidebar();
      sidebar.classList.remove('-translate-x-full');
      overlay.classList.remove('hidden');
      setTimeout(() => overlay.classList.remove('opacity-0'), 10);
    } else {
      sidebar.classList.add('-translate-x-full');
      overlay.classList.add('opacity-0');
      setTimeout(() => overlay.classList.add('hidden'), 500);
    }
  };

  window.goToFamiliasOverview = () => {
    toggleSidebar();
    closeCinematicViewer();
    closeTreeViewer();
  };

  // SALTO DESDE SIDEBAR A PERSONAJE (Arreglo del Bug de la X)
  window.jumpToCharacter = (famId, charId) => {
    toggleSidebar();
    currentFamilyId = famId;
    document.body.classList.add('hide-global-ui');

    document.getElementById('familias-main-view').classList.add('hidden');
    document.getElementById('tree-viewer').classList.add('hidden');
    openCinematicViewer(charId);
  };

  // Fondo reactivo árbol
  document.getElementById('tree-viewer').addEventListener('mousemove', (e) => {
    const x = (e.clientX / window.innerWidth) * 100;
    const y = (e.clientY / window.innerHeight) * 100;
    document.getElementById('mouse-glow').style.background =
      `radial-gradient(circle 450px at ${x}% ${y}%, rgba(245, 158, 11, 0.15), transparent 70%)`;
  });

  // ABRIR ÁRBOL DE FAMILIA
  window.openTreeViewer = (familiaId) => {
    const familia = familiasData.find((f) => f.id === familiaId);
    if (!familia || !familia.generations || !familia.generations.length) {
      alert('Archivos de esta familia bloqueados por Sic Mundus...');
      return;
    }

    currentFamilyId = familiaId;
    document.getElementById('tree-family-name').innerText = familia.name;
    const container = document.getElementById('tree-nodes-container');
    container.innerHTML = '';

    familia.generations.forEach((gen, gIndex) => {
      const row = document.createElement('div');
      row.className =
        'flex justify-center gap-6 md:gap-12 relative z-10 w-full';
      gen.forEach((char) => {
        const node = document.createElement('div');
        node.className =
          'flex flex-col items-center gap-2 cursor-pointer group hover:scale-110 transition-transform duration-500 relative';
        node.onclick = () => openCinematicViewer(char.id);
        node.innerHTML = `
          <div class="relative w-16 h-16 md:w-20 md:h-20 rounded-sm overflow-hidden border border-stone-800 group-hover:border-amber-500 shadow-2xl transition-all">
            <img src="${char.avatar}" class="w-full h-full object-cover grayscale opacity-80 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-700">
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent"></div>
          </div>
          <p class="font-cinzel text-stone-400 group-hover:text-amber-500 tracking-widest uppercase text-[9px] md:text-[10px] transition-colors text-center w-20 md:w-24">
            ${char.name}
          </p>`;
        row.appendChild(node);
      });
      container.appendChild(row);

      if (gIndex < familia.generations.length - 1) {
        const line = document.createElement('div');
        line.className =
          'w-px h-6 md:h-10 bg-gradient-to-b from-stone-700 via-amber-500/50 to-stone-700 opacity-50 my-[-10px]';
        container.appendChild(line);
      }
    });

    document.body.classList.add('hide-global-ui');
    if (btnAudio) {
      btnAudio.classList.remove('hidden');
      btnAudio.classList.add('flex');
    }

    document.getElementById('familias-main-view').classList.add('hidden');
    const treeViewer = document.getElementById('tree-viewer');
    treeViewer.classList.remove('hidden');
    setTimeout(() => treeViewer.classList.remove('opacity-0'), 50);

    if (audioEl && !isAudioPlaying) {
      audioEl
        .play()
        .then(() => (isAudioPlaying = true))
        .catch((e) => console.log(e));
    }
  };

  // CERRAR ÁRBOL
  window.closeTreeViewer = () => {
    const treeViewer = document.getElementById('tree-viewer');
    treeViewer.classList.add('opacity-0');

    setTimeout(() => {
      treeViewer.classList.add('hidden');
      document.getElementById('familias-main-view').classList.remove('hidden');
      document.body.classList.remove('hide-global-ui');
      if (btnAudio) {
        btnAudio.classList.remove('flex');
        btnAudio.classList.add('hidden');
      }
    }, 700);

    if (audioEl) {
      audioEl.pause();
      isAudioPlaying = false;
    }
  };

  // ABRIR VISOR CINEMÁTICO (Con Snap Exacto)
  window.openCinematicViewer = (charId) => {
    const familia = familiasData.find((f) => f.id === currentFamilyId);
    if (!familia) return; // Protección por si no hay familia seleccionada

    const flatChars = familia.generations.flat();
    const char = flatChars.find((c) => c.id === charId);

    const contentArea = document.getElementById('cinematic-content');
    contentArea.innerHTML = '';

    if (observer) observer.disconnect();

    char.stages.forEach((stage, index) => {
      const isFirst = index === 0;

      const timelineHTML = `
        <div class="flex items-center gap-4 mb-4">
          <h2 class="font-cinzel text-xl md:text-3xl text-stone-300 uppercase tracking-[0.2em] font-light">
            ${stage.title}
          </h2>
          <div class="flex items-center gap-1">
            <svg class="w-3 h-3 text-amber-500 opacity-60" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2L15 9L22 12L15 15L12 22L9 15L2 12L9 9L12 2Z"></path></svg>
            <div class="h-px bg-stone-500/50 timeline-line"></div>
            <div class="w-1.5 h-1.5 rounded-full bg-stone-300 timeline-dot"></div>
          </div>
          <span class="font-mono text-[10px] md:text-xs tracking-widest text-stone-400">
            ${stage.timeline}
          </span>
        </div>
      `;

      contentArea.innerHTML += `
        <div class="scroll-scene w-full h-[100vh] flex items-center p-8 md:pl-24 md:pr-16 snap-center pointer-events-auto" data-image="${stage.img}">
          <div class="max-w-2xl relative w-full md:w-[60%] lg:w-[50%]">
            
            ${
              isFirst
                ? `
              <p class="text-stone-500 font-mono text-[10px] md:text-xs tracking-[0.3em] uppercase mb-12">
                Archivo / ${familia.name} / ${stage.subtitle}
              </p>
            `
                : ''
            }
            
            ${timelineHTML}
            
            <p class="text-stone-100 font-light text-base md:text-xl leading-relaxed drop-shadow-lg mt-6 text-reveal border-l border-white/10 pl-6">
              ${stage.text}
            </p>

            ${
              isFirst && char.stages.length > 1
                ? `
              <div class="mt-24 animate-pulse opacity-50 flex items-center gap-2">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path></svg>
                <span class="text-white font-mono text-[10px] tracking-widest uppercase">Scroll para explorar</span>
              </div>
            `
                : ''
            }
          </div>
        </div>
      `;
    });

    // PANTALLA "FIN DEL CICLO"
    contentArea.innerHTML += `
      <div class="scroll-scene w-full h-[100vh] flex items-center justify-center snap-center pointer-events-auto" data-image="none">
        <div class="text-center relative z-10">
          <svg class="w-24 h-24 mx-auto text-amber-500 opacity-20 mb-8" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="1.5">
            <circle cx="50" cy="40" r="28"></circle><circle cx="35" cy="65" r="28"></circle><circle cx="65" cy="65" r="28"></circle>
          </svg>
          <div class="w-12 h-px bg-amber-500 mb-6 mx-auto"></div>
          <h2 class="font-cinzel text-3xl md:text-5xl text-stone-500 uppercase tracking-[0.3em] font-light mb-12">
            Fin del ciclo
          </h2>
          <button onclick="closeCinematicViewer()" class="px-8 py-3 border border-stone-600 hover:border-amber-500 text-stone-400 hover:text-amber-500 rounded font-cinzel tracking-widest text-sm uppercase transition-all shadow-xl bg-black/50 backdrop-blur-sm">
            Volver al Árbol
          </button>
        </div>
      </div>
    `;

    const bgImage = document.getElementById('cinematic-bg');
    bgImage.src = char.stages[0].img;
    bgImage.dataset.current = char.stages[0].img;
    bgImage.style.opacity = '1';
    bgImage.style.transform = 'scale(1)';

    setTimeout(() => (bgImage.style.transform = 'scale(1.03)'), 50);

    const cineViewer = document.getElementById('cinematic-viewer');
    cineViewer.classList.remove('hidden');
    cineViewer.scrollTo(0, 0);
    setTimeout(() => cineViewer.classList.remove('opacity-0'), 50);

    initCinematicScroll();
  };

  // CERRAR VISOR CINEMÁTICO (Y regenerar árbol)
  window.closeCinematicViewer = () => {
    const cineViewer = document.getElementById('cinematic-viewer');
    cineViewer.classList.add('opacity-0');
    setTimeout(() => {
      cineViewer.classList.add('hidden');
      if (observer) observer.disconnect();

      // Regenerar el árbol por si veníamos de un salto del Sidebar
      openTreeViewer(currentFamilyId);
    }, 700);
  };

  // OBSERVER DEL SCROLL (Con arreglo de imágenes)
  function initCinematicScroll() {
    const scenes = document.querySelectorAll('.scroll-scene');
    const bgImage = document.getElementById('cinematic-bg');
    const cineViewer = document.getElementById('cinematic-viewer');

    observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('in-view');

            const newImgSrc = entry.target.getAttribute('data-image');

            if (newImgSrc === 'none') {
              bgImage.style.opacity = '0';
              bgImage.dataset.current = 'none';
            } else if (newImgSrc && bgImage.dataset.current !== newImgSrc) {
              bgImage.style.opacity = '0';
              setTimeout(() => {
                bgImage.src = newImgSrc;
                bgImage.style.opacity = '1';
                bgImage.dataset.current = newImgSrc;
              }, 600);
            } else if (newImgSrc && bgImage.dataset.current === newImgSrc) {
              // Si la imagen era "none" y volvemos a subir, reactivamos la opacidad
              bgImage.style.opacity = '1';
            }
          } else {
            entry.target.classList.remove('in-view');
          }
        });
      },
      {
        root: cineViewer,
        threshold: 0.55,
      },
    );

    scenes.forEach((sec) => observer.observe(sec));
  }
</script>
