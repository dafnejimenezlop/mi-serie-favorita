  // ============================
  // CURSOR TRIQUETA EN EL ÁRBOL
  // ============================
  const treeCursor = document.getElementById('tree-cursor');
  const treePanEl = document.getElementById('tree-pan-area');
  const treeViewerEl = document.getElementById('tree-viewer');

  // Seguimiento del cursor a nivel documento — así nunca se pierde
  document.addEventListener('pointermove', (e) => {
    if (!treeCursor) return;
    treeCursor.style.left = e.clientX + 'px';
    treeCursor.style.top = e.clientY + 'px';

    // Mostrar triqueta solo si el tree-viewer está activo y el ratón está en el pan-area
    const treeVisible =
      !treeViewerEl.classList.contains('hidden') &&
      !treeViewerEl.classList.contains('opacity-0');
    if (!treeVisible) {
      treeCursor.style.opacity = '0';
      return;
    }
    const rect = treePanEl.getBoundingClientRect();
    const inside =
      e.clientX >= rect.left &&
      e.clientX <= rect.right &&
      e.clientY >= rect.top &&
      e.clientY <= rect.bottom;
    treeCursor.style.opacity = inside ? '1' : '0';
  });

  // Asegurarse de que al cerrar el tree-viewer el cursor desaparece
  document.addEventListener('pointerleave', () => {
    if (treeCursor) treeCursor.style.opacity = '0';
  });

  document.getElementById('tree-viewer').addEventListener('mousemove', (e) => {
    // Glow del ratón
    const x = (e.clientX / window.innerWidth) * 100;
    const y = (e.clientY / window.innerHeight) * 100;
    document.getElementById('mouse-glow').style.background =
      `radial-gradient(circle 450px at ${x}% ${y}%, rgba(245, 158, 11, 0.15), transparent 70%)`;
  });

  // ============================
  // ZOOM / PAN LOGIC
  // ============================
  let treeScale = 1;
  let treePanX = 0;
  let treePanY = 0;
  let isDragging = false;
  let dragStartX = 0;
  let dragStartY = 0;
  let dragOriginPanX = 0;
  let dragOriginPanY = 0;

  const MIN_SCALE = 0.3;
  const MAX_SCALE = 2.5;
  const ZOOM_STEP = 0.15;

  function applyTreeTransform(smooth = false) {
    const zc = document.getElementById('tree-zoom-container');
    if (!zc) return;
    if (smooth) {
      zc.classList.add('smooth-reset');
      setTimeout(() => zc.classList.remove('smooth-reset'), 420);
    }
    zc.style.transform = `translate(${treePanX}px, ${treePanY}px) scale(${treeScale})`;
  }

  // `smooth` controla si el salto a la posición centrada anima el transform
  // (420ms, vía la clase `smooth-reset`) o lo aplica al instante. Los
  // centrados AUTOMÁTICOS (justo al dibujar el árbol, antes de que el
  // usuario haya visto nada) deben ser instantáneos — si animan, el fade-in
  // de opacidad del visor (que arranca en paralelo, ver showTreeViewer)
  // puede pillar la transición a medias y mostrar el árbol sin centrar
  // durante ese primer instante. La animación suave solo tiene sentido para
  // el reset manual (botón "encajar en pantalla"), donde el usuario ya está
  // viendo el árbol y el movimiento es una señal útil de que algo cambió.
  function centerTree(smooth = false) {
    const panArea = document.getElementById('tree-pan-area');
    const container = document.getElementById('tree-nodes-container');
    const zoomContainer = document.getElementById('tree-zoom-container');
    if (!panArea || !container || !zoomContainer) return;

    const areaW = panArea.offsetWidth;
    const areaH = panArea.offsetHeight;
    const contW = container.offsetWidth;
    const contH = container.offsetHeight;

    if (contW === 0 || contH === 0) return;

    // Escala para que quepa todo con margen
    const scaleX = (areaW * 0.88) / contW;
    const scaleY = (areaH * 0.82) / contH;
    treeScale = Math.min(scaleX, scaleY, 1);
    treeScale = Math.max(treeScale, MIN_SCALE);

    // Centrar: el zoom-container empieza en top:0 left:0 del pan-area
    // necesitamos que el punto de anclaje sea el centro del contenido escalado
    treePanX = (areaW - contW * treeScale) / 2;
    treePanY = (areaH - contH * treeScale) / 2;

    applyTreeTransform(smooth);
  }

  window.zoomIn = () => {
    treeScale = Math.min(treeScale + ZOOM_STEP, MAX_SCALE);
    applyTreeTransform();
  };
  window.zoomOut = () => {
    treeScale = Math.max(treeScale - ZOOM_STEP, MIN_SCALE);
    applyTreeTransform();
  };
  window.zoomReset = () => {
    centerTree(true);
  };

  // Rueda del ratón → zoom centrado en el cursor
  document.getElementById('tree-pan-area').addEventListener(
    'wheel',
    (e) => {
      e.preventDefault();
      const delta = e.deltaY > 0 ? -ZOOM_STEP : ZOOM_STEP;
      const newScale = Math.min(
        Math.max(treeScale + delta, MIN_SCALE),
        MAX_SCALE,
      );

      // Zoom relativo al punto del cursor
      const rect = document
        .getElementById('tree-pan-area')
        .getBoundingClientRect();
      const mouseX = e.clientX - rect.left;
      const mouseY = e.clientY - rect.top;

      treePanX = mouseX - (mouseX - treePanX) * (newScale / treeScale);
      treePanY = mouseY - (mouseY - treePanY) * (newScale / treeScale);
      treeScale = newScale;
      applyTreeTransform();
    },
    { passive: false },
  );

  // Touch pinch zoom
  let lastTouchDist = null;
  document.getElementById('tree-pan-area').addEventListener(
    'touchstart',
    (e) => {
      if (e.touches.length === 2) {
        lastTouchDist = Math.hypot(
          e.touches[0].clientX - e.touches[1].clientX,
          e.touches[0].clientY - e.touches[1].clientY,
        );
      } else if (e.touches.length === 1) {
        isDragging = true;
        dragStartX = e.touches[0].clientX;
        dragStartY = e.touches[0].clientY;
        dragOriginPanX = treePanX;
        dragOriginPanY = treePanY;
      }
    },
    { passive: true },
  );

  document.getElementById('tree-pan-area').addEventListener(
    'touchmove',
    (e) => {
      if (e.touches.length === 2 && lastTouchDist !== null) {
        e.preventDefault();
        const dist = Math.hypot(
          e.touches[0].clientX - e.touches[1].clientX,
          e.touches[0].clientY - e.touches[1].clientY,
        );
        const delta = (dist - lastTouchDist) * 0.005;
        treeScale = Math.min(Math.max(treeScale + delta, MIN_SCALE), MAX_SCALE);
        lastTouchDist = dist;
        applyTreeTransform();
      } else if (e.touches.length === 1 && isDragging) {
        treePanX = dragOriginPanX + (e.touches[0].clientX - dragStartX);
        treePanY = dragOriginPanY + (e.touches[0].clientY - dragStartY);
        applyTreeTransform();
      }
    },
    { passive: false },
  );

  document.getElementById('tree-pan-area').addEventListener('touchend', () => {
    isDragging = false;
    lastTouchDist = null;
  });

  // Arrastrar con ratón
  document
    .getElementById('tree-pan-area')
    .addEventListener('mousedown', (e) => {
      if (e.target.closest('[data-tree-node]')) return;
      isDragging = true;
      dragStartX = e.clientX;
      dragStartY = e.clientY;
      dragOriginPanX = treePanX;
      dragOriginPanY = treePanY;
      if (treeCursor)
        treeCursor.style.transform = 'translate(-50%, -50%) scale(0.8)';
      e.preventDefault();
    });

  document.addEventListener('mousemove', (e) => {
    if (!isDragging) return;
    treePanX = dragOriginPanX + (e.clientX - dragStartX);
    treePanY = dragOriginPanY + (e.clientY - dragStartY);
    applyTreeTransform();
  });

  document.addEventListener('mouseup', () => {
    isDragging = false;
    if (treeCursor)
      treeCursor.style.transform = 'translate(-50%, -50%) scale(1)';
  });

  // Guarda de generación para las transiciones abrir/cerrar árbol: si el
  // usuario cierra y reabre (la misma familia u otra) antes de que termine
  // la animación de cierre, el setTimeout retrasado de closeTreeViewer no
  // debe volver a ocultar un árbol que ya se reabrió después — y viceversa,
  // un setTimeout retrasado de un openTreeViewer anterior no debe pisar un
  // cierre posterior. Cada llamada reclama un token propio; solo el más
  // reciente puede ejecutar sus callbacks diferidos.
  let treeViewerToken = 0;

  window.openTreeViewer = (familiaId) => {
    const isDrawn = drawTree(familiaId);
    if (!isDrawn) {
      alert('Archivos bloqueados por Sic Mundus...');
      return;
    }

    const viewerToken = ++treeViewerToken;

    document.body.classList.add('hide-global-ui');
    if (btnAudio) {
      btnAudio.classList.remove('hidden');
      btnAudio.classList.add('flex');
    }

    document.getElementById('familias-main-view').classList.add('hidden');
    const treeViewer = document.getElementById('tree-viewer');
    treeViewer.classList.remove('hidden');
    setTimeout(() => {
      if (viewerToken !== treeViewerToken) return;
      treeViewer.classList.remove('opacity-0');
      // Esperar a que el DOM esté pintado + las líneas SVG calculadas antes de centrar
      setTimeout(() => {
        if (viewerToken !== treeViewerToken) return;
        centerTree();
      }, 250);
    }, 50);

    playSectionAudio();
  };

  window.closeTreeViewer = () => {
    const viewerToken = ++treeViewerToken;

    if (treeCursor) treeCursor.style.opacity = '0';
    const treeViewer = document.getElementById('tree-viewer');
    treeViewer.classList.add('opacity-0');

    setTimeout(() => {
      if (viewerToken !== treeViewerToken) return;
      treeViewer.classList.add('hidden');
      document.getElementById('familias-main-view').classList.remove('hidden');
      document.body.classList.remove('hide-global-ui');
      if (btnAudio) {
        btnAudio.classList.remove('flex');
        btnAudio.classList.add('hidden');
      }
    }, 700);

    resumeAudioOnFocus = false;
    pauseSectionAudio();
  };

  // ABRIR VISOR CINEMÁTICO (Snap exacto 100vh)
  function characterNameById(characterId) {
