  // Lógica Botón Audio Elegante (Bars vs Mute Icon)
  if (btnAudio) {
    btnAudio.addEventListener('click', () => {
      if (!audioEl) return;
      if (isAudioPlaying) {
        audioMutedByUser = true;
        try {
          localStorage.setItem(AUDIO_MUTED_KEY, '1');
        } catch {}
        resumeAudioOnFocus = false;
        pauseSectionAudio();
      } else {
        audioMutedByUser = false;
        try {
          localStorage.setItem(AUDIO_MUTED_KEY, '0');
        } catch {}
        playSectionAudio();
      }
    });
  }

  function isImmersiveViewActive() {
    const treeViewer = document.getElementById('tree-viewer');
    const cineViewer = document.getElementById('cinematic-viewer');
    return (
      !treeViewer.classList.contains('hidden') ||
      !cineViewer.classList.contains('hidden')
    );
  }

  function syncAudioButton() {
    if (!audioBars || !audioMutedIcon) return;
    if (isAudioPlaying) {
      audioBars.classList.remove('hidden');
      audioMutedIcon.classList.add('hidden');
    } else {
      audioBars.classList.add('hidden');
      audioMutedIcon.classList.remove('hidden');
    }
  }

  function pauseSectionAudio({ remember = false } = {}) {
    if (!audioEl) return;
    if (remember) {
      resumeAudioOnFocus =
        resumeAudioOnFocus || (isAudioPlaying && isImmersiveViewActive());
    }
    audioEl.pause();
    isAudioPlaying = false;
    syncAudioButton();
  }

  function playSectionAudio() {
    if (audioMutedByUser) return;
    if (!audioEl || document.hidden || !isImmersiveViewActive()) return;
    audioEl
      .play()
      .then(() => {
        isAudioPlaying = true;
        syncAudioButton();
      })
      .catch((e) => console.log(e));
  }

  function resumeSectionAudioIfNeeded() {
    if (!resumeAudioOnFocus || !isImmersiveViewActive()) return;
    resumeAudioOnFocus = false;
    playSectionAudio();
    setTimeout(playSectionAudio, 250);
    setTimeout(playSectionAudio, 900);
  }

  document.addEventListener('visibilitychange', () => {
    if (document.hidden) {
      pauseSectionAudio({ remember: true });
      return;
    }

    resumeSectionAudioIfNeeded();
  });

  window.addEventListener('blur', () => {
    pauseSectionAudio({ remember: true });
  });

  window.addEventListener('focus', () => {
    resumeSectionAudioIfNeeded();
  });

  function buildSidebar() {
    const sidebarContent = document.getElementById('sidebar-content');
    sidebarContent.innerHTML = '';

    familiasData.forEach((familia) => {
      if (!familia.generations || familia.generations.length === 0) return;
      const flatChars = familia.generations.flat();

      let html = `<div class="mb-6"><h3 class="font-cinzel text-stone-500 tracking-[0.2em] uppercase text-xs mb-4 border-b border-stone-800 pb-2">${familia.name}</h3><div class="grid grid-cols-2 gap-4">`;
      flatChars.forEach((char) => {
        html += `
          <div class="flex flex-col items-center gap-2 cursor-pointer group pointer-events-auto" onclick="jumpToCharacter('${familia.id}', '${char.id}')">
            <img src="${char.avatar}" class="w-16 h-16 object-cover grayscale opacity-60 group-hover:grayscale-0 group-hover:opacity-100 transition-all border border-transparent group-hover:border-amber-500 rounded">
            <span class="text-[10px] font-cinzel text-stone-400 group-hover:text-white uppercase text-center">${char.name}</span>
          </div>`;
      });
      html += `</div></div>`;
      sidebarContent.innerHTML += html;
    });
  }

  window.toggleSidebar = () => {
    const sidebar = document.getElementById('netflix-sidebar');
    const overlay = document.getElementById('sidebar-overlay');
    if (sidebar.classList.contains('-translate-x-full')) {
      buildSidebar();
      sidebar.classList.remove('-translate-x-full');
      overlay.classList.remove('hidden');
      setTimeout(() => overlay.classList.remove('opacity-0'), 10);
    } else {
      sidebar.classList.add('-translate-x-full');
      overlay.classList.add('opacity-0');
      setTimeout(() => overlay.classList.add('hidden'), 500);
    }
  };

