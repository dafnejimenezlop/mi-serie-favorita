  // DIBUJAR ÁRBOL con líneas SVG reales (pareja + descendencia)
  // Version relacional: usa relationshipData directamente en lugar de inferir por filas.
  function drawTreeLines(relationships, svg, container) {
    svg.innerHTML = '';
    const W = container.offsetWidth;
    const H = container.offsetHeight;

    svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
    svg.style.width = W + 'px';
    svg.style.height = H + 'px';

    // El rect del contenedor se leía DENTRO de nodeCenter(), es decir una vez
    // por nodo (25 lecturas idénticas). Se mide una sola vez aquí.
    const containerRect = container.getBoundingClientRect();

    function nodeCenter(node) {
      const img = node.querySelector('img');
      const targetRect = (img || node).getBoundingClientRect();
      return {
        cx: targetRect.left - containerRect.left + targetRect.width / 2,
        top: targetRect.top - containerRect.top,
        bottom: targetRect.bottom - containerRect.top,
        mid: targetRect.top - containerRect.top + targetRect.height / 2,
      };
    }

    const defs = document.createElementNS('http://www.w3.org/2000/svg', 'defs');
    svg.appendChild(defs);

    // ===== TRAZOS PLANOS, SIN FILTROS NI DEGRADADOS POR LÍNEA =====
    // La versión anterior creaba, POR CADA conector, un <linearGradient> y un
    // <filter> con feGaussianBlur propios: en el Árbol Completo eso son ~40
    // filtros de desenfoque y ~40 degradados vivos a la vez. Un filtro SVG
    // obliga al navegador a rasterizar ese elemento en una textura aparte, y
    // a REHACERLA cada vez que cambia la escala — o sea, en cada paso de zoom
    // y en cada frame de un arrastre. Era el tercer gran coste del visor.
    //
    // Ahora cada conector es un único <path> con trazo plano. El "resplandor"
    // se consigue con color y grosor, que son gratis, y el acento ámbar se
    // reserva para el linaje resaltado — que es justo como se lee el árbol de
    // Netflix: líneas apagadas de base, brillo solo en el camino que importa.
    // Los ids degenerados (bbox de alto o ancho cero) que obligaban a generar
    // defs por elemento dejan de ser un problema: sin filtros ni degradados,
    // no hay nada cuyo bounding box pueda anularse.
    const SVG_NS = 'http://www.w3.org/2000/svg';

    function tagEdge(el, from, to) {
      el.setAttribute('class', 'tree-edge');
      el.dataset.from = from;
      el.dataset.to = to;
      return el;
    }

    function makeLine(x1, y1, x2, y2) {
      const el = document.createElementNS(SVG_NS, 'line');
      el.setAttribute('x1', x1);
      el.setAttribute('y1', y1);
      el.setAttribute('x2', x2);
      el.setAttribute('y2', y2);
      el.setAttribute('stroke-linecap', 'round');
      return el;
    }

    function makePath(d) {
      const el = document.createElementNS(SVG_NS, 'path');
      el.setAttribute('d', d);
      el.setAttribute('fill', 'none');
      el.setAttribute('stroke-linecap', 'round');
      el.setAttribute('stroke-linejoin', 'round');
      return el;
    }

    function makeDiamond(cx, cy) {
      const el = document.createElementNS(SVG_NS, 'polygon');
      el.setAttribute(
        'points',
        `${cx},${cy - 5} ${cx + 5},${cy} ${cx},${cy + 5} ${cx - 5},${cy}`,
      );
      el.setAttribute('class', 'tree-edge-knot');
      return el;
    }

    function makeArrow(cx, y, from, to) {
      const el = document.createElementNS(SVG_NS, 'polygon');
      el.setAttribute(
        'points',
        `${cx - 3.5},${y - 7} ${cx + 3.5},${y - 7} ${cx},${y}`,
      );
      return tagEdge(el, from, to);
    }

    // Codos redondeados: en vez de una esquina en ángulo recto, un pequeño
    // arco de radio fijo. Es el detalle que separa un diagrama "de debug" de
    // uno con acabado editorial, y no cuesta nada — sigue siendo un path.
    function elbow(fromX, startY, toX, toY, midY) {
      const r = Math.min(14, Math.abs(toX - fromX) / 2, Math.abs(midY - startY));
      if (!Number.isFinite(r) || r < 2) {
        return `M ${fromX} ${startY} L ${fromX} ${midY} L ${toX} ${midY} L ${toX} ${toY}`;
      }
      const dir = toX > fromX ? 1 : -1;
      return [
        `M ${fromX} ${startY}`,
        `L ${fromX} ${midY - r}`,
        `Q ${fromX} ${midY} ${fromX + dir * r} ${midY}`,
        `L ${toX - dir * r} ${midY}`,
        `Q ${toX} ${midY} ${toX} ${midY + r}`,
        `L ${toX} ${toY}`,
      ].join(' ');
    }

    const nodesById = new Map();
    container.querySelectorAll('[data-tree-node]').forEach((node) => {
      nodesById.set(node.dataset.charId, nodeCenter(node));
    });

    const couples = relationships.filter(
      (relationship) => relationship.type === 'couple',
    );
    const parentChild = relationships.filter(
      (relationship) => relationship.type === 'parentChild',
    );
    const coupleMidpoints = new Map();

    couples.forEach((relationship) => {
      const from = nodesById.get(relationship.from);
      const to = nodesById.get(relationship.to);
      if (!from || !to) {
        console.warn('Tree line skipped: couple relationship has no resolvable position', {
          id: relationship.id,
          type: relationship.type,
          from: relationship.from,
          to: relationship.to,
          familyId: relationship.familyId,
        });
        return;
      }

      const y = (from.mid + to.mid) / 2;
      const midX = (from.cx + to.cx) / 2;
      const key = [relationship.from, relationship.to].sort().join(':');
      coupleMidpoints.set(key, { x: midX, y });

      svg.appendChild(
        tagEdge(
          makeLine(from.cx, from.mid, to.cx, to.mid),
          relationship.from,
          relationship.to,
        ),
      );
      const knot = makeDiamond(midX, y);
      knot.dataset.from = relationship.from;
      knot.dataset.to = relationship.to;
      svg.appendChild(knot);
    });

    // Agrupa por hijo primero (no por relación individual): un hijo puede
    // tener más de dos "padres" registrados (p. ej. Mikkel: Ulrich+Katharina
    // como progenitores biológicos, más Ines como figura tutora en el
    // universo Kahnwald). La versión anterior recalculaba "parents" en cada
    // iteración de `parentChild` filtrando solo por `to === relationship.to`,
    // así que las 3 relaciones de Mikkel colapsaban siempre en la misma key
    // (la de la pareja Ulrich+Katharina) y la línea de Ines nunca llegaba a
    // insertarse en el Map. Ahora: se detecta como mucho UNA pareja entre los
    // padres de cada hijo (se sigue dibujando como una sola línea desde el
    // punto medio de la pareja), y cualquier padre que no forme parte de esa
    // pareja recibe su propia línea individual hacia el hijo.
    const childrenByParents = new Map();
    const parentsByChild = new Map();

    parentChild.forEach((relationship) => {
      if (!parentsByChild.has(relationship.to)) {
        parentsByChild.set(relationship.to, new Set());
      }
      parentsByChild.get(relationship.to).add(relationship.from);
    });

    parentsByChild.forEach((parentsSet, child) => {
      const parents = Array.from(parentsSet);
      const couple = couples.find(
        (candidate) =>
          parents.includes(candidate.from) && parents.includes(candidate.to),
      );
      const usedParents = new Set();

      if (couple) {
        const key = `${[couple.from, couple.to].sort().join(':')}->${child}`;
        childrenByParents.set(key, { parents: [couple.from, couple.to], child });
        usedParents.add(couple.from);
        usedParents.add(couple.to);
      }

      parents
        .filter((parentId) => !usedParents.has(parentId))
        .forEach((parentId) => {
          const key = `${parentId}->${child}`;
          childrenByParents.set(key, { parents: [parentId], child });
        });
    });

    Array.from(childrenByParents.values()).forEach((group) => {
      const child = nodesById.get(group.child);
      if (!child) {
        console.warn('Tree line skipped: child has no resolvable position', {
          child: group.child,
          parents: group.parents,
        });
        return;
      }

      const parentCenters = group.parents
        .map((parentId) => nodesById.get(parentId))
        .filter(Boolean);
      if (!parentCenters.length) {
        console.warn('Tree line skipped: no parent has a resolvable position', {
          child: group.child,
          parents: group.parents,
        });
        return;
      }

      const coupleKey =
        group.parents.length > 1 ? [...group.parents].sort().join(':') : '';
      const couplePoint = coupleMidpoints.get(coupleKey);
      const fromX =
        couplePoint?.x ??
        parentCenters.reduce((sum, center) => sum + center.cx, 0) /
          parentCenters.length;
      const fromY =
        couplePoint?.y ??
        Math.max(...parentCenters.map((center) => center.bottom));
      const startY = couplePoint ? fromY + 5 : fromY;
      const midY = startY + (child.top - startY) * 0.48;
      const isStraight = Math.abs(fromX - child.cx) < 4;
      const d = isStraight
        ? `M ${fromX} ${startY} L ${child.cx} ${child.top}`
        : elbow(fromX, startY, child.cx, child.top, midY);

      // Una relación hijo↔pareja se etiqueta con AMBOS progenitores separados
      // por espacio, para que el resaltado de linaje pueda encenderla venga
      // desde el hijo o desde cualquiera de los dos padres.
      svg.appendChild(
        tagEdge(makePath(d), group.parents.join(' '), group.child),
      );
      svg.appendChild(
        makeArrow(child.cx, child.top, group.parents.join(' '), group.child),
      );
    });
  }

  // Espera a que las imágenes de los nodos del árbol terminen de decodificar
  // (o fallen) y a un frame extra de layout antes de medir posiciones con
  // getBoundingClientRect — evita líneas/iconos ausentes por leer posiciones
  // antes de que el navegador haya terminado de pintar los avatares.
  // Espera hasta que el contenedor del árbol tenga tamaño real (visible en
  // pantalla) antes de medir sus nodos. Si el árbol se dibuja mientras el
  // visor está oculto (p. ej. salto entre familias desde la barra lateral),
  // medir antes de tiempo produce rectángulos de tamaño cero y líneas rotas
  // de forma permanente. Se autocancela con el mismo treeDrawToken que ya
  // usa scheduleTreeLinesDraw si un nuevo dibujo lo deja obsoleto mientras
  // espera.
  function waitForVisibleTreeContainer(container, drawToken) {
    return new Promise((resolve) => {
      function check() {
        if (drawToken !== treeDrawToken) {
          resolve(false);
          return;
        }
        if (container.offsetWidth > 0 && container.offsetHeight > 0) {
          resolve(true);
          return;
        }
        requestAnimationFrame(check);
      }
      check();
    });
  }

  function scheduleTreeLinesDraw(relationships, svg, container, options = {}) {
    const images = Array.from(container.querySelectorAll('img'));
    const ready =
      images.length === 0
        ? Promise.resolve()
        : Promise.all(
            images.map((img) =>
              img.decode ? img.decode().catch(() => {}) : Promise.resolve(),
            ),
          );

    // Captura el token vigente en el momento de la llamada: si para cuando
    // este dibujo esté listo el usuario ya cambió de árbol/familia (nuevo
    // token), este resultado quedó obsoleto y no debe dibujarse.
    const drawToken = treeDrawToken;

    ready
      .then(() => waitForVisibleTreeContainer(container, drawToken))
      .then((isVisible) => {
        if (!isVisible) return;
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            if (drawToken !== treeDrawToken) return;
            // El zoom/pan dejado por una visita anterior a cualquier árbol
            // sigue aplicado al contenedor en este punto: si no se resetea
            // antes de medir, drawTreeLines() mide posiciones ya escaladas
            // y las líneas quedan mal calculadas de forma permanente.
            // #tree-zoom-container tiene SIEMPRE una transición CSS de
            // transform (0.08s, o 0.4s si queda la clase smooth-reset de un
            // centerTree() anterior) — asignar el transform directamente no
            // basta, el navegador la anima igualmente y drawTreeLines()
            // mediría posiciones a mitad de esa animación. Se anula la
            // transición con un estilo inline (máxima especificidad, gana a
            // cualquier regla de clase), se fuerza un reflow síncrono para
            // que el cambio de transform se aplique ya, y solo entonces se
            // restaura la transición — centerTree() (llamado después, vía
            // onDrawn) es quien anima suavemente hacia el zoom final.
            treeScale = 1;
            treePanX = 0;
            treePanY = 0;
            const zc = document.getElementById('tree-zoom-container');
            if (zc) {
              zc.classList.remove('smooth-reset');
              zc.style.transition = 'none';
              zc.style.transform = 'translate(0px, 0px) scale(1)';
              void zc.offsetWidth;
              zc.style.transition = '';
            }
            drawTreeLines(relationships, svg, container);
            if (typeof options.onDrawn === 'function') options.onDrawn();
          });
        });
      });
  }

  function drawTree(familiaId) {
    const familia = familiasData.find((f) => f.id === familiaId);
    const layout = familyLayouts[familiaId];
    if (!familia || !layout) return false;

    currentFamilyId = familiaId;
    currentTreeMode = 'family';
    treeDrawToken++;
    document.getElementById('tree-family-name').innerText = familia.name;
    syncFamilySwitch(familiaId);

    const container = document.getElementById('tree-nodes-container');
    // El árbol por familia no usa resaltado de linaje: si venimos del Árbol
    // Completo hay que soltar sus listeners, que si no seguirían vivos sobre
    // este mismo contenedor reteniendo nodos ya desechados.
    teardownLineageHighlight(container);
    container.innerHTML = '';
    container.className = 'family-tree-canvas relative';
    container.style.width = layout.width + 'px';
    container.style.height = layout.height + 'px';
    container.style.minWidth = layout.width + 'px';
    container.style.minHeight = layout.height + 'px';
    container.style.position = 'relative';

    const svgOverlay = document.createElementNS(
      'http://www.w3.org/2000/svg',
      'svg',
    );
    svgOverlay.id = 'tree-svg-lines';
    svgOverlay.style.cssText =
      'position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;overflow:visible;z-index:6;';

    familia.generations.flat().forEach((char) => {
      const pos = layout.nodes[char.id];
      if (!pos) return;
      const nodeShell = document.createElement('div');
      nodeShell.className = 'family-tree-node';
      nodeShell.style.left = pos.x + 'px';
      nodeShell.style.top = pos.y + 'px';
      nodeShell.appendChild(renderTreeNode(familia, char));
      container.appendChild(nodeShell);
    });

    container.appendChild(svgOverlay);

    scheduleTreeLinesDraw(
      getFamilyRelationships(familia.id),
      svgOverlay,
      container,
      { onDrawn: centerTree },
    );

    return true;
  }

  // Ficha de personaje del árbol. Cambios de acabado respecto a la anterior:
  //  · retrato en proporción 3/4 (no cuadrado) y más grande — a la escala a
  //    la que se ve el árbol completo, 56px de lado dejaban las caras
  //    irreconocibles, que es el trabajo que la ficha tiene que hacer;
  //  · el nombre se convierte en un pie sólido, legible sobre cualquier fondo,
  //    en vez de texto suelto de 8px;
  //  · el `hover:scale-105` sobre el nodo entero se sustituye por un zoom
  //    interno de la imagen: escalar el nodo movía también el punto donde
  //    acaban los conectores, y la línea quedaba despegada de la ficha.
  function renderTreeNode(familia, char) {
    const timelineLabel =
      char.stages && char.stages[0] ? char.stages[0].timeline : '';
    const node = document.createElement('div');
    node.className =
      'tree-node-wrap group relative flex flex-col items-center pointer-events-auto';
    node.setAttribute('data-tree-node', '1');
    node.setAttribute('data-char-id', char.id);
    node.setAttribute('data-family-id', familia.id);
    node.setAttribute('role', 'button');
    node.setAttribute('tabindex', '0');
    node.setAttribute('aria-label', `Ver a ${char.name}`);
    node.onclick = () => openCharacterFromTree(familia.id, char.id);
    node.onkeydown = (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        openCharacterFromTree(familia.id, char.id);
      }
    };
    node.innerHTML = `
      ${timelineLabel ? `<div class="tree-tooltip">${timelineLabel}</div>` : ''}
      <div class="tree-node-frame relative w-[62px] h-[82px] md:w-[84px] md:h-[112px] overflow-hidden rounded-[3px] border border-stone-700/80 bg-stone-900 z-10">
        <!-- SIN loading="lazy" a propósito. scheduleTreeLinesDraw() espera a
             img.decode() de TODOS los avatares antes de medir posiciones y
             trazar los conectores; una imagen diferida que aún no ha
             empezado a cargar deja esa promesa pendiente para siempre y el
             árbol se queda sin líneas. Además estos nodos solo se crean al
             abrir el visor, así que diferirlos no ahorraría nada. -->
        <img src="${char.avatar}" alt="" decoding="async"
             class="tree-node-img w-full h-full object-cover object-top">
        <div class="absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-black via-black/60 to-transparent pointer-events-none"></div>
        <p class="tree-node-name absolute inset-x-0 bottom-0 px-1 pb-1.5 font-cinzel text-stone-200 uppercase text-[7px] md:text-[9px] leading-[1.15] text-center">
          ${char.name}
        </p>
      </div>`;
    return node;
  }

  function drawCompleteTree() {
    currentTreeMode = 'complete';
    treeDrawToken++;
    document.getElementById('tree-family-name').innerText = 'Árbol Completo';
    syncFamilySwitch('__complete');

    const container = document.getElementById('tree-nodes-container');
    container.innerHTML = '';
    container.className = 'complete-tree-grid relative';
    container.style.width = completeLayout.width + 'px';
    container.style.height = completeLayout.height + 'px';
    container.style.minWidth = completeLayout.width + 'px';
    container.style.minHeight = completeLayout.height + 'px';
    container.style.position = 'relative';

    const svgOverlay = document.createElementNS(
      'http://www.w3.org/2000/svg',
      'svg',
    );
    svgOverlay.id = 'tree-svg-lines';
    svgOverlay.style.cssText =
      'position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;overflow:visible;z-index:6;';

    // Etiquetas de familia flotantes — mapa único, sin bloques separados.
    completeLayout.labels.forEach((label) => {
      const familia = familiasData.find((family) => family.id === label.familyId);
      if (!familia) return;
      const labelEl = document.createElement('h3');
      labelEl.className = 'complete-family-label';
      labelEl.style.left = label.x + 'px';
      labelEl.style.top = label.y + 'px';
      labelEl.style.setProperty('--family-accent', familia.accent);
      labelEl.textContent = familia.name;
      container.appendChild(labelEl);
    });

    familiasData.forEach((familia) => {
      familia.generations.flat().forEach((char) => {
        const pos = completeLayout.nodes[char.id];
        if (!pos) return;
        const nodeShell = document.createElement('div');
        nodeShell.className = 'complete-tree-node';
        nodeShell.dataset.charId = char.id;
        nodeShell.style.left = pos.x + 'px';
        nodeShell.style.top = pos.y + 'px';
        if (pos.core) nodeShell.dataset.core = '1';
        nodeShell.appendChild(renderTreeNode(familia, char));
        container.appendChild(nodeShell);
      });
    });

    container.appendChild(svgOverlay);

    // setupLineageHighlight() DEBE ir dentro de onDrawn: los conectores no
    // existen hasta que scheduleTreeLinesDraw termina su espera asíncrona
    // (decodificación de avatares + dos frames de layout). Llamándolo aquí
    // fuera, como estaba antes, la consulta de `.tree-edge` salía vacía y el
    // resaltado nunca podía tocar las líneas.
    lineageState = null;
    scheduleTreeLinesDraw(getCompleteRelationships(), svgOverlay, container, {
      onDrawn: () => {
        drawInfinityCenterpiece(svgOverlay);
        setupLineageHighlight(container);
        centerTree();
      },
    });

    return true;
  }

  // Al pasar el cursor sobre un personaje del Árbol Completo, resalta su
  // linaje directo (ancestros + descendientes) y atenúa el resto.
  //
  // Reescrito por coste: la versión anterior enganchaba mouseenter/mouseleave
  // a CADA uno de los 25 nodos (50 listeners) y, en cada entrada, recorría los
  // 25 nodos llamando dos veces a classList.toggle — 50 escrituras de clase
  // por hover, la mayoría reponiendo el valor que el elemento YA tenía, y cada
  // una invalidando estilo con una transición de opacidad detrás. Ahora:
  //  · un único listener delegado en el contenedor;
  //  · el linaje de cada personaje se calcula una sola vez y se memoiza;
  //  · solo se escribe en los elementos cuyo estado cambia de verdad.
  let lineageState = null;
  // #tree-nodes-container SOBREVIVE a cada redibujado (solo se vacía su
  // contenido con innerHTML = ''), así que los listeners colgados de él NO se
  // van con sus hijos: cada visita al Árbol Completo apilaba un juego nuevo
  // sobre los anteriores, y cada juego viejo seguía reteniendo los arrays de
  // nodos y conectores ya desechados. Se guarda el juego activo para poder
  // retirarlo antes de instalar el siguiente (regla 6 de .clauderules).
  let lineageListeners = null;

  function teardownLineageHighlight(container) {
    if (!lineageListeners) return;
    container.removeEventListener('pointerover', lineageListeners.over);
    container.removeEventListener('pointerleave', lineageListeners.leave);
    container.removeEventListener('pointerup', lineageListeners.up);
    lineageListeners = null;
    lineageState = null;
    container.classList.remove('has-lineage');
  }

  function setupLineageHighlight(container) {
    teardownLineageHighlight(container);

    const relationships = getCompleteRelationships();
    const lineageCache = new Map();

    const nodes = Array.from(container.querySelectorAll('.complete-tree-node'));
    const edges = Array.from(
      container.querySelectorAll('.tree-edge, .tree-edge-knot'),
    );

    // Cada conector guarda sus extremos como ids separados por espacio (una
    // relación puede salir de una pareja, o sea de dos padres a la vez).
    const edgeEnds = edges.map((el) => [
      ...(el.dataset.from || '').split(' ').filter(Boolean),
      ...(el.dataset.to || '').split(' ').filter(Boolean),
    ]);

    function lineageFor(charId) {
      if (!lineageCache.has(charId)) {
        lineageCache.set(charId, computeLineage(charId, relationships));
      }
      return lineageCache.get(charId);
    }

    function setDim(el, dim) {
      if (el.classList.contains('is-dimmed') === dim) return;
      el.classList.toggle('is-dimmed', dim);
    }

    function applyLineage(charId) {
      if (lineageState === charId) return;
      lineageState = charId;

      if (!charId) {
        container.classList.remove('has-lineage');
        nodes.forEach((node) => {
          setDim(node, false);
          node.classList.remove('is-active');
        });
        edges.forEach((edge) => setDim(edge, false));
        return;
      }

      const lineage = lineageFor(charId);
      container.classList.add('has-lineage');
      nodes.forEach((node) => {
        setDim(node, !lineage.has(node.dataset.charId));
        node.classList.toggle('is-active', node.dataset.charId === charId);
      });
      // Un conector se enciende solo si TODOS sus extremos están en el linaje;
      // si no, una línea que apenas roza el linaje quedaría brillando hacia
      // un nodo ya atenuado.
      edges.forEach((edge, index) => {
        const ends = edgeEnds[index];
        setDim(edge, !ends.length || !ends.every((id) => lineage.has(id)));
      });
    }

    lineageListeners = {
      over: (e) => {
        const node = e.target.closest('.complete-tree-node');
        applyLineage(node ? node.dataset.charId : null);
      },
      leave: () => applyLineage(null),
      // El resaltado es puro hover, así que en pantallas táctiles no aporta
      // nada y solo deja nodos apagados tras un toque. Se limpia al soltar.
      up: (e) => {
        if (e.pointerType !== 'mouse') applyLineage(null);
      },
    };

    container.addEventListener('pointerover', lineageListeners.over);
    container.addEventListener('pointerleave', lineageListeners.leave);
    container.addEventListener('pointerup', lineageListeners.up);
  }

  // Centerpiece decorativo: símbolo de infinito entre Jonas y Martha, en el
  // centro visual del Árbol Completo — no es una relación modelada en
  // relationshipData, es un elemento fijo anclado a sus ids conocidos.
  function drawInfinityCenterpiece(svg) {
    const jonasPos = completeLayout.nodes.jonas;
    const marthaPos = completeLayout.nodes.martha;
    if (!jonasPos || !marthaPos) return;

    const midX = (jonasPos.x + marthaPos.x) / 2;
    const midY = (jonasPos.y + marthaPos.y) / 2;

    // Sin filtro de resplandor: el visor entero dejó de usar filtros SVG (ver
    // el bloque de trazos planos en drawTreeLines). Aquí el énfasis lo dan el
    // color y el grosor del trazo, y el ∞ se apoya en la clase
    // `.complete-tree-infinity`, que ya lo pinta en ámbar.
    //
    // El vínculo se dibuja en DOS TRAMOS con un hueco en el centro, en vez de
    // una sola línea de Jonas a Martha: esa línea cruzaba por encima del ∞ y
    // lo partía por la mitad. Ahora la línea llega hasta el símbolo, lo deja
    // respirar, y continúa al otro lado. El hueco se calcula sobre el vector
    // Jonas→Martha, así que sigue siendo correcto si algún día se mueven.
    const INFINITY_GAP = 34;
    const dx = marthaPos.x - jonasPos.x;
    const dy = marthaPos.y - jonasPos.y;
    const length = Math.hypot(dx, dy) || 1;
    const ux = dx / length;
    const uy = dy / length;

    // Si los nodos quedaran tan juntos que el hueco se comiera la línea
    // entera, se dibuja de un solo trazo antes que dejar tramos invertidos.
    const segments =
      length > INFINITY_GAP * 2 + 12
        ? [
            [jonasPos.x, jonasPos.y, midX - ux * INFINITY_GAP, midY - uy * INFINITY_GAP],
            [midX + ux * INFINITY_GAP, midY + uy * INFINITY_GAP, marthaPos.x, marthaPos.y],
          ]
        : [[jonasPos.x, jonasPos.y, marthaPos.x, marthaPos.y]];

    segments.forEach(([x1, y1, x2, y2]) => {
      const line = document.createElementNS(
        'http://www.w3.org/2000/svg',
        'line',
      );
      line.setAttribute('x1', x1);
      line.setAttribute('y1', y1);
      line.setAttribute('x2', x2);
      line.setAttribute('y2', y2);
      line.setAttribute('stroke-linecap', 'round');
      line.setAttribute('class', 'tree-edge tree-edge--bond');
      line.dataset.from = 'jonas';
      line.dataset.to = 'martha';
      svg.appendChild(line);
    });

    const text = document.createElementNS(
      'http://www.w3.org/2000/svg',
      'text',
    );
    text.setAttribute('x', midX);
    text.setAttribute('y', midY);
    text.setAttribute('font-size', '46');
    text.setAttribute('class', 'complete-tree-infinity');
    text.textContent = '∞';
    svg.appendChild(text);
  }

  function showTreeViewer() {
    // Forzar scrollTop a 0 antes de mostrar el overlay `fixed inset-0`: en
    // móvil, si la página venía desplazada, el overlay puede quedar mal
    // posicionado (recortado) hasta que el usuario hace scroll a mano —
    // bug conocido de position:fixed en Safari/Chrome móvil.
    window.scrollTo(0, 0);
    document.body.classList.add('hide-global-ui');
    if (btnAudio) {
      btnAudio.classList.remove('hidden');
      btnAudio.classList.add('flex');
    }

    captureFocusForViewer();
    document.getElementById('familias-main-view').classList.add('hidden');
    const treeViewer = document.getElementById('tree-viewer');
    treeViewer.classList.remove('hidden');
    treeViewer.setAttribute('aria-hidden', 'false');
    // Ver comentario en openTreeViewer(): centrar no depende de imágenes,
    // solo de que #tree-pan-area ya sea visible (lo acabamos de lograr).
    centerTree();
    setTimeout(() => {
      treeViewer.classList.remove('opacity-0');
    }, 50);

    playSectionAudio();
  }

  window.openCompleteTreeViewer = () => {
    closeSidebarIfOpen();
    drawCompleteTree();
    showTreeViewer();
  };

  function openCharacterFromTree(famId, charId) {
    currentFamilyId = famId;
    document.body.classList.add('hide-global-ui');
    document.getElementById('familias-main-view').classList.add('hidden');
    document.getElementById('tree-viewer').classList.add('hidden');
    openCinematicViewer(charId);
  }

  // SALTO DESDE SIDEBAR A PERSONAJE (Arregla el bug de la X re-dibujando silensiosamente)
  window.jumpToCharacter = (famId, charId) => {
    closeSidebarIfOpen();
    if (currentFamilyId !== famId) drawTree(famId);

    openCharacterFromTree(famId, charId);
  };

  // ============================
  // ZOOM / PAN LOGIC
  // ============================
  let treeScale = 1;
  let treePanX = 0;
  let treePanY = 0;
  let isDragging = false;
  let dragStartX = 0;
  let dragStartY = 0;
  let dragOriginPanX = 0;
  let dragOriginPanY = 0;

  const MIN_SCALE = 0.3;
  const MAX_SCALE = 2.5;
  const ZOOM_STEP = 0.15;

  // Cachea el nodo en vez de resolverlo por id en cada frame de arrastre.
  let zoomContainerEl = null;
  function getZoomContainer() {
    if (!zoomContainerEl || !zoomContainerEl.isConnected) {
      zoomContainerEl = document.getElementById('tree-zoom-container');
    }
    return zoomContainerEl;
  }

  function applyTreeTransform(smooth = false) {
    const zc = getZoomContainer();
    if (!zc) return;
    if (smooth) {
      zc.classList.add('smooth-reset');
      setTimeout(() => zc.classList.remove('smooth-reset'), 420);
    }
    // translate3d en vez de translate: promueve la capa al compositor y evita
    // que el navegador tenga que repintar el árbol en cada desplazamiento.
    zc.style.transform = `translate3d(${treePanX}px, ${treePanY}px, 0) scale(${treeScale})`;
  }

  // Durante el arrastre solo se escribe UNA vez por frame. Sin esto, un ratón
  // de 1000 Hz dispara ~8 escrituras de transform por frame de 60 Hz: siete
  // de ellas se descartan sin llegar a pintarse, pero cada una obliga al
  // navegador a recalcular estilo antes de tirarla.
  let transformRaf = null;
  function scheduleTreeTransform() {
    if (transformRaf) return;
    transformRaf = requestAnimationFrame(() => {
      transformRaf = null;
      applyTreeTransform();
    });
  }

  // `smooth` controla si el salto a la posición centrada anima el transform
  // (420ms, vía la clase `smooth-reset`) o lo aplica al instante. Los
  // centrados AUTOMÁTICOS (justo al dibujar el árbol, antes de que el
  // usuario haya visto nada) deben ser instantáneos — si animan, el fade-in
  // de opacidad del visor (que arranca en paralelo, ver showTreeViewer)
  // puede pillar la transición a medias y mostrar el árbol sin centrar
  // durante ese primer instante. La animación suave solo tiene sentido para
  // el reset manual (botón "encajar en pantalla"), donde el usuario ya está
  // viendo el árbol y el movimiento es una señal útil de que algo cambió.
  function centerTree(smooth = false) {
    const panArea = document.getElementById('tree-pan-area');
    const container = document.getElementById('tree-nodes-container');
    const zoomContainer = document.getElementById('tree-zoom-container');
    if (!panArea || !container || !zoomContainer) return;

    const areaW = panArea.offsetWidth;
    const areaH = panArea.offsetHeight;
    const contW = container.offsetWidth;
    const contH = container.offsetHeight;

    if (contW === 0 || contH === 0) return;

    // Escala para que quepa todo con margen
    const scaleX = (areaW * 0.88) / contW;
    const scaleY = (areaH * 0.82) / contH;
    treeScale = Math.min(scaleX, scaleY, 1);
    treeScale = Math.max(treeScale, MIN_SCALE);

    // Centrar: el zoom-container empieza en top:0 left:0 del pan-area
    // necesitamos que el punto de anclaje sea el centro del contenido escalado
    treePanX = (areaW - contW * treeScale) / 2;
    treePanY = (areaH - contH * treeScale) / 2;

    applyTreeTransform(smooth);
  }

  // Recentra el árbol cuando cambia el tamaño del viewport mientras el
  // visor está abierto: en móvil, la barra de direcciones de Chrome/Safari
  // se colapsa o reaparece al hacer scroll/tocar la pantalla, cambiando
  // innerHeight *después* de que centerTree() ya se ejecutó al abrir. Sin
  // este listener, el árbol queda descentrado hasta que el usuario lo
  // arrastra a mano — este era el bug reportado en móvil.
  let treeResizeRaf = null;
  window.addEventListener('resize', () => {
    const treeViewer = document.getElementById('tree-viewer');
    if (!treeViewer || treeViewer.classList.contains('hidden')) return;
    if (treeResizeRaf) cancelAnimationFrame(treeResizeRaf);
    treeResizeRaf = requestAnimationFrame(() => centerTree());
  });

  // Los botones +/− amplían respecto al CENTRO del área visible, no respecto
  // al origen del contenido: antes, pulsar "+" escalaba desde la esquina
  // superior izquierda y el árbol se escapaba de la pantalla. Se anima
  // (`smooth`) porque es un salto discreto provocado por el usuario.
  function zoomByStep(direction) {
    const rect = getPanRect();
    zoomAround(
      rect.left + rect.width / 2,
      rect.top + rect.height / 2,
      clampScale(treeScale + direction * ZOOM_STEP),
    );
    applyTreeTransform(true);
  }

  window.zoomIn = () => zoomByStep(1);
  window.zoomOut = () => zoomByStep(-1);
  window.zoomReset = () => {
    centerTree(true);
  };

  const panAreaEl = document.getElementById('tree-pan-area');

  // El rect del área solo cambia con resize/scroll, así que se cachea en vez
  // de leerlo en cada evento: getBoundingClientRect() fuerza al navegador a
  // recalcular el layout, y hacerlo desde un handler de rueda o de
  // movimiento es el patrón clásico de "layout thrashing".
  let panRect = null;
  const invalidatePanRect = () => {
    panRect = null;
  };
  window.addEventListener('resize', invalidatePanRect);
  window.addEventListener('scroll', invalidatePanRect, { passive: true });
  function getPanRect() {
    if (!panRect) panRect = panAreaEl.getBoundingClientRect();
    return panRect;
  }

  // Zoom alrededor de un punto concreto de la pantalla, manteniendo fijo el
  // punto del árbol que hay bajo él. Sirve tanto para la rueda como para el
  // pellizco táctil, así que la fórmula vive en un solo sitio.
  function zoomAround(clientX, clientY, newScale) {
    const rect = getPanRect();
    const px = clientX - rect.left;
    const py = clientY - rect.top;
    treePanX = px - (px - treePanX) * (newScale / treeScale);
    treePanY = py - (py - treePanY) * (newScale / treeScale);
    treeScale = newScale;
  }

  const clampScale = (value) =>
    Math.min(Math.max(value, MIN_SCALE), MAX_SCALE);

  // Rueda del ratón → zoom centrado en el cursor. El paso es proporcional a
  // la escala actual, de modo que acercar y alejar se sienten simétricos en
  // vez de dar saltos enormes cuando ya estás muy cerca.
  panAreaEl.addEventListener(
    'wheel',
    (e) => {
      e.preventDefault();
      const factor = Math.exp(-e.deltaY * 0.0015);
      zoomAround(e.clientX, e.clientY, clampScale(treeScale * factor));
      scheduleTreeTransform();
    },
    { passive: false },
  );

  // ===== ARRASTRE Y PELLIZCO CON PUNTEROS UNIFICADOS =====
  // Antes había dos rutas separadas (mousedown/mousemove/mouseup por un lado,
  // touchstart/touchmove/touchend por otro) que compartían las mismas
  // variables de estado y podían pisarse. Los eventos de puntero cubren
  // ratón, dedo y lápiz con un solo camino, y `setPointerCapture` garantiza
  // que el arrastre siga llegando aunque el cursor salga del área o pase por
  // encima de un nodo — antes, soltar fuera de la ventana dejaba `isDragging`
  // en true y el árbol se quedaba pegado al ratón.
  const activePointers = new Map();
  let pinchStartDist = 0;
  let pinchStartScale = 1;

  function pointerMidpoint() {
    const points = Array.from(activePointers.values());
    return {
      x: (points[0].x + points[1].x) / 2,
      y: (points[0].y + points[1].y) / 2,
    };
  }

  function pointerDistance() {
    const points = Array.from(activePointers.values());
    return Math.hypot(points[0].x - points[1].x, points[0].y - points[1].y);
  }

  panAreaEl.addEventListener('pointerdown', (e) => {
    activePointers.set(e.pointerId, { x: e.clientX, y: e.clientY });

    if (activePointers.size === 2) {
      // Empieza un pellizco: se cancela el arrastre de un dedo en curso.
      isDragging = false;
      panAreaEl.classList.remove('is-panning');
      pinchStartDist = pointerDistance();
      pinchStartScale = treeScale;
      return;
    }

    if (activePointers.size !== 1) return;
    // Un clic sobre un nodo abre el personaje; no debe iniciar un arrastre.
    if (e.target.closest('[data-tree-node]')) return;

    isDragging = true;
    dragStartX = e.clientX;
    dragStartY = e.clientY;
    dragOriginPanX = treePanX;
    dragOriginPanY = treePanY;
    panAreaEl.classList.add('is-panning');
    panAreaEl.setPointerCapture(e.pointerId);
    e.preventDefault();
  });

  panAreaEl.addEventListener('pointermove', (e) => {
    if (!activePointers.has(e.pointerId)) return;
    activePointers.set(e.pointerId, { x: e.clientX, y: e.clientY });

    if (activePointers.size === 2 && pinchStartDist > 0) {
      const mid = pointerMidpoint();
      zoomAround(
        mid.x,
        mid.y,
        clampScale((pointerDistance() / pinchStartDist) * pinchStartScale),
      );
      scheduleTreeTransform();
      return;
    }

    if (!isDragging) return;
    treePanX = dragOriginPanX + (e.clientX - dragStartX);
    treePanY = dragOriginPanY + (e.clientY - dragStartY);
    scheduleTreeTransform();
  });

  function endPointer(e) {
    activePointers.delete(e.pointerId);
    if (activePointers.size < 2) pinchStartDist = 0;
    if (activePointers.size === 0) {
      isDragging = false;
      panAreaEl.classList.remove('is-panning');
    }
    if (panAreaEl.hasPointerCapture?.(e.pointerId)) {
      panAreaEl.releasePointerCapture(e.pointerId);
    }
  }

  panAreaEl.addEventListener('pointerup', endPointer);
  panAreaEl.addEventListener('pointercancel', endPointer);

  // Guarda de generación para las transiciones abrir/cerrar árbol: si el
  // usuario cierra y reabre (la misma familia u otra) antes de que termine
  // la animación de cierre, el setTimeout retrasado de closeTreeViewer no
  // debe volver a ocultar un árbol que ya se reabrió después — y viceversa,
  // un setTimeout retrasado de un openTreeViewer anterior no debe pisar un
  // cierre posterior. Cada llamada reclama un token propio; solo el más
  // reciente puede ejecutar sus callbacks diferidos.
  let treeViewerToken = 0;

  window.openTreeViewer = (familiaId) => {
    const isDrawn = drawTree(familiaId);
    if (!isDrawn) {
      alert('Archivos bloqueados por Sic Mundus...');
      return;
    }

    const viewerToken = ++treeViewerToken;

    // Ver comentario en showTreeViewer(): evita el overlay fixed mal
    // posicionado en móvil si la página venía desplazada.
    window.scrollTo(0, 0);
    document.body.classList.add('hide-global-ui');
    if (btnAudio) {
      btnAudio.classList.remove('hidden');
      btnAudio.classList.add('flex');
    }

    captureFocusForViewer();
    document.getElementById('familias-main-view').classList.add('hidden');
    const treeViewer = document.getElementById('tree-viewer');
    treeViewer.classList.remove('hidden');
    treeViewer.setAttribute('aria-hidden', 'false');
    // centerTree() solo necesita las dimensiones de #tree-pan-area (ya
    // visible, acabamos de quitar 'hidden' — leer offsetWidth aquí fuerza
    // un reflow síncrono que ya ve el cambio) y las de #tree-nodes-container
    // (fijadas por JS en drawTree(), antes de crear ninguna imagen). No
    // depende en absoluto de que las imágenes carguen, así que podemos
    // centrar ya mismo, sin esperar nada — evita el hueco en el que el
    // árbol se veía vacío/descentrado hasta interactuar con él.
    centerTree();
    setTimeout(() => {
      if (viewerToken !== treeViewerToken) return;
      treeViewer.classList.remove('opacity-0');
    }, 50);

    playSectionAudio();
  };

  window.closeTreeViewer = () => {
    const viewerToken = ++treeViewerToken;

    const treeViewer = document.getElementById('tree-viewer');
    treeViewer.classList.add('opacity-0');
    treeViewer.setAttribute('aria-hidden', 'true');

    setTimeout(() => {
      if (viewerToken !== treeViewerToken) return;
      treeViewer.classList.add('hidden');
      document.getElementById('familias-main-view').classList.remove('hidden');
      document.body.classList.remove('hide-global-ui');
      if (btnAudio) {
        btnAudio.classList.remove('flex');
        btnAudio.classList.add('hidden');
      }
      restoreFocusAfterViewer();
    }, 700);

    resumeAudioOnFocus = false;
    pauseSectionAudio();
  };

  // ============================
  // CONMUTADOR DE LINAJE, FOCO Y TECLADO
  // ============================

  // Marca en el conmutador qué árbol se está viendo. Se llama desde
  // drawTree()/drawCompleteTree(), que son los dos únicos sitios donde cambia.
  function syncFamilySwitch(activeId) {
    document.querySelectorAll('[data-tree-family]').forEach((chip) => {
      chip.setAttribute(
        'aria-selected',
        chip.dataset.treeFamily === activeId ? 'true' : 'false',
      );
    });
  }

  document.querySelectorAll('[data-tree-family]').forEach((chip) => {
    chip.addEventListener('click', () => {
      const id = chip.dataset.treeFamily;
      if (id === '__complete') {
        drawCompleteTree();
      } else {
        drawTree(id);
      }
    });
  });

  // Foco: el visor es un overlay a pantalla completa, así que al abrirlo el
  // foco debe entrar en él y al cerrarlo volver al control que lo abrió
  // (regla 5 de .clauderules — ya se cumplía en el menú móvil, faltaba aquí).
  let focusBeforeViewer = null;

  function captureFocusForViewer() {
    focusBeforeViewer =
      document.activeElement instanceof HTMLElement
        ? document.activeElement
        : null;
    const closeBtn = document.getElementById('tree-close-btn');
    if (closeBtn) setTimeout(() => closeBtn.focus({ preventScroll: true }), 60);
  }

  function restoreFocusAfterViewer() {
    if (focusBeforeViewer && focusBeforeViewer.isConnected) {
      focusBeforeViewer.focus({ preventScroll: true });
    }
    focusBeforeViewer = null;
  }

  function isTreeViewerOpen() {
    const treeViewer = document.getElementById('tree-viewer');
    return treeViewer && !treeViewer.classList.contains('hidden');
  }

  document.addEventListener('keydown', (e) => {
    if (!isTreeViewerOpen()) return;

    if (e.key === 'Escape') {
      e.preventDefault();
      if (isSidebarOpen()) {
        closeSidebarIfOpen();
      } else {
        window.closeTreeViewer();
      }
      return;
    }

    // Con la barra lateral abierta el foco está en su lista de personajes;
    // secuestrar las flechas ahí impediría recorrerla.
    if (isSidebarOpen()) return;

    // Teclado como alternativa real al arrastre: no todo el mundo puede
    // sostener un botón del ratón mientras mueve el puntero.
    const PAN_STEP = e.shiftKey ? 160 : 60;
    switch (e.key) {
      case 'ArrowLeft':
        treePanX += PAN_STEP;
        break;
      case 'ArrowRight':
        treePanX -= PAN_STEP;
        break;
      case 'ArrowUp':
        treePanY += PAN_STEP;
        break;
      case 'ArrowDown':
        treePanY -= PAN_STEP;
        break;
      case '+':
      case '=':
        zoomByStep(1);
        return;
      case '-':
      case '_':
        zoomByStep(-1);
        return;
      case '0':
        centerTree(true);
        return;
      default:
        return;
    }
    e.preventDefault();
    applyTreeTransform(true);
  });

  // ABRIR VISOR CINEMÁTICO (Snap exacto 100vh)
  function characterNameById(characterId) {
    return findCharacterFamily(characterId)?.character?.name || characterId;
  }

  function buildCharacterInsight(familia, char, stage, index) {
    const directRelationships = getCompleteRelationships()
      .filter(
        (relationship) =>
          relationship.from === char.id || relationship.to === char.id,
      )
      .slice(0, 5)
      .map((relationship) => {
        const otherId =
          relationship.from === char.id ? relationship.to : relationship.from;
        const label =
          relationship.type === 'couple'
            ? 'vinculo'
            : relationship.from === char.id
              ? 'descendencia'
              : 'origen';
        return `${label}: ${characterNameById(otherId)}`;
      });

    const connectionText = directRelationships.length
      ? directRelationships.join(' / ')
      : `Pertenece al linaje ${familia.name}.`;
    const arcText =
      char.stages.length > 1
        ? `Su arco se reparte en ${char.stages.length} momentos: esta escena no funciona solo como fecha, sino como una pista dentro de su transformacion.`
        : 'Su presencia funciona como una pieza aislada pero decisiva dentro del mapa de Winden.';

    return `
      <div class="cinematic-insight mt-8 grid gap-3 text-stone-400 font-mono text-[10px] md:text-xs tracking-[0.18em] uppercase">
        <div class="border-l border-amber-500/35 pl-4">
          <span class="text-amber-500/80">Rol</span>
          <p class="mt-2 normal-case tracking-wide text-stone-300 font-light leading-relaxed">
            ${familia.subtitle}. ${arcText}
          </p>
        </div>
        <div class="border-l border-white/10 pl-4">
          <span class="text-stone-500">Conexiones</span>
          <p class="mt-2 normal-case tracking-wide text-stone-400 font-light leading-relaxed">
            ${connectionText}
          </p>
        </div>
      </div>
    `;
  }

  function getSceneImage(familia, char, stage, index) {
    const previousStageImages = char.stages
      .slice(0, index)
      .map((candidate) => candidate.img);
    if (stage.img && !previousStageImages.includes(stage.img)) return stage.img;

    const pool = sceneImagePools[familia.id] || [familia.cover, char.avatar];
    return pool[(index + char.id.length) % pool.length] || stage.img || char.avatar;
  }

  function renderNextPanelCue(char, index) {
    const nextStage = char.stages[index + 1];
    if (!nextStage) return '';

    const label =
      index === 0
        ? 'Scroll para explorar'
        : `Siguiente: ${nextStage.title}`;

    return `
      <div class="next-panel-cue mt-36 md:mt-52 flex flex-col items-center gap-3 text-stone-200 pointer-events-none">
        <div class="font-mono text-xs md:text-sm tracking-[0.28em] uppercase text-center">
          ${label}
        </div>
        <div class="next-panel-cue-line"></div>
        <div class="next-panel-cue-dot"></div>
      </div>
    `;
  }

  // Anima el feDisplacementMap del filtro #cinematic-ripple para dar un
  // efecto de "agua/papel" breve cada vez que cambia la imagen de fondo.
  // Filtro SVG muy costoso de recalcular en cada frame — reservado a
  // dispositivos con puntero fino (desktop); en móvil/táctil se omite para
  // evitar el lag reportado al cambiar de escena dentro del detalle de un
  // personaje (ver también setupCinematicBackground, que ya reserva el
  // tilt de ratón del mismo modo).
  function playRippleEffect() {
    if (cinematicReducedMotion || !hasFinePointer()) return;
    const displacement = document.getElementById('cinematic-ripple-displace');
    if (!displacement) return;

    const duration = 1300;
    const peakScale = 40;
    const start = performance.now();

    function step(now) {
      const t = Math.min((now - start) / duration, 1);
      const intensity =
        t < 0.3 ? t / 0.3 : Math.max(0, 1 - (t - 0.3) / 0.7);
      displacement.setAttribute('scale', (intensity * peakScale).toFixed(1));
      if (t < 1) requestAnimationFrame(step);
    }

    requestAnimationFrame(step);
  }

  // Revela la imagen de la nueva etapa como si fuera agua "subiendo": al
  // hacer scroll hacia abajo, la imagen emerge de abajo hacia arriba; al
  // hacer scroll hacia arriba, emerge de arriba hacia abajo. Se combina con
  // playRippleEffect() (la distorsión) para el efecto conjunto.
  // Revela la imagen con un borde ondulado (no una línea recta): varios
  // puntos a lo largo del ancho oscilan con una onda senoidal cuya fase
  // avanza en el tiempo (efecto "viento"), mientras la línea base sube o
  // baja según la dirección del scroll (efecto "agua"). El oleaje se calma
  // a medida que la revelación se completa.
  function playDirectionalReveal(direction) {
    const bgImage = document.getElementById('cinematic-bg');
    if (!bgImage) return;
    // clip-path animado por frame (21 puntos) es caro de repintar en
    // móvil — igual que playRippleEffect(), se reserva a puntero fino.
    if (cinematicReducedMotion || !hasFinePointer()) {
      bgImage.style.clipPath = '';
      return;
    }

    const duration = 1300;
    const start = performance.now();
    const SAMPLES = 20;
    const AMPLITUDE_1 = 7; // % de altura de la ondulación principal (agua)
    const AMPLITUDE_2 = 3.2; // % de una segunda ondulación más rápida (viento)
    const WAVE_COUNT_1 = 2.3; // nº de crestas a lo largo del ancho
    const WAVE_COUNT_2 = 5.1; // crestas de la ondulación secundaria

    function waterline(eased, xFrac, phase) {
      const base = direction === 'up' ? eased * 100 : (1 - eased) * 100;
      // El oleaje se mantiene vivo casi hasta el final y solo se calma
      // en el último tramo, para que no se perciba como un barrido lineal.
      const calm = eased < 0.82 ? 1 : Math.max(0, 1 - (eased - 0.82) / 0.18);
      const wave1 =
        Math.sin(xFrac * Math.PI * 2 * WAVE_COUNT_1 + phase) * AMPLITUDE_1;
      const wave2 =
        Math.sin(xFrac * Math.PI * 2 * WAVE_COUNT_2 - phase * 1.7 + 1.3) *
        AMPLITUDE_2;
      return Math.min(100, Math.max(0, base + (wave1 + wave2) * calm));
    }

    function frameAt(elapsed) {
      const t = Math.min(elapsed / duration, 1);
      const eased = 1 - Math.pow(1 - t, 3); // easeOutCubic
      const phase = elapsed / 110; // fase del oleaje avanzando con el tiempo

      const pts = [];
      for (let i = 0; i <= SAMPLES; i++) {
        const xFrac = i / SAMPLES;
        const y = waterline(eased, xFrac, phase);
        pts.push(`${(xFrac * 100).toFixed(2)}% ${y.toFixed(2)}%`);
      }

      return {
        t,
        clipPath:
          direction === 'up'
            ? // Visible: franja superior (0% → línea ondulada), crece hacia abajo
              `polygon(0% 0%, 100% 0%, ${pts.slice().reverse().join(', ')})`
            : // Visible: franja inferior (línea ondulada → 100%), crece hacia arriba
              `polygon(${pts.join(', ')}, 100% 100%, 0% 100%)`,
      };
    }

    // Fija el primer frame de inmediato (síncrono) para que la imagen nunca
    // se muestre completa sin recortar durante el hueco antes del primer rAF.
    bgImage.style.clipPath = frameAt(0).clipPath;

    function step(now) {
      const elapsed = now - start;
      const { t, clipPath } = frameAt(elapsed);
      bgImage.style.clipPath = clipPath;
      if (t < 1) requestAnimationFrame(step);
      else bgImage.style.clipPath = '';
    }

    requestAnimationFrame(step);
  }

  function setupCinematicBackground(root) {
    const bgImage = document.getElementById('cinematic-bg');
    if (!bgImage) return;

    cinematicReducedMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)',
    ).matches;

    // En puntero táctil/basto se cae al filtro CSS liviano (sin el filtro
    // SVG de ondulación, muy caro de mantener en el compositor durante el
    // scroll) — se reevalúa en cada apertura de personaje, no solo la
    // primera vez, por si el tipo de puntero cambia entre sesiones.
    bgImage.classList.toggle('temporal-bg-lite', !hasFinePointer());

    if (bgImage.dataset.temporalBound) return;
    bgImage.dataset.temporalBound = '1';

    // Tilt/drift reactivo al ratón: solo en dispositivos con puntero fino
    // (desktop/trackpad) y solo si el visitante no pidió movimiento reducido.
    if (!hasFinePointer() || cinematicReducedMotion) return;

    root.addEventListener('pointermove', (event) => {
      const x = event.clientX / window.innerWidth;
      const y = event.clientY / window.innerHeight;
      bgImage.style.setProperty('--tilt-x', `${(x - 0.5) * 4}deg`);
      bgImage.style.setProperty('--tilt-y', `${(0.5 - y) * 4}deg`);
      bgImage.style.setProperty('--drift-x', `${(x - 0.5) * -18}px`);
      bgImage.style.setProperty('--drift-y', `${(y - 0.5) * -18}px`);
      bgImage.style.setProperty('--scan-y', `${y * 100}%`);
    });

    root.addEventListener('pointerleave', () => {
      bgImage.style.setProperty('--tilt-x', '0deg');
      bgImage.style.setProperty('--tilt-y', '0deg');
      bgImage.style.setProperty('--drift-x', '0px');
      bgImage.style.setProperty('--drift-y', '0px');
      bgImage.style.setProperty('--scan-y', '52%');
    });
  }

  window.openCinematicViewer = (charId) => {
    const familia = familiasData.find((f) => f.id === currentFamilyId);
    if (!familia) return;

    const flatChars = familia.generations.flat();
    const char = flatChars.find((c) => c.id === charId);
    if (!char) return;

    // Ver comentario en showTreeViewer(): evita el overlay fixed mal
    // posicionado en móvil si la página venía desplazada.
    window.scrollTo(0, 0);

    const contentArea = document.getElementById('cinematic-content');
    contentArea.innerHTML = '';

    if (observer) observer.disconnect();

    char.stages.forEach((stage, index) => {
      const isFirst = index === 0;
      const sceneImage = getSceneImage(familia, char, stage, index);

      const timelineHTML = `
        <div class="flex flex-col items-center text-center gap-4 mb-8">
          <h2 class="font-cinzel text-2xl md:text-4xl text-stone-200 uppercase tracking-widest font-bold">
            ${stage.title}
          </h2>
          <div class="flex items-center gap-1">
            <div class="w-1.5 h-1.5 rounded-full bg-amber-600 timeline-dot"></div>
            <div class="h-px bg-amber-600/50 timeline-line"></div>
            <div class="w-1.5 h-1.5 rounded-full bg-amber-600 timeline-dot"></div>
          </div>
          <span class="font-mono text-[10px] md:text-xs tracking-widest text-stone-400">
            ${stage.timeline}
          </span>
        </div>
      `;

      // La primera escena añade el bloque de "insight" (ROL/CONEXIONES) vía
      // buildCharacterInsight(), lo que la hace más alta que el resto. En
      // móvil (viewport bajo) esa altura extra ya no cabe en 100vh: con
      // `items-center` el panel se centra igualmente y su mitad superior
      // queda por detrás de los botones fijos de menú/cerrar (bug reportado
      // como "detalle bugeado" en móvil). Por eso esta escena se alinea
      // arriba con hueco para esos botones y permite scroll interno; el
      // resto de escenas (más cortas) mantienen el centrado vertical de
      // siempre.
      const sceneAlignClass = isFirst
        ? 'items-start md:items-center overflow-y-auto md:overflow-visible pt-24 pb-8 px-8 md:pt-8 md:pb-8 md:pl-20 md:pr-16'
        : 'items-center p-8 md:pl-20 md:pr-16';

      contentArea.innerHTML += `
        <div class="scroll-scene w-full h-[100vh] flex ${sceneAlignClass} snap-center pointer-events-auto" data-image="${sceneImage}">
          <div class="cinematic-panel max-w-2xl relative w-full md:w-[60%] lg:w-[48%]">
            
            ${
              isFirst
                ? `
              <p class="text-stone-500 font-mono text-[10px] md:text-xs tracking-[0.3em] uppercase mb-12 border-l-2 border-stone-500 pl-3">
                Archivo / ${familia.name}
              </p>
            `
                : ''
            }
            
            ${timelineHTML}
            
            <p class="text-stone-300 font-light text-base md:text-xl leading-relaxed drop-shadow-lg mt-6 text-reveal border-l border-white/10 pl-6">
              ${stage.text}
            </p>

            ${isFirst ? buildCharacterInsight(familia, char, stage, index) : ''}

            ${renderNextPanelCue(char, index)}
          </div>
        </div>
      `;
    });

    // PANTALLA "FIN DEL CICLO"
    contentArea.innerHTML += `
      <div class="scroll-scene w-full h-[100vh] flex items-center justify-center snap-center pointer-events-auto" data-image="none">
        <div class="text-center relative z-10 flex flex-col items-center">
          <svg class="w-24 h-24 text-amber-500 mb-8 opacity-40" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="1">
            <circle cx="50" cy="35" r="25" class="triqueta-animada" />
            <circle cx="35" cy="65" r="25" class="triqueta-animada" />
            <circle cx="65" cy="65" r="25" class="triqueta-animada" />
          </svg>
          <div class="w-12 h-px bg-amber-500 mb-6 mx-auto"></div>
          <h2 class="font-cinzel text-3xl md:text-5xl text-stone-500 uppercase tracking-[0.3em] font-light mb-12">
            Fin del ciclo
          </h2>
          <button onclick="closeCinematicViewer()" class="px-8 py-3 border border-stone-600 hover:border-amber-500 text-stone-400 hover:text-amber-500 rounded font-cinzel tracking-widest text-sm uppercase transition-all shadow-xl bg-black/50 backdrop-blur-sm group">
            <span class="group-hover:tracking-[0.2em] transition-all">Volver al Árbol</span>
          </button>
        </div>
      </div>
    `;

    const bgImage = document.getElementById('cinematic-bg');
    const firstImage = getSceneImage(familia, char, char.stages[0], 0);
    bgImage.src = firstImage;
    bgImage.dataset.current = firstImage;
    bgImage.style.opacity = '1';

    const cineViewer = document.getElementById('cinematic-viewer');
    cineViewer.classList.remove('hidden');
    cineViewer.scrollTo(0, 0);
    setTimeout(() => cineViewer.classList.remove('opacity-0'), 50);

    // Resetea el estado de scroll ANTES de re-enlazar el observer: si no,
    // el primer scroll dentro del personaje nuevo se compara contra el
    // scrollTop que dejó el personaje anterior y la dirección sale mal.
    cinematicLastScrollTop = 0;
    cinematicScrollDirection = 'down';
    cinematicBgToken++;
    initCinematicScroll();
    playRippleEffect();
    playDirectionalReveal(cinematicScrollDirection);
  };

  window.closeCinematicViewer = () => {
    // Desconectar el observer y anular cualquier cambio de imagen pendiente
    // de inmediato (no esperar a los 700ms de la animación de salida): si no,
    // un setTimeout de cambio de imagen todavía en vuelo puede aplicarse
    // sobre el fondo después de cerrar, y la próxima vez que se abra un
    // personaje puede arrancar con una imagen que no le corresponde.
    if (observer) observer.disconnect();
    cinematicBgToken++;

    const cineViewer = document.getElementById('cinematic-viewer');
    cineViewer.classList.add('opacity-0');
    setTimeout(() => {
      cineViewer.classList.add('hidden');

      const treeViewer = document.getElementById('tree-viewer');
      treeViewer.classList.remove('hidden');
      setTimeout(() => treeViewer.classList.remove('opacity-0'), 50);
    }, 700);
  };

  // ============================
  // TYPEWRITER EN MAGIC-HIGHLIGHTS — BIDIRECCIONAL
  // ============================

  // Web Audio API — dos sonidos: escribir (agudo) y rebobinar (grave)
  let audioCtx = null;
  function getAudioCtx() {
    if (!audioCtx)
      audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    return audioCtx;
  }

  function playTypeClick(reverse = false) {
    try {
      const ctx = getAudioCtx();
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.connect(gain);
      gain.connect(ctx.destination);

      if (reverse) {
        // Rebobinar: más grave, más breve, ligero pitch-down
        osc.type = 'sawtooth';
        osc.frequency.setValueAtTime(320 + Math.random() * 80, ctx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(180, ctx.currentTime + 0.03);
        gain.gain.setValueAtTime(0.018, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.035);
        osc.start(ctx.currentTime);
        osc.stop(ctx.currentTime + 0.035);
      } else {
        // Escribir: agudo, metálico, tipo máquina de escribir
        osc.type = 'square';
        osc.frequency.setValueAtTime(
          900 + Math.random() * 200,
          ctx.currentTime,
        );
        gain.gain.setValueAtTime(0.022, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.04);
        osc.start(ctx.currentTime);
        osc.stop(ctx.currentTime + 0.04);
      }
    } catch (e) {}
  }

  // Mapa de intervalos activos por elemento (para cancelar si se sale antes de terminar)
  const twIntervals = new WeakMap();

  function stopTypewriter(el) {
    const running = twIntervals.get(el);
    if (running) {
      clearInterval(running);
      twIntervals.delete(el);
    }
    el.classList.remove('tw-cursor', 'tw-cursor-rev');
  }

  function typewriterHighlight(el, reverse = false) {
    // Cancelar cualquier animación previa
    stopTypewriter(el);

    const fullText = el.dataset.twFull || el.textContent;
    // Guardar el texto completo la primera vez
    if (!el.dataset.twFull) el.dataset.twFull = fullText;

    const totalChars = fullText.length;
    const delay = reverse ? 22 : 38; // rebobinar más rápido

    if (reverse) {
      // Empezar desde el texto actual hacia atrás
      let currentLen = el.textContent.length || totalChars;
      el.classList.add('tw-cursor-rev');

      const interval = setInterval(() => {
        currentLen--;
        el.textContent = fullText.slice(0, Math.max(0, currentLen));
        if (currentLen % 2 === 0) playTypeClick(true);
        if (currentLen <= 0) {
          clearInterval(interval);
          twIntervals.delete(el);
          el.classList.remove('tw-cursor-rev');
        }
      }, delay);
      twIntervals.set(el, interval);
    } else {
      // Escribir de 0 al total
      let i = el.textContent.length; // continuar desde donde está si ya tenía algo
      el.textContent = fullText.slice(0, i);
      el.classList.add('tw-cursor');

      const interval = setInterval(() => {
        el.textContent = fullText.slice(0, i + 1);
        if (i % 2 === 0) playTypeClick(false);
        i++;
        if (i >= totalChars) {
          clearInterval(interval);
          twIntervals.delete(el);
          el.classList.remove('tw-cursor');
        }
      }, delay);
      twIntervals.set(el, interval);
    }
  }

  // OBSERVER DEL SCROLL (bidireccional con typewriter)
  function initCinematicScroll() {
    const scenes = document.querySelectorAll('.scroll-scene');
    const bgImage = document.getElementById('cinematic-bg');
    const cineViewer = document.getElementById('cinematic-viewer');
    setupCinematicBackground(cineViewer);

    // Parallax de scroll: el fondo se desplaza a distinto ritmo que el texto
    // dentro de cada escena. Se une al mismo transform que el tilt de ratón
    // vía --scroll-y (ver CSS #cinematic-bg.temporal-bg).
    if (!cineViewer.dataset.scrollParallaxBound) {
      cineViewer.dataset.scrollParallaxBound = '1';
      let scrollRafId = null;
      cineViewer.addEventListener(
        'scroll',
        () => {
          // Dirección de scroll: siempre se registra (aunque haya movimiento
          // reducido) para que playDirectionalReveal() sepa hacia dónde
          // "emerger" la siguiente imagen.
          cinematicScrollDirection =
            cineViewer.scrollTop >= cinematicLastScrollTop ? 'down' : 'up';
          cinematicLastScrollTop = cineViewer.scrollTop;

          if (cinematicReducedMotion || scrollRafId) return;
          scrollRafId = requestAnimationFrame(() => {
            scrollRafId = null;
            const sceneHeight = cineViewer.clientHeight || window.innerHeight;
            const offsetWithinScene = cineViewer.scrollTop % sceneHeight;
            const progress = offsetWithinScene / sceneHeight; // 0..1
            const parallaxPx = (progress - 0.5) * 24; // rango sutil: -12px a 12px
            bgImage.style.setProperty('--scroll-y', `${parallaxPx}px`);
          });
        },
        { passive: true },
      );
    }

    observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('in-view');

            // Typewriter HACIA ADELANTE al entrar en pantalla
            const highlights =
              entry.target.querySelectorAll('.magic-highlight');
            highlights.forEach((hl, idx) => {
              setTimeout(
                () => typewriterHighlight(hl, false),
                1400 + idx * 220,
              );
            });

            const newImgSrc = entry.target.getAttribute('data-image');

            // CUALQUIER escena que entra invalida un cambio de fondo que
            // siguiera pendiente. Antes solo lo hacía la rama del cambio
            // real: si volvías a la escena anterior dentro de la ventana de
            // 600ms, esa escena entraba por la rama "misma imagen" (porque
            // dataset.current aún no se había actualizado), no cancelaba
            // nada, y el cambio en vuelo acababa pintando la imagen de una
            // escena que ya habías abandonado.
            const bgToken = ++cinematicBgToken;

            if (newImgSrc === 'none') {
              bgImage.style.opacity = '0';
              bgImage.dataset.current = 'none';
            } else if (newImgSrc && bgImage.dataset.current !== newImgSrc) {
              bgImage.style.opacity = '0';
              const revealDirection = cinematicScrollDirection;
              // Se marca el destino YA, no dentro del temporizador, para que
              // las escenas que entren después comparen contra la imagen a la
              // que vamos y no contra la que estamos dejando atrás.
              bgImage.dataset.current = newImgSrc;

              // Se espera A LA VEZ al fundido de salida y a que la imagen
              // esté decodificada. Asignar `src` sin haber decodificado hace
              // que el <img> siga mostrando la anterior durante unos frames
              // ya con opacity:1 — el efecto de "imagen pillada" / imagen que
              // no corresponde a la escena.
              const preload = new Image();
              preload.src = newImgSrc;
              const decoded = preload.decode
                ? preload.decode().catch(() => {})
                : Promise.resolve();
              const faded = new Promise((resolve) => setTimeout(resolve, 600));

              Promise.all([decoded, faded]).then(() => {
                if (bgToken !== cinematicBgToken) return;
                bgImage.src = newImgSrc;
                bgImage.style.opacity = '1';
                playRippleEffect();
                playDirectionalReveal(revealDirection);
              });
            } else if (newImgSrc) {
              bgImage.style.opacity = '1';
            }
          } else {
            entry.target.classList.remove('in-view');

            // Typewriter REBOBINAR al salir de pantalla
            const highlights =
              entry.target.querySelectorAll('.magic-highlight');
            highlights.forEach((hl) => {
              // Solo rebobinar si ya tiene texto escrito
              if (hl.textContent.length > 0) {
                typewriterHighlight(hl, true);
              }
            });
          }
        });
      },
      {
        root: cineViewer,
        threshold: 0.55,
      },
    );

    scenes.forEach((sec) => observer.observe(sec));
  }
</script>
