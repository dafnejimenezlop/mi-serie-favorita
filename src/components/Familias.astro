---

<audio id="dark-ambient-audio" loop src="/audio/dark-theme.mp3"></audio>

<button
  id="btn-audio-toggle"
  class="fixed bottom-8 left-8 z-[350] text-stone-400 hover:text-white transition-all hidden flex-col items-center group"
>
  <div
    class="flex items-end h-4 gap-[2px] mb-1 overflow-hidden"
    id="audio-bars"
  >
    <div class="w-1 bg-current h-2 animate-audio-bar-1"></div>
    <div class="w-1 bg-current h-4 animate-audio-bar-2"></div>
    <div class="w-1 bg-current h-3 animate-audio-bar-3"></div>
  </div>
  <svg
    id="audio-muted-icon"
    class="w-5 h-5 hidden"
    fill="none"
    stroke="currentColor"
    viewBox="0 0 24 24"
    ><path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"
    ></path><path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d="M17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2"></path></svg
  >
</button>

<div
  id="netflix-sidebar"
  class="fixed inset-y-0 left-0 w-80 bg-[#0a0a0a] border-r border-stone-800 z-[400] transform -translate-x-full transition-transform duration-500 overflow-y-auto custom-scrollbar flex flex-col shadow-[20px_0_50px_rgba(0,0,0,0.8)]"
>
  <div
    class="p-6 border-b border-stone-800 flex justify-between items-center sticky top-0 bg-[#0a0a0a]/95 backdrop-blur-md z-10"
  >
    <h2
      class="font-cinzel text-xl text-amber-500 tracking-[0.2em] uppercase font-bold"
    >
      Quién
    </h2>
    <button
      onclick="toggleSidebar()"
      class="text-stone-400 hover:text-white transition-colors"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"
        ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M6 18L18 6M6 6l12 12"></path></svg
      >
    </button>
  </div>

  <div class="p-4 border-b border-stone-800/50">
    <button
      onclick="goToFamiliasOverview()"
      class="w-full py-3 bg-stone-900 border border-stone-700 hover:border-amber-500 text-stone-300 hover:text-amber-500 rounded font-cinzel tracking-widest text-sm uppercase transition-all flex items-center justify-center gap-2"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"
        ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg
      >
      Ver Familias
    </button>
  </div>

  <div id="sidebar-content" class="p-6 flex flex-col gap-8"></div>
</div>

<div
  id="sidebar-overlay"
  onclick="toggleSidebar()"
  class="fixed inset-0 bg-black/60 z-[350] hidden opacity-0 transition-opacity duration-500 backdrop-blur-sm"
>
</div>

<div
  id="familias-main-view"
  class="pt-40 md:pt-48 pb-24 relative z-10 w-full min-h-screen flex flex-col transition-opacity duration-700 block"
>
  <div class="container mx-auto px-4 md:px-6 max-w-7xl flex-grow flex flex-col">
    <div class="text-center space-y-4 mb-20" data-aos="fade-down">
      <h2
        class="text-4xl md:text-6xl font-cinzel text-amber-600 dark:text-amber-500 font-bold tracking-[0.2em] uppercase drop-shadow-lg"
      >
        Los Linajes
      </h2>
      <p
        class="text-stone-500 dark:text-stone-400 font-light tracking-widest uppercase text-xs md:text-sm"
      >
        Selecciona una familia para explorar su árbol genealógico
      </p>
    </div>

    <div
      class="flex-grow w-full flex flex-col lg:flex-row gap-2 md:gap-4 h-[65vh] lg:h-[70vh] group/container"
    >
      {
        familiasData.map((familia) => (
          <div
            class="family-card relative overflow-hidden rounded-xl cursor-pointer bg-stone-900 border border-stone-800 shadow-2xl flex-1 group"
            onclick={`openTreeViewer('${familia.id}')`}
          >
            <img
              src={familia.cover}
              class="absolute inset-0 w-full h-full object-cover opacity-40 group-hover:opacity-100 transition-opacity duration-700 mix-blend-luminosity grayscale group-hover:grayscale-0"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black via-black/50 to-transparent" />
            <div class="absolute bottom-6 left-6 right-6 lg:left-auto lg:right-auto lg:w-full lg:top-1/2 lg:-translate-y-1/2 lg:text-center lg:rotate-[-90deg] transition-all duration-700 origin-center group-hover:rotate-0 group-hover:bottom-12 group-hover:top-auto group-hover:translate-y-0">
              <h3 class="font-cinzel text-2xl lg:text-4xl font-bold text-white tracking-[0.2em] uppercase drop-shadow-[0_0_10px_rgba(0,0,0,0.8)] whitespace-nowrap">
                {familia.name}
              </h3>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</div>

<div
  id="tree-viewer"
  class="fixed inset-0 z-[150] bg-[#030303] hidden opacity-0 transition-opacity duration-1000 overflow-hidden flex flex-col"
>
  <div
    class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-stone-900/20 via-black to-black opacity-60"
  >
  </div>
  <div
    id="mouse-glow"
    class="pointer-events-none fixed inset-0 opacity-80 transition-all duration-100 ease-out mix-blend-screen"
    style="background: radial-gradient(circle 400px at 50% 50%, rgba(245, 158, 11, 0.15), transparent 80%);"
  >
  </div>

  <button
    onclick="toggleSidebar()"
    class="fixed top-8 left-8 z-[160] text-stone-400 hover:text-white transition-all group"
  >
    <div
      class="w-12 h-12 rounded-full border border-stone-600 group-hover:border-white flex items-center justify-center bg-black/50 backdrop-blur-sm shadow-xl"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"
        ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16"></path></svg
      >
