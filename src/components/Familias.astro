<script is:inline define:vars={{ familiasData, relationshipData, relationshipValidation }}>
  let currentFamilyId = '';
  let currentTreeMode = 'family';
  let observer = null;
  // Se incrementa en cada drawTree()/drawCompleteTree(). El callback
  // asíncrono de scheduleTreeLinesDraw comprueba que su token siga siendo
  // el más reciente antes de tocar el DOM — si el usuario cambia de árbol
  // (o de familia) mientras las imágenes del árbol anterior aún estaban
  // decodificando, ese dibujo obsoleto no debe pisar al árbol actual.
  let treeDrawToken = 0;
  // Calculado una vez por vista cinemática — usado por el tilt de ratón,
  // el parallax de scroll y el efecto ripple para respetar la preferencia
  // de movimiento reducido del visitante.
  let cinematicReducedMotion = false;
  const hasFinePointer = () =>
    window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  // Última dirección de scroll detectada en la vista cinemática — 'down' o
  // 'up' — usada para decidir hacia dónde "emerge" la imagen de la siguiente
  // etapa (efecto agua).
  let cinematicScrollDirection = 'down';
  // scrollTop registrado en el último evento de scroll dentro del visor
  // cinemático. Vive fuera del listener (que solo se une una vez) para que
  // pueda resetearse cada vez que se abre un personaje distinto — si no,
  // el primer scroll tras cambiar de personaje comparaba contra el scrollTop
  // del personaje anterior y calculaba una dirección incorrecta.
  let cinematicLastScrollTop = 0;
  // Se incrementa cada vez que se pide un cambio de imagen de fondo en la
  // vista cinemática. El setTimeout que aplica el cambio comprueba que su
  // token siga siendo el más reciente antes de tocar el DOM — si el usuario
  // ya cruzó varias escenas mientras el primer cambio esperaba su fade-out,
  // ese cambio queda obsoleto y no debe "ganarle" al más reciente.
  let cinematicBgToken = 0;
  const audioEl = document.getElementById('dark-ambient-audio');
  if (audioEl) audioEl.volume = 0.4;

  let isAudioPlaying = false;

  const btnAudio = document.getElementById('btn-audio-toggle');
  const audioBars = document.getElementById('audio-bars');
  const audioMutedIcon = document.getElementById('audio-muted-icon');
  let resumeAudioOnFocus = false;

  // Preferencia de silencio del usuario, persistida entre familias y entre
  // visitas. Solo el botón de sonido la modifica — el pausado/reanudado
  // automático por cambio de pestaña (más abajo) no debe tocarla.
  const AUDIO_MUTED_KEY = 'darkAmbientAudioMuted';
  let audioMutedByUser = false;
  try {
    audioMutedByUser = localStorage.getItem(AUDIO_MUTED_KEY) === '1';
  } catch {}

  if (
    relationshipValidation.missingEndpoints.length ||
    relationshipValidation.duplicateIds.length ||
    relationshipValidation.unknownTypes.length
  ) {
    console.warn('Family tree relationship validation issues', relationshipValidation);
  }

  function isSidebarOpen() {
    return !document
      .getElementById('netflix-sidebar')
      .classList.contains('-translate-x-full');
  }

  function closeSidebarIfOpen() {
    if (isSidebarOpen()) toggleSidebar();
  }

  function getFamilyRelationships(familyId) {
    return relationshipData.filter((relationship) => relationship.familyId === familyId);
  }

  function relationshipKey(relationship) {
    if (relationship.type === 'couple') {
      return [
        relationship.type,
        ...[relationship.from, relationship.to].sort(),
      ].join(':');
    }

    return [relationship.type, relationship.from, relationship.to].join(':');
  }

  function getCompleteRelationships() {
    const seen = new Set();

    return relationshipData.filter((relationship) => {
      const key = relationshipKey(relationship);
      if (seen.has(key)) return false;
      seen.add(key);
      return true;
    });
  }

  // Mismo algoritmo que computeLineage() en src/utils/familyTree.ts —
  // duplicado aquí porque este script es is:inline (no puede usar import),
  // igual que el resto de helpers de relaciones en este archivo.
  function computeLineage(characterId, relationships) {
    const lineage = new Set([characterId]);
    const queue = [characterId];

    while (queue.length > 0) {
      const current = queue.shift();

      relationships.forEach((relationship) => {
        let neighbor = null;
        if (relationship.from === current) neighbor = relationship.to;
        else if (relationship.to === current) neighbor = relationship.from;

        if (neighbor && !lineage.has(neighbor)) {
          lineage.add(neighbor);
          queue.push(neighbor);
        }
      });
    }

    return lineage;
  }

  function findCharacterFamily(characterId) {
    for (const family of familiasData) {
      const character = family.generations
        .flat()
        .find((item) => item.id === characterId);
      if (character) return { family, character };
    }

    return null;
  }

  const familyLayouts = {
    kahnwald: {
      width: 880,
      height: 820,
      nodes: {
        ines: { x: 440, y: 120 },
        mikkel: { x: 350, y: 345 },
        hannah: { x: 530, y: 345 },
        jonas: { x: 440, y: 610 },
      },
    },
    nielsen: {
      width: 900,
      height: 820,
      nodes: {
        tronte: { x: 350, y: 120 },
        jana: { x: 550, y: 120 },
        ulrich: { x: 350, y: 355 },
        katharina: { x: 550, y: 355 },
        magnus: { x: 300, y: 620 },
        martha: { x: 600, y: 620 },
      },
    },
    doppler: {
      width: 900,
      height: 900,
      nodes: {
        bernd: { x: 350, y: 105 },
        greta: { x: 550, y: 105 },
        helge: { x: 450, y: 310 },
        peter: { x: 350, y: 530 },
        charlotte: { x: 550, y: 530 },
        franziska: { x: 350, y: 755 },
        elisabeth: { x: 550, y: 755 },
      },
    },
    tiedemann: {
      width: 900,
      height: 900,
      nodes: {
        egon: { x: 350, y: 105 },
        doris: { x: 550, y: 105 },
        claudia: { x: 450, y: 310 },
        regina: { x: 350, y: 530 },
        aleksander: { x: 550, y: 530 },
        bartosz: { x: 450, y: 755 },
      },
    },
    adicionales: {
      width: 760,
      height: 460,
      nodes: {
        tannhaus: { x: 270, y: 210 },
        desconocido: { x: 490, y: 210 },
      },
    },
  };

  // Layout compacto en "V": generaciones alineadas horizontalmente entre
  // familias contemporáneas, convergiendo hacia Jonas + Martha en el centro
  // inferior (con el símbolo de infinito entre ambos), y Tannhaus/Desconocido
  // como vértices simbólicos arriba/abajo de todo el árbol — mismo mecanismo
  // de coordenadas manuales que antes, solo redistribuido.
  const completeLayout = {
    // Lienzo ampliado +15% (cap aprobado) respecto a la versión anterior
    // (2200x1230 → 2530x1415) para dar más aire entre bloques y reducir la
    // sensación de amontonamiento — todas las coordenadas de abajo están
    // escaladas ×1.15 desde el layout previo, preservando la disposición
    // relativa (Tiedemann/Nielsen+Kahnwald/Doppler) ya corregida.
    width: 2530,
    height: 1415,
    center: { x: 1265, y: 966 },
    nodes: {
      // ===== Tiedemann (columna izquierda, converge hacia el centro) =====
      // Bloque desplazado -130px (más separado de Kahnwald: el hueco
      // aleksander↔ines pasa de 34px a ~164px) — antes quedaba casi pegado.
      egon: { x: 160, y: 173 },
      doris: { x: 365, y: 173 },
      claudia: { x: 330, y: 437 },
      regina: { x: 411, y: 702 },
      aleksander: { x: 618, y: 702 },
      bartosz: { x: 572, y: 966 },

      // ===== Nielsen + Kahnwald (columna central) =====
      // Nielsen (tronte/jana/ulrich/katharina/magnus) desplazados a la
      // derecha respecto a Kahnwald (ines/mikkel/hannah) para que ambas
      // familias se lean como bloques separados en vez de mezclados.
      tronte: { x: 1093, y: 173 },
      jana: { x: 1369, y: 173 },
      ulrich: { x: 1093, y: 437 },
      katharina: { x: 1369, y: 437 },
      ines: { x: 782, y: 437 },
      mikkel: { x: 874, y: 702 },
      hannah: { x: 1070, y: 702 },
      magnus: { x: 1495, y: 702 },

      jonas: { x: 1150, y: 966, core: true },
      martha: { x: 1380, y: 966, core: true },
      desconocido: { x: 1265, y: 1208, core: true },
      // Tannhaus: figura "fuera del tiempo", sin línea de sangre directa —
      // colocado en el hueco vacío entre el bloque Nielsen/Kahnwald y el
      // bloque Doppler, en vez de amontonado junto a El Desconocido o
      // flotando aislado arriba del todo.
      tannhaus: { x: 1668, y: 437 },

      // ===== Doppler (columna derecha, converge hacia el centro — espejo de Tiedemann) =====
      // Bloque desplazado -180px (más junto al resto: el hueco tannhaus↔peter
      // pasa de 322px a ~142px) — antes quedaba demasiado aislado a la derecha.
      bernd: { x: 1833, y: 173 },
      greta: { x: 2040, y: 173 },
      helge: { x: 1890, y: 437 },
      peter: { x: 1810, y: 702 },
      charlotte: { x: 2017, y: 702 },
      franziska: { x: 1856, y: 966 },
      elisabeth: { x: 2063, y: 966 },
    },
    // Etiquetas de familia flotantes (sin caja/borde) — ya no se dibujan
    // 5 bloques separados, solo un nombre tenue cerca de cada grupo.
    labels: [
      { familyId: 'tiedemann', x: 160, y: 109 },
      { familyId: 'nielsen', x: 1231, y: 109 },
      { familyId: 'kahnwald', x: 782, y: 374 },
      { familyId: 'doppler', x: 1833, y: 109 },
      { familyId: 'adicionales', x: 1265, y: 1133 },
    ],
  };

  const sceneImagePools = {
    kahnwald: [
      '/Familias/Familia1/jonas.jpg',
      '/Familias/Familia1/mikkel.jpg',
      '/Familias/Familia1/hanna.png',
      '/Familias/Familia1/1.jpg',
      '/Familias/Familia1/2.jpg',
      '/Familias/Familia1/3.jpg',
      '/Aclaraciones/Final/11.jpg',
      '/Aclaraciones/Final/3.jpg',
    ],
    nielsen: [
      '/Familias/Familia2/1.jpg',
      '/Familias/Familia2/2.jpg',
      '/Familias/Familia2/5.jpg',
      '/Familias/Familia2/6.jpg',
      '/Familias/Familia2/10.jpg',
      '/Familias/Familia2/14.jpg',
      '/Familias/Familia2/16.jpg',
    ],
    doppler: [
      '/Familias/Familia3/1.jpg',
      '/Familias/Familia3/4.jpg',
      '/Familias/Familia3/6.jpg',
      '/Familias/Familia3/7.jpg',
      '/Familias/Familia3/8.jpg',
      '/Familias/Familia3/9.jpg',
      '/Familias/Familia3/12.jpg',
    ],
    tiedemann: [
      '/Familias/Familia4/1.1.jpg',
      '/Familias/Familia4/2.jpg',
      '/Familias/Familia4/6.jpg',
      '/Familias/Familia4/8.jpg',
      '/Familias/Familia4/10.jpg',
      '/Familias/Familia4/11.jpg',
      '/Familias/Familia4/13.jpg',
    ],
    adicionales: [
      '/Familias/Familia5/inicio.png',
      '/Familias/Familia5/desconocido.jpg',
      '/Familias/Familia5/1.jpg',
      '/Familias/Familia5/2.jpg',
      '/Aclaraciones/Final/4.jpg',
    ],
  };

  // Lógica Botón Audio Elegante (Bars vs Mute Icon)
  if (btnAudio) {
    btnAudio.addEventListener('click', () => {
      if (!audioEl) return;
      if (isAudioPlaying) {
        audioMutedByUser = true;
        try {
          localStorage.setItem(AUDIO_MUTED_KEY, '1');
        } catch {}
        resumeAudioOnFocus = false;
        pauseSectionAudio();
      } else {
        audioMutedByUser = false;
        try {
          localStorage.setItem(AUDIO_MUTED_KEY, '0');
        } catch {}
        playSectionAudio();
      }
    });
  }

  function isImmersiveViewActive() {
    const treeViewer = document.getElementById('tree-viewer');
    const cineViewer = document.getElementById('cinematic-viewer');
    return (
      !treeViewer.classList.contains('hidden') ||
      !cineViewer.classList.contains('hidden')
    );
  }

  function syncAudioButton() {
    if (!audioBars || !audioMutedIcon) return;
    if (isAudioPlaying) {
      audioBars.classList.remove('hidden');
      audioMutedIcon.classList.add('hidden');
    } else {
      audioBars.classList.add('hidden');
      audioMutedIcon.classList.remove('hidden');
    }
  }

  function pauseSectionAudio({ remember = false } = {}) {
    if (!audioEl) return;
    if (remember) {
      resumeAudioOnFocus =
        resumeAudioOnFocus || (isAudioPlaying && isImmersiveViewActive());
    }
    audioEl.pause();
    isAudioPlaying = false;
    syncAudioButton();
  }

  function playSectionAudio() {
    if (audioMutedByUser) return;
    if (!audioEl || document.hidden || !isImmersiveViewActive()) return;
    audioEl
      .play()
      .then(() => {
        isAudioPlaying = true;
        syncAudioButton();
      })
      .catch((e) => console.log(e));
  }

  function resumeSectionAudioIfNeeded() {
    if (!resumeAudioOnFocus || !isImmersiveViewActive()) return;
    resumeAudioOnFocus = false;
    playSectionAudio();
    setTimeout(playSectionAudio, 250);
    setTimeout(playSectionAudio, 900);
  }

  document.addEventListener('visibilitychange', () => {
    if (document.hidden) {
      pauseSectionAudio({ remember: true });
      return;
    }

    resumeSectionAudioIfNeeded();
  });

  window.addEventListener('blur', () => {
    pauseSectionAudio({ remember: true });
  });

  window.addEventListener('focus', () => {
    resumeSectionAudioIfNeeded();
  });

  function buildSidebar() {
    const sidebarContent = document.getElementById('sidebar-content');
    sidebarContent.innerHTML = '';

    familiasData.forEach((familia) => {
      if (!familia.generations || familia.generations.length === 0) return;
      const flatChars = familia.generations.flat();

      let html = `<div class="mb-6"><h3 class="font-cinzel text-stone-500 tracking-[0.2em] uppercase text-xs mb-4 border-b border-stone-800 pb-2">${familia.name}</h3><div class="grid grid-cols-2 gap-4">`;
      flatChars.forEach((char) => {
        html += `
          <div class="flex flex-col items-center gap-2 cursor-pointer group pointer-events-auto" onclick="jumpToCharacter('${familia.id}', '${char.id}')">
            <img src="${char.avatar}" class="w-16 h-16 object-cover grayscale opacity-60 group-hover:grayscale-0 group-hover:opacity-100 transition-all border border-transparent group-hover:border-amber-500 rounded">
            <span class="text-[10px] font-cinzel text-stone-400 group-hover:text-white uppercase text-center">${char.name}</span>
          </div>`;
      });
      html += `</div></div>`;
      sidebarContent.innerHTML += html;
    });
  }

  window.toggleSidebar = () => {
    const sidebar = document.getElementById('netflix-sidebar');
    const overlay = document.getElementById('sidebar-overlay');
    if (sidebar.classList.contains('-translate-x-full')) {
      buildSidebar();
      sidebar.classList.remove('-translate-x-full');
      overlay.classList.remove('hidden');
      setTimeout(() => overlay.classList.remove('opacity-0'), 10);
    } else {
      sidebar.classList.add('-translate-x-full');
      overlay.classList.add('opacity-0');
      setTimeout(() => overlay.classList.add('hidden'), 500);
    }
  };

  window.goToFamiliasOverview = () => {
    window.resetPersonajesTabs();
  };

  window.resetPersonajesTabs = () => {
    if (observer) observer.disconnect();
    currentFamilyId = '';
    currentTreeMode = 'family';
    document.getElementById('cinematic-viewer').classList.add('hidden', 'opacity-0');
    document.getElementById('tree-viewer').classList.add('hidden', 'opacity-0');
    document.getElementById('familias-main-view').classList.remove('hidden');
    document.body.classList.remove('hide-global-ui');
    closeSidebarIfOpen();
    if (treeCursor) treeCursor.style.opacity = '0';
    if (btnAudio) {
      btnAudio.classList.remove('flex');
      btnAudio.classList.add('hidden');
    }
    resumeAudioOnFocus = false;
    pauseSectionAudio();
  };

  // DIBUJAR ÁRBOL con líneas SVG reales (pareja + descendencia)
  // Version relacional: usa relationshipData directamente en lugar de inferir por filas.
  function drawTreeLines(relationships, svg, container) {
    svg.innerHTML = '';
    const W = container.offsetWidth;
    const H = container.offsetHeight;

    svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
    svg.style.width = W + 'px';
    svg.style.height = H + 'px';

    function nodeCenter(node) {
      const containerRect = container.getBoundingClientRect();
      const img = node.querySelector('img');
      const targetRect = (img || node).getBoundingClientRect();
      return {
        cx: targetRect.left - containerRect.left + targetRect.width / 2,
        top: targetRect.top - containerRect.top,
        bottom: targetRect.bottom - containerRect.top,
        mid: targetRect.top - containerRect.top + targetRect.height / 2,
      };
    }

    const defs = document.createElementNS('http://www.w3.org/2000/svg', 'defs');
    svg.appendChild(defs);

    // lineGrad/lineGradH (degradado) y glowLine (filtro de resplandor) eran
    // <linearGradient>/<filter> únicos y compartidos, usando las unidades
    // por defecto ("objectBoundingBox") — relativas al propio bounding box
    // de CADA elemento que los usa. Por especificación SVG, un elemento con
    // bounding box de alto O ancho CERO hace que ese efecto no se pinte en
    // absoluto (queda invisible), aunque el elemento siga presente en el
    // DOM con opacity/visibility normales. Una <line> de pareja
    // perfectamente horizontal (y1 === y2, el caso normal: casi todas las
    // parejas están definidas a la misma altura Y) o un <path> recto
    // perfectamente vertical (isStraight, x del origen === x del hijo, el
    // caso normal para un hijo único bajo una pareja) tienen bounding box
    // de alto o ancho cero respectivamente — el trazo desaparecía de forma
    // inconsistente según qué elemento cayera exactamente en ese caso
    // degenerado. El degradado ya se corrigió generando uno propio por
    // línea con gradientUnits="userSpaceOnUse"; el filtro de resplandor
    // tenía exactamente el mismo problema (confirmado en vivo: quitar
    // `filter` a una línea afectada la hacía visible de nuevo) y se corrige
    // igual — un <filter> propio por línea con filterUnits="userSpaceOnUse"
    // y una región calculada en coordenadas absolutas con margen fijo, en
    // vez de un porcentaje relativo a un bbox que puede ser degenerado.
    let gradientIdCounter = 0;

    function makeGlowFilter(minX, maxX, minY, maxY) {
      const filterId = `glowLine-${gradientIdCounter++}`;
      const filter = document.createElementNS(
        'http://www.w3.org/2000/svg',
        'filter',
      );
      const pad = 12;
      filter.setAttribute('id', filterId);
      filter.setAttribute('filterUnits', 'userSpaceOnUse');
      filter.setAttribute('x', minX - pad);
      filter.setAttribute('y', minY - pad);
      filter.setAttribute('width', maxX - minX + pad * 2);
      filter.setAttribute('height', maxY - minY + pad * 2);
      filter.innerHTML = `
        <feGaussianBlur stdDeviation="1.5" result="blur"/>
        <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
      `;
      defs.appendChild(filter);
      return filterId;
    }

    function makeLine(x1, y1, x2, y2) {
      const gradId = `lineGradH-${gradientIdCounter++}`;
      const gradient = document.createElementNS(
        'http://www.w3.org/2000/svg',
        'linearGradient',
      );
      gradient.setAttribute('id', gradId);
      gradient.setAttribute('gradientUnits', 'userSpaceOnUse');
      gradient.setAttribute('x1', x1);
      gradient.setAttribute('y1', y1);
      gradient.setAttribute('x2', x2);
      gradient.setAttribute('y2', y2);
      gradient.innerHTML = `
        <stop offset="0%" stop-color="rgba(245,158,11,0)" />
        <stop offset="28%" stop-color="rgba(245,158,11,0.62)" />
        <stop offset="72%" stop-color="rgba(245,158,11,0.62)" />
        <stop offset="100%" stop-color="rgba(245,158,11,0)" />
      `;
      defs.appendChild(gradient);

      const filterId = makeGlowFilter(
        Math.min(x1, x2),
        Math.max(x1, x2),
        Math.min(y1, y2),
        Math.max(y1, y2),
      );

      const el = document.createElementNS('http://www.w3.org/2000/svg', 'line');
      el.setAttribute('x1', x1);
      el.setAttribute('y1', y1);
      el.setAttribute('x2', x2);
      el.setAttribute('y2', y2);
      el.setAttribute('stroke', `url(#${gradId})`);
      el.setAttribute('stroke-width', '1.1');
      el.setAttribute('filter', `url(#${filterId})`);
      return el;
    }

    function makePath(d, minX, maxX, minY, maxY) {
      const gradId = `lineGrad-${gradientIdCounter++}`;
      const gradient = document.createElementNS(
        'http://www.w3.org/2000/svg',
        'linearGradient',
      );
      gradient.setAttribute('id', gradId);
      gradient.setAttribute('gradientUnits', 'userSpaceOnUse');
      gradient.setAttribute('x1', '0');
      gradient.setAttribute('y1', minY);
      gradient.setAttribute('x2', '0');
      gradient.setAttribute('y2', maxY);
      gradient.innerHTML = `
        <stop offset="0%" stop-color="rgba(245,158,11,0.08)" />
        <stop offset="45%" stop-color="rgba(245,158,11,0.78)" />
        <stop offset="55%" stop-color="rgba(245,158,11,0.92)" />
        <stop offset="100%" stop-color="rgba(245,158,11,0.08)" />
      `;
      defs.appendChild(gradient);

      const filterId = makeGlowFilter(minX, maxX, minY, maxY);

      const el = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      el.setAttribute('d', d);
      el.setAttribute('stroke', `url(#${gradId})`);
      el.setAttribute('stroke-width', '1.1');
      el.setAttribute('fill', 'none');
      el.setAttribute('filter', `url(#${filterId})`);
      return el;
    }

    function makeDiamond(cx, cy) {
      const el = document.createElementNS(
        'http://www.w3.org/2000/svg',
        'polygon',
      );
      el.setAttribute(
        'points',
        `${cx},${cy - 6} ${cx + 6},${cy} ${cx},${cy + 6} ${cx - 6},${cy}`,
      );
      el.setAttribute('fill', 'rgba(245,158,11,0.85)');
      const filterId = makeGlowFilter(cx - 6, cx + 6, cy - 6, cy + 6);
      el.setAttribute('filter', `url(#${filterId})`);
      return el;
    }

    function makeArrow(cx, y) {
      const el = document.createElementNS(
        'http://www.w3.org/2000/svg',
        'polygon',
      );
      el.setAttribute(
        'points',
        `${cx - 4},${y - 8} ${cx + 4},${y - 8} ${cx},${y}`,
      );
      el.setAttribute('fill', 'rgba(245,158,11,0.6)');
      return el;
    }

    const nodesById = new Map();
    container.querySelectorAll('[data-tree-node]').forEach((node) => {
      nodesById.set(node.dataset.charId, nodeCenter(node));
    });

    const couples = relationships.filter(
      (relationship) => relationship.type === 'couple',
    );
    const parentChild = relationships.filter(
      (relationship) => relationship.type === 'parentChild',
    );
    const coupleMidpoints = new Map();

    couples.forEach((relationship) => {
      const from = nodesById.get(relationship.from);
      const to = nodesById.get(relationship.to);
      if (!from || !to) {
        console.warn('Tree line skipped: couple relationship has no resolvable position', {
          id: relationship.id,
          type: relationship.type,
          from: relationship.from,
          to: relationship.to,
          familyId: relationship.familyId,
        });
        return;
      }

      const y = (from.mid + to.mid) / 2;
      const midX = (from.cx + to.cx) / 2;
      const key = [relationship.from, relationship.to].sort().join(':');
      coupleMidpoints.set(key, { x: midX, y });

      svg.appendChild(makeLine(from.cx, from.mid, to.cx, to.mid));
      svg.appendChild(makeDiamond(midX, y));
    });

    // Agrupa por hijo primero (no por relación individual): un hijo puede
    // tener más de dos "padres" registrados (p. ej. Mikkel: Ulrich+Katharina
    // como progenitores biológicos, más Ines como figura tutora en el
    // universo Kahnwald). La versión anterior recalculaba "parents" en cada
    // iteración de `parentChild` filtrando solo por `to === relationship.to`,
    // así que las 3 relaciones de Mikkel colapsaban siempre en la misma key
    // (la de la pareja Ulrich+Katharina) y la línea de Ines nunca llegaba a
    // insertarse en el Map. Ahora: se detecta como mucho UNA pareja entre los
    // padres de cada hijo (se sigue dibujando como una sola línea desde el
    // punto medio de la pareja), y cualquier padre que no forme parte de esa
    // pareja recibe su propia línea individual hacia el hijo.
    const childrenByParents = new Map();
    const parentsByChild = new Map();

    parentChild.forEach((relationship) => {
      if (!parentsByChild.has(relationship.to)) {
        parentsByChild.set(relationship.to, new Set());
      }
      parentsByChild.get(relationship.to).add(relationship.from);
    });

    parentsByChild.forEach((parentsSet, child) => {
      const parents = Array.from(parentsSet);
      const couple = couples.find(
        (candidate) =>
          parents.includes(candidate.from) && parents.includes(candidate.to),
      );
      const usedParents = new Set();

      if (couple) {
        const key = `${[couple.from, couple.to].sort().join(':')}->${child}`;
        childrenByParents.set(key, { parents: [couple.from, couple.to], child });
        usedParents.add(couple.from);
        usedParents.add(couple.to);
      }

      parents
        .filter((parentId) => !usedParents.has(parentId))
        .forEach((parentId) => {
          const key = `${parentId}->${child}`;
          childrenByParents.set(key, { parents: [parentId], child });
        });
    });

    Array.from(childrenByParents.values()).forEach((group) => {
      const child = nodesById.get(group.child);
      if (!child) {
        console.warn('Tree line skipped: child has no resolvable position', {
          child: group.child,
          parents: group.parents,
        });
        return;
      }

      const parentCenters = group.parents
        .map((parentId) => nodesById.get(parentId))
        .filter(Boolean);
      if (!parentCenters.length) {
        console.warn('Tree line skipped: no parent has a resolvable position', {
          child: group.child,
          parents: group.parents,
        });
        return;
      }

      const coupleKey =
        group.parents.length > 1 ? [...group.parents].sort().join(':') : '';
      const couplePoint = coupleMidpoints.get(coupleKey);
      const fromX =
        couplePoint?.x ??
        parentCenters.reduce((sum, center) => sum + center.cx, 0) /
          parentCenters.length;
      const fromY =
        couplePoint?.y ??
        Math.max(...parentCenters.map((center) => center.bottom));
      const startY = couplePoint ? fromY + 6 : fromY;
      const midY = startY + (child.top - startY) * 0.48;
      const isStraight = Math.abs(fromX - child.cx) < 4;
      const d = isStraight
        ? `M ${fromX} ${startY} L ${child.cx} ${child.top}`
        : `M ${fromX} ${startY} L ${fromX} ${midY} L ${child.cx} ${midY} L ${child.cx} ${child.top}`;

      svg.appendChild(
        makePath(
          d,
          Math.min(fromX, child.cx),
          Math.max(fromX, child.cx),
          Math.min(startY, child.top),
          Math.max(startY, child.top),
        ),
      );
      svg.appendChild(makeArrow(child.cx, child.top));
    });
  }

  // Espera a que las imágenes de los nodos del árbol terminen de decodificar
  // (o fallen) y a un frame extra de layout antes de medir posiciones con
  // getBoundingClientRect — evita líneas/iconos ausentes por leer posiciones
  // antes de que el navegador haya terminado de pintar los avatares.
  // Espera hasta que el contenedor del árbol tenga tamaño real (visible en
  // pantalla) antes de medir sus nodos. Si el árbol se dibuja mientras el
  // visor está oculto (p. ej. salto entre familias desde la barra lateral),
  // medir antes de tiempo produce rectángulos de tamaño cero y líneas rotas
  // de forma permanente. Se autocancela con el mismo treeDrawToken que ya
  // usa scheduleTreeLinesDraw si un nuevo dibujo lo deja obsoleto mientras
  // espera.
  function waitForVisibleTreeContainer(container, drawToken) {
    return new Promise((resolve) => {
      function check() {
        if (drawToken !== treeDrawToken) {
          resolve(false);
          return;
        }
        if (container.offsetWidth > 0 && container.offsetHeight > 0) {
          resolve(true);
          return;
        }
        requestAnimationFrame(check);
      }
      check();
    });
  }

  function scheduleTreeLinesDraw(relationships, svg, container, options = {}) {
    const images = Array.from(container.querySelectorAll('img'));
    const ready =
      images.length === 0
        ? Promise.resolve()
        : Promise.all(
            images.map((img) =>
              img.decode ? img.decode().catch(() => {}) : Promise.resolve(),
            ),
          );

    // Captura el token vigente en el momento de la llamada: si para cuando
    // este dibujo esté listo el usuario ya cambió de árbol/familia (nuevo
    // token), este resultado quedó obsoleto y no debe dibujarse.
    const drawToken = treeDrawToken;

    ready
      .then(() => waitForVisibleTreeContainer(container, drawToken))
      .then((isVisible) => {
        if (!isVisible) return;
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            if (drawToken !== treeDrawToken) return;
            // El zoom/pan dejado por una visita anterior a cualquier árbol
            // sigue aplicado al contenedor en este punto: si no se resetea
            // antes de medir, drawTreeLines() mide posiciones ya escaladas
            // y las líneas quedan mal calculadas de forma permanente.
            // #tree-zoom-container tiene SIEMPRE una transición CSS de
            // transform (0.08s, o 0.4s si queda la clase smooth-reset de un
            // centerTree() anterior) — asignar el transform directamente no
            // basta, el navegador la anima igualmente y drawTreeLines()
            // mediría posiciones a mitad de esa animación. Se anula la
            // transición con un estilo inline (máxima especificidad, gana a
            // cualquier regla de clase), se fuerza un reflow síncrono para
            // que el cambio de transform se aplique ya, y solo entonces se
            // restaura la transición — centerTree() (llamado después, vía
            // onDrawn) es quien anima suavemente hacia el zoom final.
            treeScale = 1;
            treePanX = 0;
            treePanY = 0;
            const zc = document.getElementById('tree-zoom-container');
            if (zc) {
              zc.classList.remove('smooth-reset');
              zc.style.transition = 'none';
              zc.style.transform = 'translate(0px, 0px) scale(1)';
              void zc.offsetWidth;
              zc.style.transition = '';
            }
            drawTreeLines(relationships, svg, container);
            if (typeof options.onDrawn === 'function') options.onDrawn();
          });
        });
      });
  }

  function drawTree(familiaId) {
    const familia = familiasData.find((f) => f.id === familiaId);
    const layout = familyLayouts[familiaId];
    if (!familia || !layout) return false;

    currentFamilyId = familiaId;
    currentTreeMode = 'family';
    treeDrawToken++;
    document.getElementById('tree-family-name').innerText = familia.name;

    const container = document.getElementById('tree-nodes-container');
    container.innerHTML = '';
    container.className = 'family-tree-canvas relative';
    container.style.width = layout.width + 'px';
    container.style.height = layout.height + 'px';
    container.style.minWidth = layout.width + 'px';
    container.style.minHeight = layout.height + 'px';
    container.style.position = 'relative';

    const svgOverlay = document.createElementNS(
      'http://www.w3.org/2000/svg',
      'svg',
    );
    svgOverlay.id = 'tree-svg-lines';
    svgOverlay.style.cssText =
      'position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;overflow:visible;z-index:6;';

    familia.generations.flat().forEach((char) => {
      const pos = layout.nodes[char.id];
      if (!pos) return;
      const nodeShell = document.createElement('div');
      nodeShell.className = 'family-tree-node';
      nodeShell.style.left = pos.x + 'px';
      nodeShell.style.top = pos.y + 'px';
      nodeShell.appendChild(renderTreeNode(familia, char));
      container.appendChild(nodeShell);
    });

    container.appendChild(svgOverlay);

    scheduleTreeLinesDraw(
      getFamilyRelationships(familia.id),
      svgOverlay,
      container,
      { onDrawn: centerTree },
    );

    return true;
  }

  function renderTreeNode(familia, char) {
    const timelineLabel =
      char.stages && char.stages[0] ? char.stages[0].timeline : '';
    const node = document.createElement('div');
    node.className =
      'tree-node-wrap flex flex-col items-center gap-2 cursor-pointer group hover:scale-105 transition-transform duration-500 relative pointer-events-auto';
    node.setAttribute('data-tree-node', '1');
    node.setAttribute('data-char-id', char.id);
    node.setAttribute('data-family-id', familia.id);
    node.onclick = () => openCharacterFromTree(familia.id, char.id);
    node.innerHTML = `
      ${timelineLabel ? `<div class="tree-tooltip">${timelineLabel}</div>` : ''}
      <div class="relative w-14 h-14 md:w-20 md:h-20 rounded-sm overflow-hidden border border-stone-700 group-hover:border-amber-500/70 shadow-2xl transition-all duration-500 z-10">
        <img src="${char.avatar}" class="w-full h-full object-cover grayscale opacity-80 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-700">
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent"></div>
      </div>
      <p class="font-cinzel text-stone-400 group-hover:text-amber-400 tracking-widest uppercase text-[8px] md:text-[9px] transition-colors text-center w-20 md:w-24 min-h-[2.4em] leading-tight z-10">
        ${char.name}
      </p>`;
    return node;
  }

  function drawCompleteTree() {
    currentTreeMode = 'complete';
    treeDrawToken++;
    document.getElementById('tree-family-name').innerText = 'Arbol Completo';

    const container = document.getElementById('tree-nodes-container');
    container.innerHTML = '';
    container.className = 'complete-tree-grid relative';
    container.style.width = completeLayout.width + 'px';
    container.style.height = completeLayout.height + 'px';
    container.style.minWidth = completeLayout.width + 'px';
    container.style.minHeight = completeLayout.height + 'px';
    container.style.position = 'relative';

    const svgOverlay = document.createElementNS(
      'http://www.w3.org/2000/svg',
      'svg',
    );
    svgOverlay.id = 'tree-svg-lines';
    svgOverlay.style.cssText =
      'position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;overflow:visible;z-index:6;';

    // Etiquetas de familia flotantes — mapa único, sin bloques separados.
    completeLayout.labels.forEach((label) => {
      const familia = familiasData.find((family) => family.id === label.familyId);
      if (!familia) return;
      const labelEl = document.createElement('h3');
      labelEl.className = 'complete-family-label';
      labelEl.style.left = label.x + 'px';
      labelEl.style.top = label.y + 'px';
      labelEl.style.setProperty('--family-accent', familia.accent);
      labelEl.textContent = familia.name;
      container.appendChild(labelEl);
    });

    familiasData.forEach((familia) => {
      familia.generations.flat().forEach((char) => {
        const pos = completeLayout.nodes[char.id];
        if (!pos) return;
        const nodeShell = document.createElement('div');
        nodeShell.className = 'complete-tree-node';
        nodeShell.dataset.charId = char.id;
        nodeShell.style.left = pos.x + 'px';
        nodeShell.style.top = pos.y + 'px';
        if (pos.core) nodeShell.dataset.core = '1';
        nodeShell.appendChild(renderTreeNode(familia, char));
        container.appendChild(nodeShell);
      });
    });

    container.appendChild(svgOverlay);

    scheduleTreeLinesDraw(getCompleteRelationships(), svgOverlay, container, {
      onDrawn: () => {
        drawInfinityCenterpiece(svgOverlay);
        centerTree();
      },
    });

    setupLineageHighlight(container);

    return true;
  }

  // Al pasar el cursor sobre un personaje del Árbol Completo, resalta su
  // linaje directo (ancestros + descendientes) y atenúa el resto.
  function setupLineageHighlight(container) {
    const nodes = Array.from(container.querySelectorAll('.complete-tree-node'));
    const relationships = getCompleteRelationships();

    nodes.forEach((node) => {
      node.addEventListener('mouseenter', () => {
        const lineage = computeLineage(node.dataset.charId, relationships);
        nodes.forEach((other) => {
          const inLineage = lineage.has(other.dataset.charId);
          other.classList.toggle('is-dimmed', !inLineage);
          other.classList.toggle('is-active', other === node);
        });
      });

      node.addEventListener('mouseleave', () => {
        nodes.forEach((other) => {
          other.classList.remove('is-dimmed', 'is-active');
        });
      });
    });
  }

  // Centerpiece decorativo: símbolo de infinito entre Jonas y Martha, en el
  // centro visual del Árbol Completo — no es una relación modelada en
  // relationshipData, es un elemento fijo anclado a sus ids conocidos.
  function drawInfinityCenterpiece(svg) {
    const jonasPos = completeLayout.nodes.jonas;
    const marthaPos = completeLayout.nodes.martha;
    if (!jonasPos || !marthaPos) return;

    const midX = (jonasPos.x + marthaPos.x) / 2;
    const midY = (jonasPos.y + marthaPos.y) / 2;

    // `drawTreeLines()` ya construyó y adjuntó un <defs> a este mismo `svg`
    // (comparten el elemento vía el parámetro svgOverlay de drawCompleteTree),
    // pero el <filter id="glowLine"> compartido que existía antes se
    // eliminó — cada línea ahora genera su propio filtro con
    // filterUnits="userSpaceOnUse" (ver makeGlowFilter dentro de
    // drawTreeLines) porque las unidades por defecto ("objectBoundingBox")
    // no se pintan cuando el bounding box del elemento tiene ancho o alto
    // cero. La línea Jonas–Martha y el símbolo ∞ de este centerpiece corren
    // el mismo riesgo (línea potencialmente recta), así que se les crea su
    // propio filtro local aquí, igual de inmune al bbox.
    const defs = svg.querySelector('defs');
    const filterId = 'infinityGlow';
    if (defs && !defs.querySelector(`#${filterId}`)) {
      const pad = 20;
      const minX = Math.min(jonasPos.x, marthaPos.x) - pad;
      const maxX = Math.max(jonasPos.x, marthaPos.x) + pad;
      const minY = Math.min(jonasPos.y, marthaPos.y) - pad;
      const maxY = Math.max(jonasPos.y, marthaPos.y) + pad;
      const filter = document.createElementNS(
        'http://www.w3.org/2000/svg',
        'filter',
      );
      filter.setAttribute('id', filterId);
      filter.setAttribute('filterUnits', 'userSpaceOnUse');
      filter.setAttribute('x', minX);
      filter.setAttribute('y', minY);
      filter.setAttribute('width', maxX - minX);
      filter.setAttribute('height', maxY - minY);
      filter.innerHTML = `
        <feGaussianBlur stdDeviation="1.5" result="blur"/>
        <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
      `;
      defs.appendChild(filter);
    }

    const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
    line.setAttribute('x1', jonasPos.x);
    line.setAttribute('y1', jonasPos.y);
    line.setAttribute('x2', marthaPos.x);
    line.setAttribute('y2', marthaPos.y);
    line.setAttribute('stroke', 'rgba(245,158,11,0.8)');
    line.setAttribute('stroke-width', '1.4');
    line.setAttribute('filter', `url(#${filterId})`);
    svg.appendChild(line);

    const text = document.createElementNS(
      'http://www.w3.org/2000/svg',
      'text',
    );
    text.setAttribute('x', midX);
    text.setAttribute('y', midY);
    text.setAttribute('font-size', '46');
    text.setAttribute('class', 'complete-tree-infinity');
    text.setAttribute('filter', `url(#${filterId})`);
    text.textContent = '∞';
    svg.appendChild(text);
  }

  function showTreeViewer() {
    document.body.classList.add('hide-global-ui');
    if (btnAudio) {
      btnAudio.classList.remove('hidden');
      btnAudio.classList.add('flex');
    }

    document.getElementById('familias-main-view').classList.add('hidden');
    const treeViewer = document.getElementById('tree-viewer');
    treeViewer.classList.remove('hidden');
    setTimeout(() => {
      treeViewer.classList.remove('opacity-0');
      setTimeout(centerTree, 250);
    }, 50);

    playSectionAudio();
  }

  window.openCompleteTreeViewer = () => {
    closeSidebarIfOpen();
    drawCompleteTree();
    showTreeViewer();
