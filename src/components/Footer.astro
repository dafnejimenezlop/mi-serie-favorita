---
// src/components/Footer.astro

const currentYear = new Date().getFullYear();

// Enlaces de la antigua web, actualizados para el nuevo diseño
const paginasLinks = [
  { href: '/#inicio', label: 'Inicio' },
  { href: '/#resumen', label: 'Resumen Temporadas' },
  { href: '/#aclaraciones', label: 'Aclaraciones' },
  { href: '/#personajes', label: 'Familias / Personajes' },
  { href: '/#recomendaciones', label: 'Recomendaciones' },
  { href: '/#galeria', label: 'Banda Sonora & Galería' },
];

// Los tres iconos de la derecha apuntaban a `href="#"`. En un sitio cuyo
// router vive en el hash, eso vaciaba `location.hash` y devolvia al usuario a
// Inicio desde cualquier seccion (regla 4: ningun link a un hash inexistente).
// Ahora son los tres destinos reales que el proyecto ya usa en otros sitios.
const socialLinks = [
  {
    href: 'https://www.youtube.com/watch?v=14FGjkrrXFk',
    label: 'Ver el trailer oficial en YouTube',
    icon: 'M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z',
  },
  {
    href: 'https://www.netflix.com/title/80100172',
    label: 'Ver DARK en Netflix',
    icon: 'M4 3h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2h-6v2h3a1 1 0 0 1 0 2H7a1 1 0 0 1 0-2h3v-2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zm6 3.2v7.6L16 10l-6-3.8z',
  },
  {
    href: 'https://wa.me/34644594975?text=Hola!%20He%20visto%20tu%20web%20y%20quiero%20recomendarte%20algo.',
    label: 'Escribir por WhatsApp',
    icon: 'M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.316 1.592 5.43 0 9.856-4.426 9.858-9.855.002-5.43-4.425-9.856-9.853-9.856-5.431 0-9.856 4.426-9.858 9.854 0 2.117.575 3.905 1.638 5.637l-.993 3.634 3.702-.971z',
  },
];

const proyectoLinks = [
  {
    href: 'https://www.netflix.com/title/80100172',
    label: 'Ver DARK en Netflix',
    target: '_blank',
  },
  { href: 'mailto:contacto@winden.fan', label: 'Reportar Paradoja / Contacto' },
];
---

<footer
  class="relative py-16 md:py-20 bg-stone-900 dark:bg-[#0a0a0a]/90 backdrop-blur-md border-t border-stone-700 dark:border-stone-800 transition-colors duration-500 overflow-hidden"
>
  <svg
    class="absolute -right-24 -bottom-24 w-[500px] h-[500px] text-stone-100 opacity-[0.03] dark:opacity-[0.02] pointer-events-none transform rotate-12"
    viewBox="0 0 100 100"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
  >
    <circle cx="50" cy="40" r="28"></circle>
    <circle cx="35" cy="65" r="28"></circle>
    <circle cx="65" cy="65" r="28"></circle>
  </svg>

  <div class="container mx-auto px-6 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-8 items-start">
      <div class="md:col-span-4 space-y-6">
        <a href="/" class="flex-shrink-0 inline-block">
          <img
            src="/prueba.png"
            alt="Dark Logo"
            class="h-10 md:h-14 w-auto object-contain transition-transform hover:scale-105 filter drop-shadow-[0_0_8px_rgba(255,255,255,0.1)]"
          />
        </a>
        <p
          class="text-sm md:text-base text-stone-200 font-cinzel font-bold tracking-[0.2em]"
        >
          SIC MUNDUS CREATUS EST.
        </p>
        <div class="h-px w-24 bg-amber-500 transition-colors"></div>
        <p
          class="text-xs md:text-sm text-stone-400 font-mono tracking-wider pt-2 italic leading-relaxed"
        >
          "El final es el principio. Y el principio es el fin."
        </p>
      </div>

      <div class="md:col-span-3 md:pl-10">
        <h4
          class="font-cinzel text-amber-500 uppercase tracking-[0.3em] font-bold text-lg mb-6"
        >
          Páginas
        </h4>
        <ul class="space-y-4">
          {
            paginasLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm md:text-base text-stone-400 hover:text-amber-400 transition-colors tracking-wide font-light flex items-center group"
                >
                  <span class="w-0 h-px bg-amber-500 mr-0 group-hover:w-3 group-hover:mr-2 transition-all duration-300" />
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="md:col-span-3 md:pl-8">
        <h4
          class="font-cinzel text-amber-500 uppercase tracking-[0.3em] font-bold text-lg mb-6"
        >
          Enlaces
        </h4>
        <ul class="space-y-4">
          {
            proyectoLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={link.target}
                  rel={link.target === '_blank' ? 'noopener noreferrer' : undefined}
                  class="text-sm md:text-base text-stone-400 hover:text-amber-400 transition-colors tracking-wide font-light flex items-center group"
                >
                  <span class="w-0 h-px bg-amber-500 mr-0 group-hover:w-3 group-hover:mr-2 transition-all duration-300" />
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div
        class="md:col-span-2 flex md:flex-col items-center md:items-end justify-center md:justify-start space-x-6 md:space-x-0 md:space-y-6 pt-4 md:pt-0"
      >
        {
          socialLinks.map((social) => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              class="p-3 bg-stone-800 dark:bg-stone-900 border border-stone-700 dark:border-stone-800 rounded-full hover:bg-black hover:border-amber-500/50 text-stone-400 hover:text-amber-500 shadow-lg group transition-colors duration-300"
              aria-label={social.label}
            >
              <svg
                class="w-5 h-5 md:w-6 md:h-6 transform group-hover:scale-110 transition-transform"
                fill="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path d={social.icon} />
              </svg>
            </a>
          ))
        }
      </div>
    </div>

    <div
      class="mt-16 md:mt-20 pt-8 border-t border-stone-700 dark:border-stone-800 space-y-4"
    >
      <div
        class="flex flex-col md:flex-row items-center md:justify-between space-y-4 md:space-y-0 text-center md:text-left"
      >
        <p
          class="text-[10px] md:text-xs text-stone-400 font-mono tracking-[0.2em] md:tracking-[0.3em] uppercase"
        >
          2017 <span class="text-amber-500 px-1">⭢</span> 2020 <span
            class="text-amber-500 px-1">⭢</span
          >
          {currentYear}
          <span class="text-amber-500 px-1">⭢</span> ∞ <span
            class="font-light text-stone-500 ml-2">SIC MUNDUS CREATUS EST.</span
          >
        </p>

        <p class="text-xs text-stone-500 tracking-wider">
          Un tributo de fans a <span class="text-stone-300 font-bold">DARK</span
          >. No afiliado con <span class="text-stone-300 font-bold"
            >Netflix</span
          >.
        </p>
      </div>
    </div>
  </div>

  <div
    class="absolute inset-0 bg-amber-900/10 -z-10 blur-3xl rounded-full scale-110 opacity-40 pointer-events-none"
  >
  </div>
</footer>
