              },
            ].map((entry) => (
              <div
                tabindex="0"
                class="glossary-card group relative flex flex-col gap-4 bg-white/80 dark:bg-[#0a0a0a] border border-stone-200 dark:border-stone-800/60 hover:border-amber-500/50 focus-visible:border-amber-500/50 rounded-xl p-6 shadow-lg shadow-stone-300/40 dark:shadow-none hover:-translate-y-1 focus-visible:-translate-y-1 outline-none focus-visible:ring-2 focus-visible:ring-amber-400 transition-all duration-500"
