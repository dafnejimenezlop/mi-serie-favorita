<style>
  .glossary-card:hover,
  .glossary-card:focus-visible {
    box-shadow: 0 0 30px rgba(245, 158, 11, 0.12);
  }
  .group:hover .glossary-icon,
  .group:focus-visible .glossary-icon {
    box-shadow: 0 0 14px rgba(245, 158, 11, 0.3);
  }

  /* Icono "dibujándose" al interactuar — mismo truco que .explore-icon-path
     en Explore.astro (pathLength="1" normaliza cualquier path/circle a
     longitud 1, así el mismo dasharray/dashoffset vale para todos). */
  .glossary-icon-path {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  .group:hover .glossary-icon-path,
  .group:focus-visible .glossary-icon-path {
    animation: glossary-icon-draw 0.6s ease-out;
  }
  @keyframes glossary-icon-draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  /* El símbolo de infinito es un relleno sólido, no un trazo: no se puede
     "dibujar" con dashoffset, así que responde con un pulso en su lugar. */
  .group:hover .glossary-icon-pulse,
  .group:focus-visible .glossary-icon-pulse {
    animation: glossary-icon-pulse 0.5s ease-out;
  }
  @keyframes glossary-icon-pulse {
    0% {
      transform: scale(0.8);
    }
    60% {
      transform: scale(1.15);
    }
    100% {
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .glossary-card {
      transition: none !important;
    }
    .glossary-icon-path,
    .glossary-icon-pulse {
      animation: none !important;
    }
  }

  .mask-right,
  .mask-left {
    -webkit-mask-image: linear-gradient(to bottom, black 50%, transparent 100%);
    mask-image: linear-gradient(to bottom, black 50%, transparent 100%);
  }

  /* El contador de fichas, el hilo conector y la animación de entrada viven
     ahora en global.css: los comparten Resumen, Aclaraciones y Familias, y
     una hoja importada nunca queda acotada por el `data-astro-cid-*` de un
     componente. */
</style>

