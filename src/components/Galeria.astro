---
// src/components/Galeria.astro
import { songs, galleryImages } from '../data/bandaSonora';

// La pieza de apertura hace de ancla del bloque: 18 filas idénticas eran un
// muro sin jerarquía, y la primera canción —el tema de cabecera— es
// justamente la que casi todo el mundo viene buscando.
const destacada = songs[0];
const artistas = new Set(songs.map((s) => s.artist)).size;
---

<div class="pt-40 md:pt-48 pb-24 relative z-10 w-full min-h-screen">
  <div class="container mx-auto px-4 md:px-6 max-w-7xl">
    <div class="text-center space-y-6 mb-12" data-aos="fade-down">
      <h2
        class="text-4xl md:text-6xl font-cinzel text-amber-600 dark:text-amber-500 font-bold tracking-[0.2em] drop-shadow-lg dark:drop-shadow-2xl uppercase"
      >
        Banda Sonora &amp; Galería
      </h2>
      <p
        class="text-base md:text-lg text-stone-700 dark:text-stone-300 font-light leading-relaxed max-w-2xl mx-auto tracking-wide"
      >
        La música elegida con sumo cuidado, escena a escena, y los
        fotogramas que mejor resumen a Winden.
      </p>
    </div>

    <div
      id="galeria-tablist"
      role="tablist"
      aria-label="Banda sonora y galería"
      class="relative grid grid-cols-2 md:flex md:flex-nowrap justify-center gap-1 mb-12 md:mb-16 w-full max-w-xs md:w-fit md:max-w-none mx-auto p-1 rounded-xl md:rounded-full border border-stone-300/60 dark:border-stone-800/80 bg-stone-200/50 dark:bg-stone-900/50 backdrop-blur-sm"
      data-aos="fade-up"
    >
      <div
        id="galeria-tab-pill"
        class="absolute inset-y-1 rounded-lg md:rounded-full bg-amber-500 shadow-[0_2px_12px_-2px_rgba(245,158,11,0.55)] transition-all duration-300 ease-out z-0 opacity-0"
        style="left: 0; width: 0;"
      >
      </div>
      <button
        type="button"
        role="tab"
        aria-selected="true"
        aria-controls="galeria-musica"
        id="tab-galeria-musica"
        class="tab-btn-galeria active relative z-10 inline-flex items-center justify-center min-h-10 md:min-h-9 px-1.5 py-2 md:px-5 md:py-1.5 rounded-lg md:rounded-full font-cinzel font-bold tracking-normal md:tracking-[0.12em] uppercase text-[10px] md:text-xs leading-tight transition-colors duration-300 text-black focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400"
        data-target="galeria-musica"
      >
        Banda Sonora
      </button>
      <button
        type="button"
        role="tab"
        aria-selected="false"
        aria-controls="galeria-fotos"
        id="tab-galeria-fotos"
        class="tab-btn-galeria relative z-10 inline-flex items-center justify-center min-h-10 md:min-h-9 px-1.5 py-2 md:px-5 md:py-1.5 rounded-lg md:rounded-full font-cinzel font-bold tracking-normal md:tracking-[0.12em] uppercase text-[10px] md:text-xs leading-tight transition-colors duration-300 text-stone-600 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400"
        data-target="galeria-fotos"
      >
        Fotografías
      </button>
    </div>

    <!-- ═══════════════ BANDA SONORA ═══════════════
         Antes era un acordeón: cada pista desplegaba su propio reproductor
         dentro de la fila, así que la lista daba saltos de 300 px al abrir y
         cerrar, y ninguna de las 18 canciones tenía más peso que las demás.
         Ahora hay un solo escenario arriba —el mismo patrón maestro/detalle
         que ya usa Recomendaciones— y la lista de abajo solo cambia lo que
         suena. Como el reproductor no se recrea, cambiar de pista es
         instantáneo y la lista nunca se mueve. -->
    <div
      id="galeria-musica"
      role="tabpanel"
      aria-labelledby="tab-galeria-musica"
      tabindex="0"
      class="tab-content-galeria block animate-fade-in focus-visible:outline-none"
    >
      <div class="max-w-6xl mx-auto space-y-10">
        <!-- Escenario -->
        <div
          class="grid grid-cols-1 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] gap-6 lg:gap-8 items-stretch"
          data-aos="fade-up"
        >
          <div
            id="sound-stage"
            data-video-id={destacada.youtubeId}
            class="relative w-full aspect-video rounded-2xl overflow-hidden border border-stone-300/70 dark:border-stone-800 bg-black shadow-2xl shadow-black/40"
          >
            <button
              type="button"
              id="sound-stage-play"
              class="group absolute inset-0 w-full h-full flex items-center justify-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-amber-400"
            >
              <img
                id="sound-stage-cover"
                src={`https://i.ytimg.com/vi/${destacada.youtubeId}/maxresdefault.jpg`}
                alt=""
                loading="lazy"
                decoding="async"
                class="absolute inset-0 w-full h-full object-cover opacity-70 grayscale-[40%] group-hover:opacity-95 group-hover:grayscale-0 transition-all duration-700"
              />
              <span
                class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/25 to-black/40"
                aria-hidden="true"></span>
              <span
                class="relative flex items-center justify-center w-16 h-16 md:w-20 md:h-20 rounded-full border border-amber-500/60 bg-black/60 backdrop-blur-md text-amber-500 shadow-[0_0_30px_-8px_rgba(245,158,11,0.8)] transition-all duration-300 group-hover:bg-amber-500 group-hover:text-black group-hover:scale-110 group-active:scale-95"
                aria-hidden="true"
              >
                <svg
                  class="w-7 h-7 md:w-8 md:h-8 translate-x-0.5"
                  fill="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path d="M8 5v14l11-7z"></path>
                </svg>
              </span>
              <span class="sr-only" id="sound-stage-play-label"
                >Reproducir {destacada.title}, de {destacada.artist}</span
              >
            </button>
            <div id="sound-stage-slot" class="absolute inset-0"></div>
          </div>

          <!-- Ficha de la pista en el escenario -->
          <div
            class="relative flex flex-col justify-between gap-6 rounded-2xl border border-stone-300/70 dark:border-stone-800 bg-white/60 dark:bg-stone-900/40 backdrop-blur-md p-6 md:p-8 shadow-xl"
          >
            <div class="space-y-4">
              <span
                class="inline-flex items-center gap-2 font-mono text-[10px] tracking-[0.28em] uppercase text-amber-700 dark:text-amber-500/90"
              >
                <span
                  class="flex items-end justify-center h-3 gap-[2px] overflow-hidden"
                  aria-hidden="true"
                >
                  <span class="w-[2px] bg-amber-500 h-1.5 animate-audio-bar-1 rounded-sm"
                  ></span>
                  <span class="w-[2px] bg-amber-500 h-3 animate-audio-bar-2 rounded-sm"
                  ></span>
                  <span class="w-[2px] bg-amber-500 h-2 animate-audio-bar-3 rounded-sm"
                  ></span>
                </span>
                <span id="sound-stage-eyebrow">Tema de apertura</span>
              </span>

              <h3
                id="sound-stage-title"
                class="font-cinzel text-2xl md:text-4xl font-bold uppercase tracking-wide text-stone-900 dark:text-white leading-tight"
              >
                {destacada.title}
              </h3>
              <p
                id="sound-stage-artist"
                class="font-mono text-sm tracking-wide text-stone-600 dark:text-stone-400"
              >
                {destacada.artist}
              </p>
              <p
                id="sound-stage-note"
                class="text-sm text-stone-600 dark:text-stone-400 font-light italic leading-relaxed"
              >
                {destacada.note}
              </p>
            </div>

            <div
              class="flex flex-wrap items-center gap-x-5 gap-y-2 pt-5 border-t border-stone-300/70 dark:border-white/10 font-mono text-[10px] md:text-[11px] tracking-[0.2em] uppercase text-stone-500 dark:text-stone-500"
            >
              <span>{songs.length} pistas</span>
              <span aria-hidden="true" class="text-amber-500/50">·</span>
              <span>{artistas} artistas</span>
              <span aria-hidden="true" class="text-amber-500/50">·</span>
              <span class="text-amber-700 dark:text-amber-500/90"
                >Elegida escena a escena</span
              >
            </div>
          </div>
        </div>

        <!-- Lista de pistas: dos columnas en escritorio. La fila ya no se
             despliega, así que la rejilla no se descuadra al reproducir. -->
        <div>
          <div
            class="flex items-center gap-4 mb-4 px-1"
            data-aos="fade-up"
          >
            <h3
              class="font-cinzel text-xs md:text-sm tracking-[0.25em] uppercase text-stone-600 dark:text-stone-400 whitespace-nowrap"
            >
              Todas las pistas
            </h3>
            <div
              class="h-px flex-grow bg-gradient-to-r from-stone-400/60 dark:from-stone-700 to-transparent"
              aria-hidden="true"
            >
            </div>
          </div>

          <ul
            class="grid grid-cols-1 lg:grid-cols-2 gap-x-8 border-t border-stone-200/70 dark:border-stone-800/70"
            data-aos="fade-up"
          >
            {
              songs.map((song, index) => (
                <li class="border-b border-stone-200/70 dark:border-stone-800/70">
                  <button
                    type="button"
                    data-song-play
                    data-song-id={song.youtubeId}
                    data-song-title={song.title}
                    data-song-artist={song.artist}
                    data-song-note={song.note || ''}
                    data-song-index={index + 1}
                    aria-current={index === 0 ? 'true' : 'false'}
                    class="track-row group w-full flex items-center gap-3 md:gap-4 px-2 md:px-3 py-2.5 text-left transition-colors duration-200 hover:bg-amber-500/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-amber-400"
                  >
                    <span class="relative shrink-0 w-6 text-center font-mono text-xs text-stone-400 dark:text-stone-600">
                      <span class="track-row-index group-hover:opacity-0 transition-opacity duration-150">
                        {String(index + 1).padStart(2, '0')}
                      </span>
                      <span
                        class="track-row-eq absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-150 flex items-end justify-center gap-[2px]"
                        aria-hidden="true"
                      >
                        <span class="w-[2.5px] bg-amber-500 h-2 animate-audio-bar-1 rounded-sm" />
                        <span class="w-[2.5px] bg-amber-500 h-3 animate-audio-bar-2 rounded-sm" />
                        <span class="w-[2.5px] bg-amber-500 h-1.5 animate-audio-bar-3 rounded-sm" />
                      </span>
                    </span>

                    {/* La miniatura era `default.jpg` (120x90) mostrada a 48 px:
                        en una pantalla de densidad doble se veía borrosa.
                        `mqdefault` (320x180) es la que corresponde. */}
                    <span class="relative shrink-0 w-12 h-12 rounded-lg overflow-hidden bg-stone-950">
                      <img
                        src={`https://i.ytimg.com/vi/${song.youtubeId}/mqdefault.jpg`}
                        alt=""
                        loading="lazy"
                        decoding="async"
                        width="320"
                        height="180"
                        class="w-full h-full object-cover grayscale-[55%] group-hover:grayscale-0 transition-all duration-300"
                      />
                    </span>

                    <span class="min-w-0 flex-1">
                      <span class="block font-cinzel text-sm md:text-base font-bold text-stone-900 dark:text-white uppercase tracking-wide truncate">
                        {song.title}
                      </span>
                      <span class="block text-xs text-stone-500 dark:text-stone-400 font-mono tracking-wide truncate">
                        {song.artist}
                      </span>
                    </span>

                    {song.note && (
                      <span class="hidden xl:inline-block shrink-0 max-w-[9rem] truncate rounded-full border border-amber-500/30 px-2.5 py-0.5 text-[10px] font-mono uppercase tracking-wide text-amber-700 dark:text-amber-500/80">
                        {song.note}
                      </span>
                    )}

                    <span class="song-toggle-icon shrink-0 w-8 h-8 rounded-full border border-transparent group-hover:border-amber-500/60 flex items-center justify-center text-stone-400 group-hover:text-amber-500 group-hover:bg-amber-500/10 transition-all duration-200">
                      <svg
                        class="w-3.5 h-3.5 translate-x-0.5"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                      >
                        <path d="M8 5v14l11-7z" />
                      </svg>
                    </span>
                  </button>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <!-- ═══════════════ FOTOGRAFÍAS ═══════════════ -->
    <div
      id="galeria-fotos"
      role="tabpanel"
      aria-labelledby="tab-galeria-fotos"
      tabindex="0"
      class="tab-content-galeria hidden animate-fade-in focus-visible:outline-none"
    >
      <div
        class="flex items-center justify-center gap-4 mb-8 md:mb-10 opacity-80"
        data-aos="zoom-in"
      >
        <div class="h-[1px] w-12 md:w-24 bg-gradient-to-r from-transparent to-amber-600" />
        <p class="text-amber-700 dark:text-amber-500 font-mono tracking-widest uppercase text-[10px] md:text-xs font-bold flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14M14 8h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          {galleryImages.length} Fotogramas Archivados
        </p>
        <div class="h-[1px] w-12 md:w-24 bg-gradient-to-l from-transparent to-amber-600" />
      </div>

      {/* grid-flow-dense: las fotos destacadas ocupan 2x2 y, cuando no caben
          en las columnas que quedan de la fila, la colocación automática las
          empuja a la fila siguiente dejando huecos vacíos en el mosaico.
          Con `dense` el navegador retrocede y rellena esos huecos con las
          fotos pequeñas posteriores. */}
      <div class="grid grid-flow-dense grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 auto-rows-[110px] sm:auto-rows-[130px] lg:auto-rows-[150px] gap-2.5 md:gap-3">
        {
          galleryImages.map((image, index) => (
            <button
              type="button"
              data-photo-open
              data-photo-index={index}
              class={`photo-tile group relative overflow-hidden rounded-lg border border-stone-300/70 dark:border-stone-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400 ${image.featured ? 'col-span-2 row-span-2' : ''}`}
              data-aos="fade-up"
              data-aos-delay={Math.min(index * 25, 240)}
            >
              <img
                src={image.src}
                alt={image.alt}
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover grayscale-[25%] group-hover:grayscale-0 scale-100 group-hover:scale-110 transition-all duration-700 ease-out"
              />

              {/* Numeración de hoja de contactos: siempre visible, no solo al
                  pasar el ratón. Refuerza la lectura de archivo y da al
                  mosaico una retícula legible en móvil, donde no hay hover. */}
              <span
                class="absolute top-1.5 left-2 z-10 font-mono text-[10px] tracking-widest text-white/60 group-hover:text-amber-400 transition-colors duration-300 drop-shadow-[0_1px_2px_rgba(0,0,0,0.9)]"
                aria-hidden="true"
              >
                {String(index + 1).padStart(2, '0')}
              </span>

              <span
                aria-hidden="true"
                class="absolute top-2 left-1/2 -translate-x-1/2 w-2 h-2 rounded-full bg-amber-500 shadow-[0_0_6px_rgba(245,158,11,0.9)] opacity-0 group-hover:opacity-100 scale-75 group-hover:scale-100 transition-all duration-300 z-10"
              />

              <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/10 to-black/0 opacity-0 group-hover:opacity-100 transition-opacity duration-300" />

              {/* El pie solo aparecía en `hover`, así que en móvil —donde no
                  existe— ninguna foto tenía descripción visible. Ahora se ve
                  siempre por debajo de `md` y se reserva al hover en
                  escritorio, que es donde el mosaico limpio sí compensa. */}
              <span class="photo-tile-caption absolute inset-x-0 bottom-0 px-3 py-2.5 md:translate-y-2 md:opacity-0 md:group-hover:translate-y-0 md:group-hover:opacity-100 transition-all duration-300">
                <span class="block text-[11px] md:text-xs leading-snug text-stone-100 font-medium line-clamp-2">
                  {image.alt}
                </span>
              </span>

              <div class="absolute bottom-2 right-2 w-7 h-7 rounded-full bg-black/60 border border-amber-500/40 flex items-center justify-center opacity-0 group-hover:opacity-100 scale-90 group-hover:scale-100 transition-all duration-300">
                <svg class="w-3.5 h-3.5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" />
                </svg>
              </div>
            </button>
          ))
        }
      </div>
    </div>
  </div>
</div>

<!-- Visor de fotografías -->
<div
  id="photo-lightbox"
  role="dialog"
  aria-modal="true"
  aria-label="Visor de fotografías"
  aria-hidden="true"
  class="hidden fixed inset-0 z-[120] flex-col items-center justify-center bg-black/95 backdrop-blur-lg opacity-0 transition-opacity duration-500 p-4 pb-28"
>
  <button
    id="photo-lightbox-close"
    aria-label="Cerrar visor"
    class="absolute top-4 right-4 md:top-8 md:right-8 z-10 p-2 bg-stone-900/80 hover:bg-black text-stone-400 hover:text-amber-500 rounded-full transition-all border border-stone-700 hover:border-amber-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400"
  >
    <svg class="w-6 h-6 md:w-8 md:h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>
  <button
    id="photo-lightbox-prev"
    aria-label="Foto anterior"
    class="absolute left-2 md:left-6 top-1/2 -translate-y-1/2 z-10 w-11 h-11 rounded-full bg-stone-900/80 hover:bg-black text-stone-300 hover:text-amber-500 border border-stone-700 hover:border-amber-500 flex items-center justify-center transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400"
  >
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
    </svg>
  </button>
  <button
    id="photo-lightbox-next"
    aria-label="Foto siguiente"
    class="absolute right-2 md:right-6 top-1/2 -translate-y-1/2 z-10 w-11 h-11 rounded-full bg-stone-900/80 hover:bg-black text-stone-300 hover:text-amber-500 border border-stone-700 hover:border-amber-500 flex items-center justify-center transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400"
  >
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
    </svg>
  </button>

  <figure class="flex flex-col items-center gap-4 max-w-full">
    <img
      id="photo-lightbox-img"
      src=""
      alt=""
      class="max-w-full max-h-[68vh] w-auto h-auto rounded-lg shadow-2xl border border-stone-800 object-contain transition-opacity duration-200"
    />
    <figcaption
      id="photo-lightbox-caption"
      class="max-w-xl text-center text-sm md:text-base text-stone-300 font-light leading-relaxed px-4"
    />
  </figure>

  <!-- Tira de contactos: el visor no daba ninguna pista de dónde estabas
       dentro de las 26 fotos ni permitía saltar a una concreta. -->
  <div
    id="photo-lightbox-strip"
    class="absolute inset-x-0 bottom-0 flex items-center gap-2 overflow-x-auto px-4 py-3 bg-gradient-to-t from-black via-black/80 to-transparent custom-scrollbar"
  >
  </div>

  <p
    id="photo-lightbox-counter"
    aria-live="polite"
    class="absolute bottom-24 left-1/2 -translate-x-1/2 font-mono text-[11px] tracking-[0.3em] uppercase text-stone-400 bg-black/60 backdrop-blur-md border border-white/10 rounded-full px-3 py-1"
  />
</div>

<style>
  /* La pista que suena mantiene el ecualizador encendido, no solo en hover. */
  .track-row[aria-current='true'] {
    background-color: color-mix(
      in srgb,
      var(--color-amber-500) 12%,
      transparent
    );
  }
  .track-row[aria-current='true'] .track-row-index {
    opacity: 0 !important;
  }
  .track-row[aria-current='true'] .track-row-eq {
    opacity: 1 !important;
  }
  .track-row[aria-current='true'] .song-toggle-icon {
    border-color: color-mix(in srgb, var(--color-amber-500) 60%, transparent);
    color: var(--color-amber-500);
  }

  .photo-tile-caption {
    background: linear-gradient(to top, rgba(0, 0, 0, 0.85), transparent);
  }

  .strip-thumb {
    flex: 0 0 auto;
    width: 4rem;
    height: 2.5rem;
    border-radius: 0.25rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.15);
    opacity: 0.45;
    transition:
      opacity 0.2s ease,
      border-color 0.2s ease,
      transform 0.2s ease;
  }
  .strip-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .strip-thumb:hover,
  .strip-thumb:focus-visible {
    opacity: 0.85;
    outline: none;
    border-color: rgb(var(--accent-rgb) / 0.6);
  }
  .strip-thumb[aria-current='true'] {
    opacity: 1;
    border-color: rgb(var(--accent-rgb));
    transform: translateY(-2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .track-row,
    .track-row-eq span,
    .photo-tile,
    .photo-tile-caption,
    .strip-thumb,
    [data-photo-open] img,
    [data-photo-open] span {
      transition: none !important;
      transform: none !important;
      animation: none !important;
    }
  }
</style>

<script>
  import { initTabs } from '../scripts/tabs.js';

  document.addEventListener('DOMContentLoaded', () => {
    // ═══════════════ ESCENARIO DE LA BANDA SONORA ═══════════════
    // Un único reproductor para las 18 pistas: se crea la primera vez que
    // alguien pulsa y a partir de ahí solo se le cambia el vídeo, así que
    // saltar de canción no reconstruye ningún iframe.
    const escenario = document.getElementById('sound-stage');
    const botonEscenario = document.getElementById('sound-stage-play');
    const portada = document.getElementById('sound-stage-cover');
    const tituloEscenario = document.getElementById('sound-stage-title');
    const artistaEscenario = document.getElementById('sound-stage-artist');
    const notaEscenario = document.getElementById('sound-stage-note');
    const etiquetaEscenario = document.getElementById('sound-stage-eyebrow');
    const etiquetaBoton = document.getElementById('sound-stage-play-label');
    const filas = Array.from(document.querySelectorAll('[data-song-play]'));

    let reproductor = null;

    function esperarYT(alEstarListo) {
      if (window.YT && window.YT.Player) {
        alEstarListo();
        return;
      }
      // La API ya no se carga sola en cada visita: la pide quien la necesita.
      if (typeof window.cargarYouTubeApi === 'function') {
        window.cargarYouTubeApi();
      }
      window.setTimeout(() => esperarYT(alEstarListo), 200);
    }

    function reproducir(id) {
      if (!escenario) return;
      escenario.dataset.videoId = id;

      if (reproductor && typeof reproductor.loadVideoById === 'function') {
        reproductor.loadVideoById(id);
        return;
      }

      botonEscenario?.classList.add('hidden');
      esperarYT(() => {
        reproductor = new YT.Player('sound-stage-slot', {
          videoId: id,
          playerVars: { autoplay: 1, rel: 0, playsinline: 1 },
        });
      });
    }

    function pintarEscenario(datos) {
      if (tituloEscenario) tituloEscenario.textContent = datos.title;
      if (artistaEscenario) artistaEscenario.textContent = datos.artist;
      if (notaEscenario) {
        notaEscenario.textContent = datos.note || '';
        notaEscenario.classList.toggle('hidden', !datos.note);
      }
      if (etiquetaEscenario) {
        etiquetaEscenario.textContent = `Pista ${String(datos.index).padStart(2, '0')} de ${filas.length}`;
      }
      if (portada) {
        portada.src = `https://i.ytimg.com/vi/${datos.id}/maxresdefault.jpg`;
      }
      if (etiquetaBoton) {
        etiquetaBoton.textContent = `Reproducir ${datos.title}, de ${datos.artist}`;
      }
      filas.forEach((fila) => {
        fila.setAttribute(
          'aria-current',
          fila.dataset.songId === datos.id ? 'true' : 'false',
        );
      });
    }

    filas.forEach((fila) => {
      fila.addEventListener('click', () => {
        pintarEscenario({
          id: fila.dataset.songId,
          title: fila.dataset.songTitle,
          artist: fila.dataset.songArtist,
          note: fila.dataset.songNote,
          index: Number(fila.dataset.songIndex),
        });
        reproducir(fila.dataset.songId);
        escenario?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      });
    });

    botonEscenario?.addEventListener('click', () => {
      reproducir(escenario.dataset.videoId);
    });

    function pararMusica() {
      if (reproductor && typeof reproductor.pauseVideo === 'function') {
        reproductor.pauseVideo();
      }
    }

    // ═══════════════ PESTAÑAS ═══════════════
    window.resetGaleriaTabs = initTabs({
      boton: '.tab-btn-galeria',
      panel: '.tab-content-galeria',
      pastilla: 'galeria-tab-pill',
      inicial: 'galeria-musica',
      alCambiar: (id) => {
        if (id !== 'galeria-musica') pararMusica();
      },
    });

    // ═══════════════ VISOR DE FOTOGRAFÍAS ═══════════════
    const visor = document.getElementById('photo-lightbox');
    if (!visor) return;
    document.body.appendChild(visor);

    const imagenVisor = document.getElementById('photo-lightbox-img');
    const cerrarVisor = document.getElementById('photo-lightbox-close');
    const anteriorVisor = document.getElementById('photo-lightbox-prev');
    const siguienteVisor = document.getElementById('photo-lightbox-next');
    const contador = document.getElementById('photo-lightbox-counter');
    const pie = document.getElementById('photo-lightbox-caption');
    const tira = document.getElementById('photo-lightbox-strip');

    let indiceActual = 0;
    let ultimoFoco = null;

    // La lista de fotos se lee del propio mosaico en vez de serializarse con
    // `define:vars`: eran 11 KB de JSON incrustados en el HTML de cada visita
    // para repetir datos que ya estaban en el DOM.
    const galleryImages = Array.from(
      document.querySelectorAll('[data-photo-open]'),
    ).map((boton) => {
      const img = boton.querySelector('img');
      return { src: img.getAttribute('src'), alt: img.getAttribute('alt') };
    });

    // Tira de contactos: se construye una vez, con miniaturas perezosas.
    galleryImages.forEach((foto, i) => {
      const miniatura = document.createElement('button');
      miniatura.type = 'button';
      miniatura.className = 'strip-thumb';
      miniatura.setAttribute('aria-label', `Ir a la foto ${i + 1}`);
      miniatura.dataset.stripIndex = String(i);
      const img = document.createElement('img');
      img.src = foto.src;
      img.alt = '';
      img.loading = 'lazy';
      img.decoding = 'async';
      miniatura.appendChild(img);
      miniatura.addEventListener('click', () => mostrarFoto(i));
      tira?.appendChild(miniatura);
    });

    const miniaturas = Array.from(
      tira ? tira.querySelectorAll('[data-strip-index]') : [],
    );

    // Precargar vecinas: sin esto, cada salto dejaba el visor en blanco
    // mientras se descargaba la siguiente foto.
    function precargarVecinas(indice) {
      [-1, 1].forEach((salto) => {
        const vecina =
          galleryImages[
            (indice + salto + galleryImages.length) % galleryImages.length
          ];
        if (vecina) new Image().src = vecina.src;
      });
    }

    function mostrarFoto(indice) {
      indiceActual =
        (indice + galleryImages.length) % galleryImages.length;
      const foto = galleryImages[indiceActual];

      imagenVisor.style.opacity = '0';
      const listo = () => {
        imagenVisor.style.opacity = '1';
        imagenVisor.removeEventListener('load', listo);
      };
      imagenVisor.addEventListener('load', listo);
      imagenVisor.src = foto.src;
      imagenVisor.alt = foto.alt;
      if (imagenVisor.complete) listo();

      if (pie) pie.textContent = foto.alt;
      if (contador) {
        contador.textContent = `${indiceActual + 1} / ${galleryImages.length}`;
      }
      miniaturas.forEach((m, i) => {
        m.setAttribute('aria-current', i === indiceActual ? 'true' : 'false');
        if (i === indiceActual) {
          m.scrollIntoView({
            behavior: 'smooth',
            block: 'nearest',
            inline: 'center',
          });
        }
      });
      precargarVecinas(indiceActual);
    }

    function abrirVisor(indice) {
      ultimoFoco = document.activeElement;
      visor.classList.remove('hidden');
      visor.classList.add('flex');
      visor.setAttribute('aria-hidden', 'false');
      document.body.classList.add('scroll-lock');
      mostrarFoto(indice);
      setTimeout(() => visor.classList.remove('opacity-0'), 10);
      cerrarVisor?.focus();
      document.addEventListener('keydown', alPulsarTecla);
    }

    function cerrar() {
      visor.classList.add('opacity-0');
      visor.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('scroll-lock');
      setTimeout(() => {
        visor.classList.add('hidden');
        visor.classList.remove('flex');
      }, 500);
      document.removeEventListener('keydown', alPulsarTecla);
      if (ultimoFoco instanceof HTMLElement) ultimoFoco.focus();
    }

    // Trampa de foco: el visor se declara `aria-modal`, así que el tabulador
    // no puede escaparse a la página de detrás.
    function alPulsarTecla(evento) {
      if (visor.getAttribute('aria-hidden') !== 'false') return;
      if (evento.key === 'Escape') {
        cerrar();
        return;
      }
      if (evento.key === 'ArrowRight') {
        mostrarFoto(indiceActual + 1);
        return;
      }
      if (evento.key === 'ArrowLeft') {
        mostrarFoto(indiceActual - 1);
        return;
      }
      if (evento.key !== 'Tab') return;

      const enfocables = visor.querySelectorAll(
        'button, [href], [tabindex]:not([tabindex="-1"])',
      );
      if (!enfocables.length) return;
      const primero = enfocables[0];
      const ultimo = enfocables[enfocables.length - 1];
      if (evento.shiftKey && document.activeElement === primero) {
        evento.preventDefault();
        ultimo.focus();
      } else if (!evento.shiftKey && document.activeElement === ultimo) {
        evento.preventDefault();
        primero.focus();
      }
    }

    // Gesto de deslizar en móvil, que es donde más se usa un visor de fotos.
    let inicioX = null;
    visor.addEventListener(
      'touchstart',
      (e) => {
        inicioX = e.changedTouches[0].clientX;
      },
      { passive: true },
    );
    visor.addEventListener(
      'touchend',
      (e) => {
        if (inicioX === null) return;
        const recorrido = e.changedTouches[0].clientX - inicioX;
        inicioX = null;
        if (Math.abs(recorrido) < 45) return;
        mostrarFoto(indiceActual + (recorrido < 0 ? 1 : -1));
      },
      { passive: true },
    );

    document.querySelectorAll('[data-photo-open]').forEach((boton) => {
      boton.addEventListener('click', () =>
        abrirVisor(Number(boton.dataset.photoIndex)),
      );
    });
    cerrarVisor?.addEventListener('click', cerrar);
    siguienteVisor?.addEventListener('click', () => mostrarFoto(indiceActual + 1));
    anteriorVisor?.addEventListener('click', () => mostrarFoto(indiceActual - 1));
  });
</script>
