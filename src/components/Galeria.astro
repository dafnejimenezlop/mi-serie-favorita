---
// src/components/Galeria.astro
import { songs, galleryImages } from '../data/bandaSonora';

// La pieza de apertura hace de ancla del bloque: 18 filas idénticas eran un
// muro sin jerarquía, y la primera canción —el tema de cabecera— es
// justamente la que casi todo el mundo viene buscando.
const destacada = songs[0];
const artistas = new Set(songs.map((s) => s.artist)).size;
---

<div class="pt-28 md:pt-40 lg:pt-36 pb-20 md:pb-24 relative z-10 w-full min-h-screen">
  <div class="container mx-auto px-4 md:px-6 max-w-7xl">
    <div class="text-center space-y-6 mb-12" data-aos="fade-down">
      <h2
        class="text-3xl leading-tight sm:text-4xl md:text-6xl font-cinzel text-amber-700 dark:text-amber-500 font-bold tracking-[0.12em] md:tracking-[0.2em] drop-shadow-lg dark:drop-shadow-2xl uppercase"
      >
        Banda Sonora &amp; Galería
      </h2>
      <p
        class="text-base md:text-lg text-stone-700 dark:text-stone-300 font-light leading-relaxed max-w-2xl mx-auto tracking-wide"
      >
        La música elegida con sumo cuidado, escena a escena, y los
        fotogramas que mejor resumen a Winden.
      </p>
    </div>

    <div
      id="galeria-tablist"
      role="tablist"
      aria-label="Banda sonora y galería"
      class="relative grid grid-cols-2 md:flex md:flex-nowrap justify-center gap-1 mb-12 md:mb-16 w-full max-w-xs md:w-fit md:max-w-none mx-auto p-1 rounded-xl md:rounded-full border border-stone-300/60 dark:border-stone-800/80 bg-stone-200/50 dark:bg-stone-900/50 backdrop-blur-sm"
      data-aos="fade-up"
    >
      <div
        id="galeria-tab-pill"
        class="absolute inset-y-1 rounded-lg md:rounded-full bg-amber-500 shadow-[0_2px_12px_-2px_rgba(245,158,11,0.55)] transition-all duration-300 ease-out z-0 opacity-0"
        style="left: 0; width: 0;"
      >
      </div>
      <button
        type="button"
        role="tab"
        aria-selected="true"
        aria-controls="galeria-musica"
        id="tab-galeria-musica"
        class="tab-btn-galeria active relative z-10 inline-flex items-center justify-center min-h-10 md:min-h-9 px-1.5 py-2 md:px-5 md:py-1.5 rounded-lg md:rounded-full font-cinzel font-bold tracking-normal md:tracking-[0.12em] uppercase text-[10px] md:text-xs leading-tight transition-colors duration-300 text-black focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400"
        data-target="galeria-musica"
      >
        Banda Sonora
      </button>
      <button
        type="button"
        role="tab"
        aria-selected="false"
        aria-controls="galeria-fotos"
        id="tab-galeria-fotos"
        class="tab-btn-galeria relative z-10 inline-flex items-center justify-center min-h-10 md:min-h-9 px-1.5 py-2 md:px-5 md:py-1.5 rounded-lg md:rounded-full font-cinzel font-bold tracking-normal md:tracking-[0.12em] uppercase text-[10px] md:text-xs leading-tight transition-colors duration-300 text-stone-600 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400"
        data-target="galeria-fotos"
      >
        Fotografías
      </button>
    </div>

    <!-- ═══════════════ BANDA SONORA ═══════════════
         Antes era un acordeón: cada pista desplegaba su propio reproductor
         dentro de la fila, así que la lista daba saltos de 300 px al abrir y
         cerrar, y ninguna de las 18 canciones tenía más peso que las demás.
         Ahora hay un solo escenario arriba —el mismo patrón maestro/detalle
         que ya usa Recomendaciones— y la lista de abajo solo cambia lo que
         suena. Como el reproductor no se recrea, cambiar de pista es
         instantáneo y la lista nunca se mueve. -->
    <div
      id="galeria-musica"
      role="tabpanel"
      aria-labelledby="tab-galeria-musica"
      tabindex="0"
      class="tab-content-galeria block animate-fade-in focus-visible:outline-none"
    >
      <div class="max-w-6xl mx-auto space-y-10">
        <!-- Escenario -->
        <div
          class="grid grid-cols-1 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] gap-6 lg:gap-8 items-stretch"
          data-aos="fade-up"
        >
          <div
            id="sound-stage"
            data-video-id={destacada.youtubeId}
            class="relative w-full aspect-video rounded-2xl overflow-hidden border border-stone-300/70 dark:border-stone-800 bg-black shadow-2xl shadow-black/40"
          >
            {/* El hueco del reproductor va ANTES que el botón de play. Iba
                después, a pantalla completa del escenario y vacío, así que se
                quedaba por encima del botón y se tragaba los toques: el play
                grande no hacía nada. Y `w-full h-full` es imprescindible:
                YouTube sustituye este div por un iframe con width="640"
                height="360", y `inset-0` no estira un elemento reemplazado;
                en un móvil de 358 px el vídeo salía recortado, con los
                controles y el botón de pantalla completa fuera de la vista. */}
            <div id="sound-stage-slot" class="absolute inset-0 w-full h-full"></div>
            <button
              type="button"
              id="sound-stage-play"
              class="group absolute inset-0 w-full h-full flex items-center justify-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-amber-400"
            >
              {/* Era `maxresdefault`, que YouTube no genera para todos los
                  vídeos (6 de las 18 pistas, incluida la de apertura): en esos
                  casos responde 404 con una imagen gris de 120x90 que se
                  estiraba a todo el escenario — lo primero que se veía al
                  entrar en Galería. `hqdefault` existe siempre que existe el
                  vídeo, y a la opacidad y el gris de esta portada no se
                  distingue de la de mayor resolución. */}
              <img
                id="sound-stage-cover"
                src={`https://i.ytimg.com/vi/${destacada.youtubeId}/hqdefault.jpg`}
                alt=""
                loading="lazy"
                decoding="async"
                class="absolute inset-0 w-full h-full object-cover opacity-70 grayscale-[40%] group-hover:opacity-95 group-hover:grayscale-0 transition-all duration-700"
              />
              <span
                class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/25 to-black/40"
                aria-hidden="true"></span>
              <span
                class="relative flex items-center justify-center w-16 h-16 md:w-20 md:h-20 rounded-full border border-amber-500/60 bg-black/60 backdrop-blur-md text-amber-500 shadow-[0_0_30px_-8px_rgba(245,158,11,0.8)] transition-all duration-300 group-hover:bg-amber-500 group-hover:text-black group-hover:scale-110 group-active:scale-95"
                aria-hidden="true"
              >
                <svg
                  class="w-7 h-7 md:w-8 md:h-8 translate-x-0.5"
                  fill="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path d="M8 5v14l11-7z"></path>
                </svg>
              </span>
              <span class="sr-only" id="sound-stage-play-label"
                >Reproducir {destacada.title}, de {destacada.artist}</span
              >
            </button>
          </div>

          <!-- Ficha de la pista en el escenario -->
          <div
            class="relative flex flex-col justify-between gap-6 rounded-2xl border border-stone-300/70 dark:border-stone-800 bg-white/60 dark:bg-stone-900/40 backdrop-blur-md p-6 md:p-8 shadow-xl"
          >
            <div class="space-y-4">
              <span
                class="inline-flex items-center gap-2 font-mono text-[10px] tracking-[0.28em] uppercase text-amber-700 dark:text-amber-500/90"
              >
                <span
                  class="flex items-end justify-center h-3 gap-[2px] overflow-hidden"
                  aria-hidden="true"
                >
                  <span class="w-[2px] bg-amber-500 h-1.5 animate-audio-bar-1 rounded-sm"
                  ></span>
                  <span class="w-[2px] bg-amber-500 h-3 animate-audio-bar-2 rounded-sm"
                  ></span>
                  <span class="w-[2px] bg-amber-500 h-2 animate-audio-bar-3 rounded-sm"
                  ></span>
                </span>
                <span id="sound-stage-eyebrow">Tema de apertura</span>
              </span>

              <h3
                id="sound-stage-title"
                class="font-cinzel text-2xl md:text-4xl font-bold uppercase tracking-wide text-stone-900 dark:text-white leading-tight"
              >
                {destacada.title}
              </h3>
              <p
                id="sound-stage-artist"
                class="font-mono text-sm tracking-wide text-stone-600 dark:text-stone-400"
              >
                {destacada.artist}
              </p>
              <p
                id="sound-stage-note"
                class="text-sm text-stone-600 dark:text-stone-400 font-light italic leading-relaxed"
              >
                {destacada.note}
              </p>
            </div>

            <div
              class="flex flex-wrap items-center gap-x-5 gap-y-2 pt-5 border-t border-stone-300/70 dark:border-white/10 font-mono text-[10px] md:text-[11px] tracking-[0.2em] uppercase text-stone-600 dark:text-stone-400"
            >
              <span>{songs.length} pistas</span>
              <span aria-hidden="true" class="text-amber-500/50">·</span>
              <span>{artistas} artistas</span>
              <span aria-hidden="true" class="text-amber-500/50">·</span>
              <span class="text-amber-800 dark:text-amber-500"
                >Elegida escena a escena</span
              >
            </div>
          </div>
        </div>

        <!-- Lista de pistas: dos columnas en escritorio. La fila ya no se
             despliega, así que la rejilla no se descuadra al reproducir. -->
        <div>
          <div
            class="flex items-center gap-4 mb-4 px-1"
            data-aos="fade-up"
          >
            <h3
              class="font-cinzel text-xs md:text-sm tracking-[0.25em] uppercase text-stone-600 dark:text-stone-400 whitespace-nowrap"
            >
              Todas las pistas
            </h3>
            <div
              class="h-px flex-grow bg-gradient-to-r from-stone-400/60 dark:from-stone-700 to-transparent"
              aria-hidden="true"
            >
            </div>
          </div>

          <ul
            class="grid grid-cols-1 lg:grid-cols-2 gap-x-8 border-t border-stone-200/70 dark:border-stone-800/70"
            data-aos="fade-up"
          >
            {
              songs.map((song, index) => (
                <li class="border-b border-stone-200/70 dark:border-stone-800/70">
                  <button
                    type="button"
                    data-song-play
                    data-song-id={song.youtubeId}
                    data-song-title={song.title}
                    data-song-artist={song.artist}
                    data-song-note={song.note || ''}
                    data-song-index={index + 1}
                    aria-current={index === 0 ? 'true' : 'false'}
                    class="track-row group w-full flex items-center gap-3 md:gap-4 px-2 md:px-3 py-2.5 text-left transition-colors duration-200 hover:bg-amber-500/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-amber-400"
                  >
                    <span class="relative shrink-0 w-6 text-center font-mono text-xs text-stone-600 dark:text-stone-400">
                      <span class="track-row-index group-hover:opacity-0 transition-opacity duration-150">
                        {String(index + 1).padStart(2, '0')}
                      </span>
                      <span
                        class="track-row-eq absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-150 flex items-end justify-center gap-[2px]"
                        aria-hidden="true"
                      >
                        <span class="w-[2.5px] bg-amber-500 h-2 animate-audio-bar-1 rounded-sm" />
                        <span class="w-[2.5px] bg-amber-500 h-3 animate-audio-bar-2 rounded-sm" />
                        <span class="w-[2.5px] bg-amber-500 h-1.5 animate-audio-bar-3 rounded-sm" />
                      </span>
                    </span>

                    {/* La miniatura era `default.jpg` (120x90) mostrada a 48 px:
                        en una pantalla de densidad doble se veía borrosa.
                        `mqdefault` (320x180) es la que corresponde. */}
                    <span class="relative shrink-0 w-12 h-12 rounded-lg overflow-hidden bg-stone-950">
                      <img
                        src={`https://i.ytimg.com/vi/${song.youtubeId}/mqdefault.jpg`}
                        alt=""
                        loading="lazy"
                        decoding="async"
                        width="320"
                        height="180"
                        class="w-full h-full object-cover grayscale-[55%] group-hover:grayscale-0 transition-all duration-300"
                      />
                    </span>

                    <span class="min-w-0 flex-1">
                      <span class="block font-cinzel text-sm md:text-base font-bold text-stone-900 dark:text-white uppercase tracking-wide truncate">
                        {song.title}
                      </span>
                      <span class="block text-xs text-stone-600 dark:text-stone-400 font-mono tracking-wide truncate">
                        {song.artist}
                      </span>
                    </span>

                    {song.note && (
                      <span class="hidden xl:inline-block shrink-0 max-w-[9rem] truncate rounded-full border border-amber-500/30 px-2.5 py-0.5 text-[10px] font-mono uppercase tracking-wide text-amber-800 dark:text-amber-500">
                        {song.note}
                      </span>
                    )}

                    <span class="song-toggle-icon shrink-0 w-8 h-8 rounded-full border border-transparent group-hover:border-amber-500/60 flex items-center justify-center text-stone-400 group-hover:text-amber-500 group-hover:bg-amber-500/10 transition-all duration-200">
                      <svg
                        class="w-3.5 h-3.5 translate-x-0.5"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                      >
                        <path d="M8 5v14l11-7z" />
                      </svg>
                    </span>
                  </button>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <!-- ═══════════════ FOTOGRAFÍAS ═══════════════ -->
    <div
      id="galeria-fotos"
      role="tabpanel"
      aria-labelledby="tab-galeria-fotos"
      tabindex="0"
      class="tab-content-galeria hidden animate-fade-in focus-visible:outline-none"
    >
      <div
        class="flex items-center justify-center gap-4 mb-8 md:mb-10"
        data-aos="zoom-in"
      >
        <div class="h-[1px] w-12 md:w-24 bg-gradient-to-r from-transparent to-amber-600" />
        <p class="text-amber-800 dark:text-amber-500 font-mono tracking-widest uppercase text-[10px] md:text-xs font-bold flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14M14 8h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          {galleryImages.length} Fotogramas Archivados
        </p>
        <div class="h-[1px] w-12 md:w-24 bg-gradient-to-l from-transparent to-amber-600" />
      </div>

      {/* grid-flow-dense: las fotos destacadas ocupan 2x2 y, cuando no caben
          en las columnas que quedan de la fila, la colocación automática las
          empuja a la fila siguiente dejando huecos vacíos en el mosaico.
          Con `dense` el navegador retrocede y rellena esos huecos con las
          fotos pequeñas posteriores. */}
      <div class="grid grid-flow-dense grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 auto-rows-[110px] sm:auto-rows-[130px] lg:auto-rows-[150px] gap-2.5 md:gap-3">
        {
          galleryImages.map((image, index) => (
            <button
              type="button"
              data-photo-open
              data-photo-index={index}
              class={`photo-tile group relative overflow-hidden rounded-lg border border-stone-300/70 dark:border-stone-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400 ${image.featured ? 'col-span-2 row-span-2' : ''}`}
              data-aos="fade-up"
              data-aos-delay={Math.min(index * 25, 240)}
            >
              <img
                src={image.src}
                alt={image.alt}
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover grayscale-[25%] group-hover:grayscale-0 scale-100 group-hover:scale-110 transition-all duration-700 ease-out"
              />

              {/* Numeración de hoja de contactos: siempre visible, no solo al
                  pasar el ratón. Refuerza la lectura de archivo y da al
                  mosaico una retícula legible en móvil, donde no hay hover. */}
              <span
                class="absolute top-1.5 left-2 z-10 font-mono text-[10px] tracking-widest text-white/60 group-hover:text-amber-400 transition-colors duration-300 drop-shadow-[0_1px_2px_rgba(0,0,0,0.9)]"
                aria-hidden="true"
              >
                {String(index + 1).padStart(2, '0')}
              </span>

              <span
                aria-hidden="true"
                class="absolute top-2 left-1/2 -translate-x-1/2 w-2 h-2 rounded-full bg-amber-500 shadow-[0_0_6px_rgba(245,158,11,0.9)] opacity-0 group-hover:opacity-100 scale-75 group-hover:scale-100 transition-all duration-300 z-10"
              />

              <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/10 to-black/0 opacity-0 group-hover:opacity-100 transition-opacity duration-300" />

              {/* En móvil el pie solo se queda en las fotos destacadas (2x2).
                  En las pequeñas, de 110 px de alto, cuatro líneas de texto
                  tapaban la foto casi entera; su descripción completa ya se
                  lee en el visor al abrirla. En escritorio aparece al pasar
                  el ratón, como antes. */}
              <span class={`photo-tile-caption ${image.featured ? 'block' : 'hidden md:block'} absolute inset-x-0 bottom-0 px-3 py-2.5 md:translate-y-2 md:opacity-0 md:group-hover:translate-y-0 md:group-hover:opacity-100 transition-all duration-300`}>
                <span class="block text-[11px] md:text-xs leading-snug text-stone-100 font-medium line-clamp-2">
                  {image.alt}
                </span>
              </span>

              <div class="absolute bottom-2 right-2 w-7 h-7 rounded-full bg-black/60 border border-amber-500/40 flex items-center justify-center opacity-0 group-hover:opacity-100 scale-90 group-hover:scale-100 transition-all duration-300">
                <svg class="w-3.5 h-3.5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" />
                </svg>
              </div>
            </button>
          ))
        }
      </div>
    </div>
  </div>
</div>

<!-- Visor de fotografías.
     Rehecho para móvil, que es donde más se usa: la foto ocupaba 358x204 px
     en medio de una pantalla negra, con las flechas encima de la imagen, y la
     tira de miniaturas medía 5x3 px por miniatura (sus estilos vivían en el
     <style> acotado del componente y las miniaturas se crean por JS, sin el
     atributo de Astro, así que nunca casaban). Ahora:
       - escenario a pantalla completa en tres franjas (barra · foto · pie),
         con la foto de borde a borde en móvil;
       - las fotos van en un carril con scroll-snap: el deslizamiento es el
         nativo del navegador (inercia incluida), sin gestos a mano;
       - doble toque (o clic con ratón) amplía la foto y se recorre con el
         scroll nativo del propio marco;
       - flechas y tira de miniaturas solo en escritorio; en móvil el
         contador y el gesto bastan, y la tira descargaba ocho fotos enteras
         solo para pintar miniaturas. -->
<div
  id="photo-lightbox"
  role="dialog"
  aria-modal="true"
  aria-label="Visor de fotografías"
  aria-hidden="true"
  class="hidden fixed inset-0 z-[120] flex-col bg-black opacity-0 transition-opacity duration-300"
>
  <div
    class="relative z-10 shrink-0 flex items-center justify-between gap-4 px-3 md:px-8 pt-[max(0.75rem,env(safe-area-inset-top))] md:pt-6 pb-2 visor-barra"
  >
    <p
      id="photo-lightbox-counter"
      aria-live="polite"
      class="pl-2 font-mono text-[11px] tracking-[0.3em] uppercase text-stone-400 tabular-nums"
    >
    </p>
    <button
      id="photo-lightbox-close"
      aria-label="Cerrar visor"
      class="w-11 h-11 flex items-center justify-center rounded-full bg-white/5 border border-white/10 text-stone-300 hover:text-amber-500 hover:border-amber-500/60 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <div class="relative flex-1 min-h-0">
    <div
      id="photo-lightbox-track"
      class="photo-track absolute inset-0 flex overflow-x-auto overflow-y-hidden snap-x snap-mandatory overscroll-contain"
    >
    </div>
    <button
      id="photo-lightbox-prev"
      aria-label="Foto anterior"
      class="hidden md:flex absolute left-4 lg:left-8 top-1/2 -translate-y-1/2 z-10 w-12 h-12 rounded-full bg-black/60 hover:bg-black text-stone-300 hover:text-amber-500 border border-white/10 hover:border-amber-500/60 items-center justify-center transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
    </button>
    <button
      id="photo-lightbox-next"
      aria-label="Foto siguiente"
      class="hidden md:flex absolute right-4 lg:right-8 top-1/2 -translate-y-1/2 z-10 w-12 h-12 rounded-full bg-black/60 hover:bg-black text-stone-300 hover:text-amber-500 border border-white/10 hover:border-amber-500/60 items-center justify-center transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </button>
  </div>

  <div
    class="relative z-10 shrink-0 px-5 md:px-8 pt-3 pb-[max(0.875rem,env(safe-area-inset-bottom))] md:pb-6 space-y-3 visor-pie"
  >
    <p
      id="photo-lightbox-caption"
      class="max-w-2xl mx-auto text-center text-sm md:text-base text-stone-200 font-light leading-relaxed min-h-[2.75rem] md:min-h-0 line-clamp-3"
    >
    </p>
    <div
      id="photo-lightbox-strip"
      class="photo-strip hidden md:flex gap-2 overflow-x-auto py-1 justify-center-safe"
    >
    </div>
    <p
      id="photo-lightbox-hint"
      class="md:hidden text-center font-mono text-[9px] tracking-[0.25em] uppercase text-stone-400"
      aria-hidden="true"
    >
      Desliza para cambiar · Doble toque para ampliar
    </p>
  </div>
</div>

<style>
  /* La pista que suena mantiene el ecualizador encendido, no solo en hover. */
  .track-row[aria-current='true'] {
    background-color: color-mix(
      in srgb,
      var(--color-amber-500) 12%,
      transparent
    );
  }
  .track-row[aria-current='true'] .track-row-index {
    opacity: 0 !important;
  }
  .track-row[aria-current='true'] .track-row-eq {
    opacity: 1 !important;
  }
  .track-row[aria-current='true'] .song-toggle-icon {
    border-color: color-mix(in srgb, var(--color-amber-500) 60%, transparent);
    color: var(--color-amber-500);
  }

  .photo-tile-caption {
    background: linear-gradient(to top, rgba(0, 0, 0, 0.85), transparent);
  }

  /* ===== Visor =====
     Las diapositivas y las miniaturas se crean por JS y no llevan el
     atributo `data-astro-cid-*`: sus reglas van con :global() colgando del
     visor (que sí lo lleva), o no casarían nunca. */
  #photo-lightbox :global(.photo-track),
  #photo-lightbox :global(.photo-strip) {
    scrollbar-width: none;
  }
  #photo-lightbox :global(.photo-track::-webkit-scrollbar),
  #photo-lightbox :global(.photo-strip::-webkit-scrollbar) {
    display: none;
  }

  #photo-lightbox :global(.photo-slide) {
    flex: 0 0 100%;
    width: 100%;
    height: 100%;
    scroll-snap-align: center;
    scroll-snap-stop: always;
    display: grid;
    overflow: hidden;
  }
  @media (min-width: 768px) {
    #photo-lightbox :global(.photo-slide) {
      padding: 0 6rem;
    }
  }
  /* `margin: auto` dentro de un grid centra la foto cuando es más pequeña
     que el marco y, a diferencia de `place-items: center`, no la recorta
     por arriba/izquierda cuando al ampliarla pasa a ser más grande. */
  #photo-lightbox :global(.photo-slide img) {
    margin: auto;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    user-select: none;
    -webkit-user-drag: none;
    touch-action: manipulation;
    cursor: zoom-in;
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  @media (min-width: 768px) {
    #photo-lightbox :global(.photo-slide img) {
      border-radius: 0.5rem;
    }
  }
  #photo-lightbox :global(.photo-slide img.is-loaded) {
    opacity: 1;
  }
  #photo-lightbox :global(.photo-slide.is-zoomed) {
    overflow: auto;
    overscroll-behavior: contain;
    padding: 0;
    scrollbar-width: none;
  }
  #photo-lightbox :global(.photo-slide.is-zoomed img) {
    width: var(--zoom-w);
    max-width: none;
    max-height: none;
    border-radius: 0;
    cursor: zoom-out;
  }
  /* Con una foto ampliada el carril no debe deslizar: el gesto es para
     recorrer la foto, no para cambiar de foto. */
  #photo-lightbox.zoom-activo :global(.photo-track) {
    overflow-x: hidden;
  }

  #photo-lightbox :global(.strip-thumb) {
    flex: 0 0 auto;
    width: 4.5rem;
    height: 2.75rem;
    border-radius: 0.375rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.15);
    opacity: 0.45;
    transition:
      opacity 0.2s ease,
      border-color 0.2s ease,
      transform 0.2s ease;
  }
  #photo-lightbox :global(.strip-thumb img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  #photo-lightbox :global(.strip-thumb:hover),
  #photo-lightbox :global(.strip-thumb:focus-visible) {
    opacity: 0.85;
    outline: none;
    border-color: rgb(var(--accent-rgb) / 0.6);
  }
  #photo-lightbox :global(.strip-thumb[aria-current='true']) {
    opacity: 1;
    border-color: rgb(var(--accent-rgb));
    transform: translateY(-2px);
  }

  /* Móvil en horizontal: la altura es lo escaso. Fuera la pista de gestos
     y la leyenda a una línea, para que la foto se lleve casi toda la
     pantalla. */
  @media (max-height: 500px) {
    #photo-lightbox-hint,
    #photo-lightbox-strip {
      display: none;
    }
    .visor-barra {
      padding-top: 0.5rem;
      padding-bottom: 0;
    }
    .visor-pie {
      padding-top: 0.5rem;
      padding-bottom: 0.75rem;
    }
    #photo-lightbox-caption {
      -webkit-line-clamp: 1;
      line-clamp: 1;
      min-height: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .track-row,
    .track-row-eq span,
    .photo-tile,
    .photo-tile-caption,
    #photo-lightbox :global(.strip-thumb),
    #photo-lightbox :global(.photo-slide img),
    [data-photo-open] img,
    [data-photo-open] span {
      transition: none !important;
      transform: none !important;
      animation: none !important;
    }
  }
</style>

<script>
  import { initTabs } from '../scripts/tabs.js';

  document.addEventListener('DOMContentLoaded', () => {
    // ═══════════════ ESCENARIO DE LA BANDA SONORA ═══════════════
    // Un único reproductor para las 18 pistas: se crea la primera vez que
    // alguien pulsa y a partir de ahí solo se le cambia el vídeo, así que
    // saltar de canción no reconstruye ningún iframe.
    const escenario = document.getElementById('sound-stage');
    const botonEscenario = document.getElementById('sound-stage-play');
    const portada = document.getElementById('sound-stage-cover');
    const tituloEscenario = document.getElementById('sound-stage-title');
    const artistaEscenario = document.getElementById('sound-stage-artist');
    const notaEscenario = document.getElementById('sound-stage-note');
    const etiquetaEscenario = document.getElementById('sound-stage-eyebrow');
    const etiquetaBoton = document.getElementById('sound-stage-play-label');
    const filas = Array.from(document.querySelectorAll('[data-song-play]'));

    let reproductor = null;

    function esperarYT(alEstarListo) {
      if (window.YT && window.YT.Player) {
        alEstarListo();
        return;
      }
      // La API ya no se carga sola en cada visita: la pide quien la necesita.
      if (typeof window.cargarYouTubeApi === 'function') {
        window.cargarYouTubeApi();
      }
      window.setTimeout(() => esperarYT(alEstarListo), 200);
    }

    function reproducir(id) {
      if (!escenario) return;
      escenario.dataset.videoId = id;

      if (reproductor && typeof reproductor.loadVideoById === 'function') {
        reproductor.loadVideoById(id);
        return;
      }

      botonEscenario?.classList.add('hidden');
      esperarYT(() => {
        reproductor = new YT.Player('sound-stage-slot', {
          videoId: id,
          width: '100%',
          height: '100%',
          playerVars: { autoplay: 1, rel: 0, playsinline: 1 },
        });
      });
    }

    function pintarEscenario(datos) {
      if (tituloEscenario) tituloEscenario.textContent = datos.title;
      if (artistaEscenario) artistaEscenario.textContent = datos.artist;
      if (notaEscenario) {
        notaEscenario.textContent = datos.note || '';
        notaEscenario.classList.toggle('hidden', !datos.note);
      }
      if (etiquetaEscenario) {
        etiquetaEscenario.textContent = `Pista ${String(datos.index).padStart(2, '0')} de ${filas.length}`;
      }
      if (portada) {
        portada.src = `https://i.ytimg.com/vi/${datos.id}/hqdefault.jpg`;
      }
      if (etiquetaBoton) {
        etiquetaBoton.textContent = `Reproducir ${datos.title}, de ${datos.artist}`;
      }
      filas.forEach((fila) => {
        fila.setAttribute(
          'aria-current',
          fila.dataset.songId === datos.id ? 'true' : 'false',
        );
      });
    }

    filas.forEach((fila) => {
      fila.addEventListener('click', () => {
        pintarEscenario({
          id: fila.dataset.songId,
          title: fila.dataset.songTitle,
          artist: fila.dataset.songArtist,
          note: fila.dataset.songNote,
          index: Number(fila.dataset.songIndex),
        });
        reproducir(fila.dataset.songId);
        escenario?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      });
    });

    botonEscenario?.addEventListener('click', () => {
      reproducir(escenario.dataset.videoId);
    });

    function pararMusica() {
      if (reproductor && typeof reproductor.pauseVideo === 'function') {
        reproductor.pauseVideo();
      }
    }

    // ═══════════════ PESTAÑAS ═══════════════
    window.resetGaleriaTabs = initTabs({
      boton: '.tab-btn-galeria',
      panel: '.tab-content-galeria',
      pastilla: 'galeria-tab-pill',
      inicial: 'galeria-musica',
      alCambiar: (id) => {
        if (id !== 'galeria-musica') pararMusica();
      },
    });

    // ═══════════════ VISOR DE FOTOGRAFÍAS ═══════════════
    const visor = document.getElementById('photo-lightbox');
    if (!visor) return;
    document.body.appendChild(visor);

    const carril = document.getElementById('photo-lightbox-track');
    const cerrarVisor = document.getElementById('photo-lightbox-close');
    const anteriorVisor = document.getElementById('photo-lightbox-prev');
    const siguienteVisor = document.getElementById('photo-lightbox-next');
    const contador = document.getElementById('photo-lightbox-counter');
    const pie = document.getElementById('photo-lightbox-caption');
    const tira = document.getElementById('photo-lightbox-strip');
    const sinMovimiento = window.matchMedia(
      '(prefers-reduced-motion: reduce)',
    ).matches;

    let indiceActual = 0;
    let ultimoFoco = null;

    // La lista de fotos se lee del propio mosaico en vez de serializarse con
    // `define:vars`: eran 11 KB de JSON incrustados en el HTML de cada visita
    // para repetir datos que ya estaban en el DOM.
    const galleryImages = Array.from(
      document.querySelectorAll('[data-photo-open]'),
    ).map((boton) => {
      const img = boton.querySelector('img');
      return { src: img.getAttribute('src'), alt: img.getAttribute('alt') };
    });
    const total = galleryImages.length;

    // Diapositivas y tira se construyen la PRIMERA vez que se abre el visor.
    // Construirlas al cargar la página (y asignar `src` antes que
    // `loading = 'lazy'`) hacía que las 25 fotos a tamaño completo (~4,4 MB)
    // bajasen en CUALQUIER vista aunque nadie abriese la galería. Ahora cada
    // diapositiva guarda su ruta en `data-src` y solo se descargan la foto
    // visible y sus dos vecinas.
    let diapositivas = [];
    let miniaturas = [];
    function construirVisor() {
      if (diapositivas.length || !carril) return;
      galleryImages.forEach((foto, i) => {
        const diapositiva = document.createElement('div');
        diapositiva.className = 'photo-slide';
        diapositiva.setAttribute('role', 'group');
        diapositiva.setAttribute('aria-roledescription', 'diapositiva');
        diapositiva.setAttribute('aria-label', `${i + 1} de ${total}`);
        const img = document.createElement('img');
        img.alt = foto.alt;
        img.decoding = 'async';
        img.draggable = false;
        img.dataset.src = foto.src;
        img.addEventListener('load', () => img.classList.add('is-loaded'));
        diapositiva.appendChild(img);
        carril.appendChild(diapositiva);

        if (!tira) return;
        const miniatura = document.createElement('button');
        miniatura.type = 'button';
        miniatura.className = 'strip-thumb';
        miniatura.setAttribute('aria-label', `Ir a la foto ${i + 1}`);
        const mini = document.createElement('img');
        mini.loading = 'lazy';
        mini.decoding = 'async';
        mini.alt = '';
        mini.src = foto.src;
        miniatura.appendChild(mini);
        miniatura.addEventListener('click', () => irA(i));
        tira.appendChild(miniatura);
      });
      diapositivas = Array.from(carril.children);
      miniaturas = tira ? Array.from(tira.children) : [];
    }

    function cargar(indice) {
      const img = diapositivas[(indice + total) % total]?.querySelector('img');
      if (img && !img.getAttribute('src')) img.src = img.dataset.src;
    }

    // Pinta todo lo que depende de la foto visible. Se llama tanto al pulsar
    // (flechas, tira, teclado) como al deslizar con el dedo.
    function actualizar(indice) {
      indiceActual = indice;
      [indice, indice + 1, indice - 1].forEach(cargar);
      if (contador) {
        contador.textContent = `${String(indice + 1).padStart(2, '0')} / ${total}`;
      }
      if (pie) pie.textContent = galleryImages[indice].alt;
      diapositivas.forEach((d, i) =>
        d.setAttribute('aria-hidden', i === indice ? 'false' : 'true'),
      );
      miniaturas.forEach((m, i) => {
        const activa = i === indice;
        m.setAttribute('aria-current', activa ? 'true' : 'false');
        if (activa && tira && tira.offsetParent !== null) {
          tira.scrollTo({
            left: m.offsetLeft - tira.clientWidth / 2 + m.offsetWidth / 2,
            behavior: sinMovimiento ? 'auto' : 'smooth',
          });
        }
      });
    }

    function irA(indice, instantaneo = false) {
      const destino = (indice + total) % total;
      desampliar();
      // Los saltos de más de una foto (la tira, o dar la vuelta de la última
      // a la primera) van sin animación: un deslizamiento suave cruzaría
      // diapositivas vacías que aún no se han descargado.
      const lejos = Math.abs(destino - indiceActual) > 1;
      carril.scrollTo({
        left: destino * carril.clientWidth,
        behavior: instantaneo || lejos || sinMovimiento ? 'auto' : 'smooth',
      });
      actualizar(destino);
    }

    // Deslizar con el dedo: el carril hace scroll nativo y aquí solo se
    // traduce la posición a índice, como mucho una vez por frame.
    let frameCarril = null;
    carril?.addEventListener(
      'scroll',
      () => {
        if (frameCarril) return;
        frameCarril = requestAnimationFrame(() => {
          frameCarril = null;
          if (!carril.clientWidth) return;
          const indice = Math.round(carril.scrollLeft / carril.clientWidth);
          if (indice !== indiceActual && indice >= 0 && indice < total) {
            actualizar(indice);
          }
        });
      },
      { passive: true },
    );

    // ===== Ampliar =====
    // La foto ampliada se agranda DENTRO de su diapositiva, que pasa a hacer
    // scroll en los dos ejes: recorrerla es el scroll nativo (con inercia),
    // sin matemáticas de arrastre. Se amplía hacia el punto tocado.
    function ampliar(diapositiva, x, y) {
      const img = diapositiva.querySelector('img');
      if (!img || !img.classList.contains('is-loaded')) return;
      const caja = img.getBoundingClientRect();
      const marco = diapositiva.getBoundingClientRect();
      const rx = Math.min(Math.max((x - caja.left) / caja.width, 0), 1);
      const ry = Math.min(Math.max((y - caja.top) / caja.height, 0), 1);
      const ancho = Math.round(caja.width * (marco.width < 768 ? 2.5 : 2));
      diapositiva.style.setProperty('--zoom-w', `${ancho}px`);
      diapositiva.classList.add('is-zoomed');
      visor.classList.add('zoom-activo');
      const nueva = img.getBoundingClientRect();
      diapositiva.scrollLeft = rx * nueva.width - (x - marco.left);
      diapositiva.scrollTop = ry * nueva.height - (y - marco.top);
    }

    function desampliar() {
      diapositivas.forEach((d) => {
        if (!d.classList.contains('is-zoomed')) return;
        d.classList.remove('is-zoomed');
        d.scrollLeft = 0;
        d.scrollTop = 0;
      });
      visor.classList.remove('zoom-activo');
    }

    function alternarZoom(diapositiva, x, y) {
      if (diapositiva.classList.contains('is-zoomed')) desampliar();
      else ampliar(diapositiva, x, y);
    }

    // Ratón: clic en la foto amplía, clic en el fondo negro cierra.
    // Táctil: doble toque amplía (o vuelve), y un toque suelto no hace nada,
    // para que un roce al deslizar no cierre el visor.
    // El tipo de puntero se anota en `pointerdown`: no todos los navegadores
    // exponen `pointerType` en el evento `click`.
    let tipoPuntero = 'mouse';
    carril?.addEventListener('pointerdown', (evento) => {
      tipoPuntero = evento.pointerType;
    });
    let ultimoToque = { t: 0, x: 0, y: 0 };
    carril?.addEventListener('pointerup', (evento) => {
      if (evento.pointerType !== 'touch') return;
      const diapositiva = evento.target.closest('.photo-slide');
      if (!diapositiva) return;
      const ahora = performance.now();
      const cerca =
        Math.abs(evento.clientX - ultimoToque.x) < 30 &&
        Math.abs(evento.clientY - ultimoToque.y) < 30;
      if (ahora - ultimoToque.t < 320 && cerca) {
        alternarZoom(diapositiva, evento.clientX, evento.clientY);
        ultimoToque = { t: 0, x: 0, y: 0 };
      } else {
        ultimoToque = { t: ahora, x: evento.clientX, y: evento.clientY };
      }
    });
    carril?.addEventListener('click', (evento) => {
      if (tipoPuntero !== 'mouse') return;
      const diapositiva = evento.target.closest('.photo-slide');
      if (!diapositiva) return;
      if (evento.target.tagName === 'IMG') {
        alternarZoom(diapositiva, evento.clientX, evento.clientY);
      } else if (!diapositiva.classList.contains('is-zoomed')) {
        cerrar();
      }
    });

    // ===== Abrir y cerrar =====
    function recolocar() {
      if (visor.getAttribute('aria-hidden') !== 'false') return;
      carril.scrollLeft = indiceActual * carril.clientWidth;
    }

    function abrirVisor(indice) {
      ultimoFoco = document.activeElement;
      construirVisor();
      visor.classList.remove('hidden');
      visor.classList.add('flex');
      visor.setAttribute('aria-hidden', 'false');
      document.body.classList.add('scroll-lock');
      // Ya visible (con medidas reales), se coloca el carril en la foto
      // pedida sin animación: abrir no debe "viajar" desde la primera.
      indiceActual = indice;
      carril.scrollLeft = indice * carril.clientWidth;
      actualizar(indice);
      window.requestAnimationFrame(() => visor.classList.remove('opacity-0'));
      cerrarVisor?.focus();
      document.addEventListener('keydown', alPulsarTecla);
      window.addEventListener('resize', recolocar);
    }

    function cerrar() {
      desampliar();
      visor.classList.add('opacity-0');
      visor.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('scroll-lock');
      setTimeout(() => {
        visor.classList.add('hidden');
        visor.classList.remove('flex');
      }, 300);
      document.removeEventListener('keydown', alPulsarTecla);
      window.removeEventListener('resize', recolocar);
      if (ultimoFoco instanceof HTMLElement) ultimoFoco.focus();
    }

    // Trampa de foco: el visor se declara `aria-modal`, así que el tabulador
    // no puede escaparse a la página de detrás.
    function alPulsarTecla(evento) {
      if (visor.getAttribute('aria-hidden') !== 'false') return;
      if (evento.key === 'Escape') {
        // Primero se deshace la ampliación; un segundo Escape cierra.
        if (visor.classList.contains('zoom-activo')) desampliar();
        else cerrar();
        return;
      }
      if (evento.key === 'ArrowRight') {
        irA(indiceActual + 1);
        return;
      }
      if (evento.key === 'ArrowLeft') {
        irA(indiceActual - 1);
        return;
      }
      if (evento.key !== 'Tab') return;

      const enfocables = Array.from(
        visor.querySelectorAll('button, [href], [tabindex]:not([tabindex="-1"])'),
      ).filter((el) => el.offsetParent !== null);
      if (!enfocables.length) return;
      const primero = enfocables[0];
      const ultimo = enfocables[enfocables.length - 1];
      if (evento.shiftKey && document.activeElement === primero) {
        evento.preventDefault();
        ultimo.focus();
      } else if (!evento.shiftKey && document.activeElement === ultimo) {
        evento.preventDefault();
        primero.focus();
      }
    }

    document.querySelectorAll('[data-photo-open]').forEach((boton) => {
      boton.addEventListener('click', () =>
        abrirVisor(Number(boton.dataset.photoIndex)),
      );
    });
    cerrarVisor?.addEventListener('click', cerrar);
    siguienteVisor?.addEventListener('click', () => irA(indiceActual + 1));
    anteriorVisor?.addEventListener('click', () => irA(indiceActual - 1));
  });
</script>
