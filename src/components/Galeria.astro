---
// src/components/Galeria.astro
import { songs, galleryImages } from '../data/bandaSonora';
---

<div class="pt-40 md:pt-48 pb-24 relative z-10 w-full min-h-screen">
  <div class="container mx-auto px-4 md:px-6 max-w-7xl">
    <div class="text-center space-y-6 mb-12" data-aos="fade-down">
      <h2
        class="text-4xl md:text-6xl font-cinzel text-amber-600 dark:text-amber-500 font-bold tracking-[0.2em] drop-shadow-lg dark:drop-shadow-2xl uppercase"
      >
        Banda Sonora &amp; Galería
      </h2>
      <p
        class="text-base md:text-lg text-stone-700 dark:text-stone-300 font-light leading-relaxed max-w-2xl mx-auto tracking-wide"
      >
        La música elegida con sumo cuidado, escena a escena, y los
        fotogramas que mejor resumen a Winden.
      </p>
    </div>

    <div
      class="grid grid-cols-2 justify-center gap-2 md:flex md:gap-4 mb-12 md:mb-16 w-full max-w-md mx-auto"
      data-aos="fade-up"
    >
      <button
        class="tab-btn-galeria active px-1 py-3 md:px-8 md:py-3 rounded-lg md:rounded-t-lg font-cinzel font-bold tracking-wider md:tracking-widest uppercase text-[11px] md:text-base transition-all duration-300 text-white border-b-2 border-amber-600 dark:border-amber-500 bg-stone-800 dark:bg-[#0a0a0a] shadow-lg"
        data-target="galeria-musica"
      >
        Banda Sonora
      </button>
      <button
        class="tab-btn-galeria px-1 py-3 md:px-8 md:py-3 rounded-lg md:rounded-t-lg font-cinzel font-bold tracking-wider md:tracking-widest uppercase text-[11px] md:text-base transition-all duration-300 text-stone-500 border-b-2 border-transparent hover:text-stone-700 dark:hover:text-stone-300 hover:bg-stone-300/40 dark:hover:bg-stone-900/40"
        data-target="galeria-fotos"
      >
        Fotografías
      </button>
    </div>

    <!-- ===== BANDA SONORA (lista de pistas, estilo reproductor) ===== -->
    <div id="galeria-musica" class="tab-content-galeria block animate-fade-in">
      <div class="max-w-4xl mx-auto rounded-2xl border border-stone-300/70 dark:border-stone-800 bg-white/60 dark:bg-stone-900/40 backdrop-blur-md overflow-hidden divide-y divide-stone-200/70 dark:divide-stone-800/70 shadow-xl">
        {
          songs.map((song, index) => (
            <div class="track-item" data-track-item data-track-id={song.youtubeId}>
              <button
                type="button"
                data-song-toggle
                data-song-id={song.youtubeId}
                data-song-title={song.title}
                data-song-artist={song.artist}
                aria-expanded="false"
                aria-controls={`song-panel-${song.youtubeId}`}
                class="track-row group w-full flex items-center gap-3 md:gap-4 px-3 md:px-5 py-2.5 md:py-3 text-left transition-colors duration-200 hover:bg-amber-500/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-amber-400"
              >
                <span class="relative shrink-0 w-6 text-center font-mono text-xs text-stone-400 dark:text-stone-600">
                  <span class="track-row-index group-hover:opacity-0 transition-opacity duration-150">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <span class="track-row-eq absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-150 flex items-end justify-center gap-[2px]" aria-hidden="true">
                    <span class="w-[2.5px] bg-amber-500 h-2 animate-audio-bar-1 rounded-sm" />
                    <span class="w-[2.5px] bg-amber-500 h-3 animate-audio-bar-2 rounded-sm" />
                    <span class="w-[2.5px] bg-amber-500 h-1.5 animate-audio-bar-3 rounded-sm" />
                  </span>
                </span>

                <span class="relative shrink-0 w-11 h-11 md:w-12 md:h-12 rounded-lg overflow-hidden bg-stone-950">
                  <img
                    src={`https://img.youtube.com/vi/${song.youtubeId}/default.jpg`}
                    alt=""
                    loading="lazy"
                    class="w-full h-full object-cover grayscale-[55%] group-hover:grayscale-0 transition-all duration-300"
                  />
                </span>

                <span class="min-w-0 flex-1">
                  <span class="block font-cinzel text-sm md:text-base font-bold text-stone-900 dark:text-white uppercase tracking-wide truncate">
                    {song.title}
                  </span>
                  <span class="block text-xs text-stone-500 dark:text-stone-400 font-mono tracking-wide truncate">
                    {song.artist}
                    {song.note && <span class="italic text-stone-400 dark:text-stone-600"> · {song.note}</span>}
                  </span>
                </span>

                <span class="song-toggle-icon shrink-0 w-8 h-8 rounded-full border border-transparent group-hover:border-amber-500/60 flex items-center justify-center text-stone-400 group-hover:text-amber-500 group-hover:bg-amber-500/10 transition-all duration-200">
                  <svg class="song-toggle-icon-play w-3.5 h-3.5 translate-x-0.5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M8 5v14l11-7z" />
                  </svg>
                  <svg class="song-toggle-icon-close hidden w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </span>
              </button>

              <div
                id={`song-panel-${song.youtubeId}`}
                class="song-expand grid transition-[grid-template-rows] duration-500 ease-out"
                style="grid-template-rows: 0fr;"
              >
                <div class="overflow-hidden">
                  <div class="px-3 pb-4 md:px-5 md:pb-5 pt-1">
                    <div
                      data-song-player-slot
                      class="relative w-full aspect-video bg-black rounded-xl overflow-hidden border border-stone-800 shadow-lg shadow-black/30"
                    />
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- ===== FOTOGRAFÍAS (mosaico editorial estilo tablón de pistas) ===== -->
    <div id="galeria-fotos" class="tab-content-galeria hidden animate-fade-in">
      <div
        class="flex items-center justify-center gap-4 mb-8 md:mb-10 opacity-80"
        data-aos="zoom-in"
      >
        <div class="h-[1px] w-12 md:w-24 bg-gradient-to-r from-transparent to-amber-600" />
        <p class="text-amber-700 dark:text-amber-500 font-mono tracking-widest uppercase text-[10px] md:text-xs font-bold flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14M14 8h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          {galleryImages.length} Fotogramas Archivados
        </p>
        <div class="h-[1px] w-12 md:w-24 bg-gradient-to-l from-transparent to-amber-600" />
      </div>

      {/* grid-flow-dense: las fotos destacadas ocupan 2x2 y, cuando no caben
          en las columnas que quedan de la fila, la colocación automática las
          empuja a la fila siguiente dejando huecos vacíos en el mosaico.
          Con `dense` el navegador retrocede y rellena esos huecos con las
          fotos pequeñas posteriores. */}
      <div class="grid grid-flow-dense grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 auto-rows-[110px] sm:auto-rows-[130px] lg:auto-rows-[150px] gap-2.5 md:gap-3">
        {
          galleryImages.map((image, index) => (
            <button
              type="button"
              data-photo-open
              data-photo-index={index}
              class={`photo-tile group relative overflow-hidden rounded-lg border border-stone-300/70 dark:border-stone-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400 ${image.featured ? 'col-span-2 row-span-2' : ''}`}
              data-aos="fade-up"
              data-aos-delay={Math.min(index * 25, 240)}
            >
              <img
                src={image.src}
                alt={image.alt}
                loading="lazy"
                class="w-full h-full object-cover grayscale-[25%] group-hover:grayscale-0 scale-100 group-hover:scale-110 transition-all duration-700 ease-out"
              />

              {/* Chincheta ámbar: refuerza la lectura "tablón de pistas" del sitio */}
              <span
                aria-hidden="true"
                class="absolute top-2 left-1/2 -translate-x-1/2 w-2 h-2 rounded-full bg-amber-500 shadow-[0_0_6px_rgba(245,158,11,0.9)] opacity-0 group-hover:opacity-100 scale-75 group-hover:scale-100 transition-all duration-300 z-10"
              />

              <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/10 to-black/0 opacity-0 group-hover:opacity-100 transition-opacity duration-300" />

              <span class="photo-tile-caption absolute inset-x-0 bottom-0 px-3 py-2.5 translate-y-2 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-300">
                <span class="block text-[11px] md:text-xs leading-snug text-stone-100 font-medium line-clamp-2">
                  {image.alt}
                </span>
              </span>

              <div class="absolute bottom-2 right-2 w-7 h-7 rounded-full bg-black/60 border border-amber-500/40 flex items-center justify-center opacity-0 group-hover:opacity-100 scale-90 group-hover:scale-100 transition-all duration-300">
                <svg class="w-3.5 h-3.5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" />
                </svg>
              </div>
            </button>
          ))
        }
      </div>
    </div>
  </div>
</div>

<!-- Lightbox de fotografías -->
<div
  id="photo-lightbox"
  role="dialog"
  aria-modal="true"
  aria-label="Visor de fotografías"
  aria-hidden="true"
  class="hidden fixed inset-0 z-[120] items-center justify-center bg-black/95 backdrop-blur-lg opacity-0 transition-opacity duration-500 p-4"
>
  <button
    id="photo-lightbox-close"
    aria-label="Cerrar visor"
    class="absolute top-4 right-4 md:top-8 md:right-8 z-10 p-2 bg-stone-900/80 hover:bg-black text-stone-400 hover:text-amber-500 rounded-full transition-all border border-stone-700 hover:border-amber-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400"
  >
    <svg class="w-6 h-6 md:w-8 md:h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>
  <button
    id="photo-lightbox-prev"
    aria-label="Foto anterior"
    class="absolute left-2 md:left-6 top-1/2 -translate-y-1/2 z-10 w-11 h-11 rounded-full bg-stone-900/80 hover:bg-black text-stone-300 hover:text-amber-500 border border-stone-700 hover:border-amber-500 flex items-center justify-center transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400"
  >
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
    </svg>
  </button>
  <button
    id="photo-lightbox-next"
    aria-label="Foto siguiente"
    class="absolute right-2 md:right-6 top-1/2 -translate-y-1/2 z-10 w-11 h-11 rounded-full bg-stone-900/80 hover:bg-black text-stone-300 hover:text-amber-500 border border-stone-700 hover:border-amber-500 flex items-center justify-center transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400"
  >
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
    </svg>
  </button>
  <figure class="flex flex-col items-center gap-4 max-w-full">
    <img
      id="photo-lightbox-img"
      src=""
      alt=""
      class="max-w-full max-h-[75vh] w-auto h-auto rounded-lg shadow-2xl border border-stone-800 object-contain"
    />
    <figcaption
      id="photo-lightbox-caption"
      class="max-w-xl text-center text-sm md:text-base text-stone-300 font-light leading-relaxed px-4"
    />
  </figure>
  <p
    id="photo-lightbox-counter"
    class="absolute bottom-5 left-1/2 -translate-x-1/2 font-mono text-[11px] tracking-[0.3em] uppercase text-stone-400 bg-black/60 backdrop-blur-md border border-white/10 rounded-full px-3 py-1"
  />
</div>

<style>
  .animate-fade-in {
    animation: fadeIn 0.8s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(15px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .track-row[aria-expanded='true'] {
    background-color: color-mix(in srgb, var(--color-amber-500) 10%, transparent);
  }
  /* Mientras suena, el ecualizador queda fijo (no solo en hover) hasta que
     cambie de canción o el usuario la cierre. */
  .track-row[aria-expanded='true'] .track-row-index {
    opacity: 0 !important;
  }
  .track-row[aria-expanded='true'] .track-row-eq {
    opacity: 1 !important;
  }
  .song-toggle-icon-play,
  .song-toggle-icon-close {
    transition: opacity 150ms ease-out;
  }

  .photo-tile-caption {
    background: linear-gradient(to top, rgba(0, 0, 0, 0.85), transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .track-row,
    .track-row-eq span,
    .photo-tile,
    .photo-tile-caption,
    .song-expand,
    [data-photo-open] img,
    [data-photo-open] span {
      transition: none !important;
      transform: none !important;
      animation: none !important;
    }
  }
</style>

<script is:inline define:vars={{ galleryImages }}>
  document.addEventListener('DOMContentLoaded', () => {
    // --- Tabs ---
    const tabs = document.querySelectorAll('.tab-btn-galeria');
    const contents = document.querySelectorAll('.tab-content-galeria');

    function activateTab(targetId) {
      contents.forEach((c) => {
        c.classList.remove('block');
        c.classList.add('hidden');
      });
      tabs.forEach((t) => {
        t.classList.remove(
          'text-white',
          'border-amber-600',
          'dark:border-amber-500',
          'bg-stone-800',
          'dark:bg-[#0a0a0a]',
          'shadow-lg',
        );
        t.classList.add('text-stone-500', 'border-transparent');
      });

      const targetContent = document.getElementById(targetId);
      const targetTab = document.querySelector(`.tab-btn-galeria[data-target="${targetId}"]`);
      if (targetContent && targetTab) {
        targetContent.classList.remove('hidden');
        targetContent.classList.add('block');
        targetTab.classList.remove('text-stone-500', 'border-transparent');
        targetTab.classList.add(
          'text-white',
          'border-amber-600',
          'dark:border-amber-500',
          'bg-stone-800',
          'dark:bg-[#0a0a0a]',
          'shadow-lg',
        );
      }
      if (typeof AOS !== 'undefined') setTimeout(() => AOS.refresh(), 50);
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        if (tab.dataset.target !== 'galeria-musica' && openTrackItem) {
          collapseTrack(openTrackItem);
          openTrackItem = null;
        }
        activateTab(tab.dataset.target);
      });
    });
    window.resetGaleriaTabs = () => {
      if (openTrackItem) {
        collapseTrack(openTrackItem);
        openTrackItem = null;
      }
      activateTab('galeria-musica');
    };

    // --- Reproductor en línea (acordeón, reutiliza la YouTube IFrame API ya cargada en BaseLayout) ---
    // Sustituye al antiguo modal a pantalla completa: cada pista se expande
    // in situ dentro de la lista (mismo patrón .reco-expand ya usado en
    // Recomendaciones), sin overlay ni huecos vacíos fuera de contexto.
    let openTrackItem = null;
    let openPlayer = null;

    function collapseTrack(item) {
      if (!item) return;
      const toggle = item.querySelector('[data-song-toggle]');
      const panel = item.querySelector('.song-expand');
      const iconPlay = item.querySelector('.song-toggle-icon-play');
      const iconClose = item.querySelector('.song-toggle-icon-close');
      toggle?.setAttribute('aria-expanded', 'false');
      if (panel) panel.style.gridTemplateRows = '0fr';
      iconClose?.classList.add('hidden');
      iconPlay?.classList.remove('hidden');
      if (openPlayer && typeof openPlayer.destroy === 'function') {
        openPlayer.destroy();
      }
      openPlayer = null;
    }

    function expandTrack(item, btn) {
      const panel = item.querySelector('.song-expand');
      const slot = item.querySelector('[data-song-player-slot]');
      const iconPlay = item.querySelector('.song-toggle-icon-play');
      const iconClose = item.querySelector('.song-toggle-icon-close');
      if (!panel || !slot) return;

      btn.setAttribute('aria-expanded', 'true');
      panel.style.gridTemplateRows = '1fr';
      iconPlay?.classList.add('hidden');
      iconClose?.classList.remove('hidden');

      slot.id = `song-player-${btn.dataset.songId}`;
      const videoId = btn.dataset.songId;
      function mountPlayer() {
        if (window.YT && window.YT.Player) {
          openPlayer = new YT.Player(slot.id, {
            videoId,
            playerVars: { autoplay: 1, rel: 0 },
          });
        } else {
          setTimeout(mountPlayer, 200);
        }
      }
      mountPlayer();
      openTrackItem = item;
    }

    document.querySelectorAll('[data-song-toggle]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const item = btn.closest('[data-track-item]');
        const isOpen = btn.getAttribute('aria-expanded') === 'true';

        if (openTrackItem && openTrackItem !== item) {
          collapseTrack(openTrackItem);
        }

        if (isOpen) {
          collapseTrack(item);
          openTrackItem = null;
        } else {
          expandTrack(item, btn);
        }
      });
    });

    // --- Lightbox de fotografías ---
    const lightbox = document.getElementById('photo-lightbox');
    document.body.appendChild(lightbox);
    const lightboxImg = document.getElementById('photo-lightbox-img');
    const lightboxClose = document.getElementById('photo-lightbox-close');
    const lightboxPrev = document.getElementById('photo-lightbox-prev');
    const lightboxNext = document.getElementById('photo-lightbox-next');
    let currentPhotoIndex = 0;
    let lightboxLastFocused = null;

    const lightboxCounter = document.getElementById('photo-lightbox-counter');
    const lightboxCaption = document.getElementById('photo-lightbox-caption');

    function renderPhoto() {
      const photo = galleryImages[currentPhotoIndex];
      lightboxImg.src = photo.src;
      lightboxImg.alt = photo.alt;
      if (lightboxCaption) {
        lightboxCaption.textContent = photo.alt;
      }
      if (lightboxCounter) {
        lightboxCounter.textContent = `${currentPhotoIndex + 1} / ${galleryImages.length}`;
      }
    }

    function openLightbox(index) {
      lightboxLastFocused = document.activeElement;
      currentPhotoIndex = index;
      renderPhoto();
      lightbox.classList.remove('hidden');
      lightbox.classList.add('flex');
      lightbox.setAttribute('aria-hidden', 'false');
      setTimeout(() => lightbox.classList.remove('opacity-0'), 10);
      lightboxClose?.focus();
    }

    function closeLightbox() {
      lightbox.classList.add('opacity-0');
      lightbox.setAttribute('aria-hidden', 'true');
      setTimeout(() => {
        lightbox.classList.add('hidden');
        lightbox.classList.remove('flex');
      }, 500);
      if (lightboxLastFocused instanceof HTMLElement) lightboxLastFocused.focus();
    }

    function showNextPhoto() {
      currentPhotoIndex = (currentPhotoIndex + 1) % galleryImages.length;
      renderPhoto();
    }
    function showPrevPhoto() {
      currentPhotoIndex = (currentPhotoIndex - 1 + galleryImages.length) % galleryImages.length;
      renderPhoto();
    }

    document.querySelectorAll('[data-photo-open]').forEach((btn) => {
      btn.addEventListener('click', () => openLightbox(Number(btn.dataset.photoIndex)));
    });
    lightboxClose?.addEventListener('click', closeLightbox);
    lightboxNext?.addEventListener('click', showNextPhoto);
    lightboxPrev?.addEventListener('click', showPrevPhoto);

    document.addEventListener('keydown', (event) => {
      if (openTrackItem && event.key === 'Escape') {
        const btn = openTrackItem.querySelector('[data-song-toggle]');
        collapseTrack(openTrackItem);
        openTrackItem = null;
        btn?.focus();
      }
      if (lightbox.getAttribute('aria-hidden') === 'false') {
        if (event.key === 'Escape') closeLightbox();
        if (event.key === 'ArrowRight') showNextPhoto();
        if (event.key === 'ArrowLeft') showPrevPhoto();
      }
    });
  });
</script>
