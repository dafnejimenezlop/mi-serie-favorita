---
// src/components/sections/Explore.astro
// Cierre de la vista "Inicio": un mapa rápido del resto del sitio para
// quien llega por primera vez. Reutiliza el mismo lenguaje de iconos que
// AsistenteWinden.astro (mismos paths) para mantener coherencia visual.

const destinos = [
  {
    href: '#resumen',
    label: 'Resumen',
    icon: 'M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z',
    text: 'Las tres temporadas explicadas por bloques, con vídeo incluido.',
  },
  {
    href: '#aclaraciones',
    label: 'Aclaraciones',
    icon: 'M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15',
    text: 'Simbología, teorías y la explicación del final con calma.',
  },
  {
    href: '#personajes',
    label: 'Familias',
    icon: 'M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87m6-1.13a4 4 0 10-4-4 4 4 0 004 4zm6-1a4 4 0 10-4-4',
    text: 'El árbol genealógico completo, interactivo, por familia.',
  },
  {
    href: '#recomendaciones',
    label: 'Recomendaciones',
    icon: 'M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z',
    text: 'Series y películas afines, filtradas por plataforma.',
  },
  {
    href: '#galeria',
    label: 'Galería',
    icon: 'M9 19V6l12-2v13M9 19a3 3 0 11-6 0 3 3 0 016 0zm12-2a3 3 0 11-6 0 3 3 0 016 0z',
    text: 'La banda sonora completa y los fotogramas más icónicos.',
  },
];
---

<section
  id="explora"
  class="py-24 bg-transparent transition-colors duration-300"
>
  <div class="container mx-auto px-6">
    <div class="text-center mb-14 space-y-3">
      <h2
        class="text-3xl md:text-5xl font-cinzel text-amber-950 dark:text-amber-500 font-bold tracking-[0.1em] transition-colors uppercase"
        data-aos="zoom-in"
      >
        Sigue el Hilo
      </h2>
      <p
        class="text-sm md:text-base text-stone-700 dark:text-stone-400 font-light max-w-xl mx-auto"
        data-aos="fade-up"
      >
        Cinco puertas, un mismo pueblo. Elige por dónde quieres empezar.
      </p>
    </div>

    <div class="relative max-w-6xl mx-auto">
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4 md:gap-6">
        {
          destinos.map((destino, index) => (
            <a
              href={destino.href}
              data-aos="fade-up"
              data-aos-delay={index * 100}
              class="explore-card group relative flex flex-col items-center text-center gap-3 p-5 md:p-6 rounded-xl border border-stone-300/70 dark:border-stone-800 bg-white/70 dark:bg-stone-900/50 backdrop-blur-md hover:border-amber-500/60 hover:-translate-y-1 transition-all duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400"
            >
              <span
                class="absolute top-3 right-3 font-mono text-[10px] tracking-widest text-stone-400/70 dark:text-stone-600 group-hover:text-amber-500/70 transition-colors duration-300"
                aria-hidden="true"
              >
                {String(index + 1).padStart(2, '0')}
              </span>
              <span class="explore-icon w-12 h-12 rounded-full border border-stone-300 dark:border-stone-700 group-hover:border-amber-500/60 flex items-center justify-center text-stone-500 dark:text-stone-400 group-hover:text-amber-500 group-hover:rotate-6 group-active:scale-90 transition-all duration-300">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path
                    class="explore-icon-path"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.6"
                    pathLength="1"
                    d={destino.icon}
                  />
                </svg>
              </span>
              <span class="font-cinzel text-sm md:text-base font-bold uppercase tracking-wide text-stone-800 dark:text-stone-100">
                {destino.label}
              </span>
              <span class="hidden md:block text-xs text-stone-500 dark:text-stone-500 font-light leading-relaxed">
                {destino.text}
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .group:hover .explore-icon,
  .group:focus-visible .explore-icon {
    box-shadow: 0 0 16px rgba(245, 158, 11, 0.35);
  }

  /* Trazo del icono "dibujándose" al interactuar: pathLength="1" normaliza
     la longitud real del path a 1, así el mismo dasharray/dashoffset sirve
     para cualquier icono sin medir cada uno a mano. */
  .explore-icon-path {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 0.5s ease-out;
  }
  .group:hover .explore-icon-path,
  .group:focus-visible .explore-icon-path {
    animation: explore-icon-draw 0.6s ease-out;
  }
  @keyframes explore-icon-draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .explore-card {
      transition: none !important;
    }
    .explore-icon-path {
      animation: none !important;
    }
  }
</style>
