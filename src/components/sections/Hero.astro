---
// src/components/sections/Hero.astro
---

<section
  id="inicio"
  class="relative h-screen flex items-center justify-center overflow-hidden bg-black"
>
  <div
    class="absolute top-1/2 left-1/2 w-[100vw] h-[56.25vw] min-h-[100vh] min-w-[177.77vh] -translate-x-1/2 -translate-y-1/2 pointer-events-none opacity-40 z-0"
  >
    <div id="youtube-hero-player" class="w-full h-full"></div>
  </div>

  <div
    class="absolute inset-x-0 bottom-0 h-40 md:h-56 bg-gradient-to-t from-black to-transparent pointer-events-none z-[1]"
    aria-hidden="true"
  >
  </div>

  <div class="hero-motes absolute inset-0 pointer-events-none z-[2]" aria-hidden="true">
    <span class="hero-mote" style="left: 12%; animation-delay: 0s;"></span>
    <span class="hero-mote" style="left: 28%; animation-delay: 2.4s;"></span>
    <span class="hero-mote" style="left: 47%; animation-delay: 4.8s;"></span>
    <span class="hero-mote" style="left: 66%; animation-delay: 1.2s;"></span>
    <span class="hero-mote" style="left: 82%; animation-delay: 3.6s;"></span>
  </div>

  <div class="relative z-10 text-center space-y-5 md:space-y-6 px-6 pt-16">
    <div class="relative inline-block">
      <div
        class="hero-title-halo absolute inset-0 -z-10 pointer-events-none"
        aria-hidden="true"
      >
      </div>
      <h1
        class="hero-title-flicker relative text-6xl md:text-9xl font-cinzel text-amber-500 font-bold tracking-widest drop-shadow-[0_5px_5px_rgba(0,0,0,0.8)]"
        data-aos="zoom-in"
        data-aos-duration="1500"
      >
        DARK
      </h1>
    </div>
    <p
      class="text-lg md:text-3xl font-light text-stone-100 tracking-[0.15em] font-cinzel max-w-3xl mx-auto drop-shadow-lg"
      data-aos="fade-up"
      data-aos-delay="500"
    >
      LA CUESTIÓN NO ES CÓMO, SINO CUÁNDO.
    </p>

    <div
      class="h-px w-16 md:w-24 mx-auto bg-gradient-to-r from-transparent via-amber-500/70 to-transparent"
      data-aos="fade-up"
      data-aos-delay="600"
      aria-hidden="true"
    >
    </div>

    <!-- Ficha técnica en una sola línea. Antes eran dos píldoras con un punto
         ámbar suelto entre ellas: tres cajas para un dato que se lee de
         corrido. Un solo renglón con separadores tenues pesa menos y deja el
         protagonismo al título. -->
    <div
      data-aos="fade-up"
      data-aos-delay="600"
      class="flex flex-wrap items-center justify-center gap-x-2.5 gap-y-1 font-mono text-[10px] md:text-[11px] tracking-[0.22em] uppercase text-stone-400"
    >
      <span>3 Temporadas</span>
      <span aria-hidden="true" class="text-amber-500/60">·</span>
      <span>26 Episodios</span>
      <span aria-hidden="true" class="text-amber-500/60">·</span>
      <span>2017–2020</span>
      <span aria-hidden="true" class="text-amber-500/60">·</span>
      <span class="text-amber-400/90">Misterio · Ciencia Ficción</span>
    </div>

    <!-- El hero no tenía ninguna llamada a la acción: el usuario aterrizaba
         en una portada preciosa y su única salida era desplazarse a ciegas.
         Dos rutas explícitas, la primaria hacia el contenido más distintivo
         del sitio (el árbol genealógico). -->
    <div
      data-aos="fade-up"
      data-aos-delay="750"
      class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-4"
    >
      <a
        href="#personajes"
        class="hero-cta group inline-flex items-center justify-center gap-2.5 w-full sm:w-auto h-12 md:h-[3.25rem] px-7 leading-none rounded-full bg-amber-500 text-black font-cinzel font-bold text-xs md:text-sm tracking-[0.18em] uppercase shadow-[0_8px_30px_-8px_rgba(245,158,11,0.7)] hover:bg-amber-400 hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.98] transition-all duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-300 focus-visible:ring-offset-2 focus-visible:ring-offset-black"
      >
        Explorar las familias
        <svg
          class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2.5"
            d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
        </svg>
      </a>

      <a
        href="#resumen"
        class="hero-cta inline-flex items-center justify-center gap-2.5 w-full sm:w-auto h-12 md:h-[3.25rem] px-7 leading-none rounded-full border border-white/25 bg-white/5 backdrop-blur-md text-stone-100 font-cinzel font-bold text-xs md:text-sm tracking-[0.18em] uppercase hover:border-amber-500/70 hover:text-amber-400 hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.98] transition-all duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-300 focus-visible:ring-offset-2 focus-visible:ring-offset-black"
      >
        Ver el resumen
      </a>
    </div>

  </div>

  <a
    href="#sinopsis"
    aria-label="Bajar a la sinopsis"
    class="hero-scroll-hint absolute bottom-24 md:bottom-10 inset-x-0 mx-auto w-fit z-10 flex flex-col items-center gap-1.5 text-stone-400 hover:text-amber-500 transition-colors duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400 rounded-full p-1"
  >
    <span class="font-mono text-[9px] tracking-[0.3em] uppercase">Desplázate</span>
    <svg class="w-4 h-4 hero-scroll-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </a>

  <div
    class="absolute bottom-6 right-6 md:bottom-10 md:right-10 z-20 flex items-center space-x-3 md:space-x-4"
  >
    <button
      id="btnMute"
      aria-label="Mutear sonido"
      class="p-2.5 md:p-3 rounded-full bg-stone-900/60 border border-stone-600 text-white hover:bg-amber-500 hover:border-amber-500 hover:text-black transition-all duration-300 backdrop-blur-md group"
    >
      <svg
        id="icon-muted"
        class="w-5 h-5 md:w-6 md:h-6 block group-hover:scale-110 transition-transform"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"
          clip-rule="evenodd"></path><path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2"></path></svg
      >
      <svg
        id="icon-unmuted"
        class="w-5 h-5 md:w-6 md:h-6 hidden group-hover:scale-110 transition-transform"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"
        ></path></svg
      >
    </button>

    <button
      id="btnPlayPause"
      aria-label="Pausar vídeo"
      class="p-2.5 md:p-3 rounded-full bg-stone-900/60 border border-stone-600 text-white hover:bg-amber-500 hover:border-amber-500 hover:text-black transition-all duration-300 backdrop-blur-md group"
    >
      <svg
        id="icon-pause"
        class="w-5 h-5 md:w-6 md:h-6 block group-hover:scale-110 transition-transform"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M10 9v6m4-6v6m7-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg
      >
      <svg
        id="icon-play"
        class="w-5 h-5 md:w-6 md:h-6 hidden group-hover:scale-110 transition-transform"
        fill="currentColor"
        viewBox="0 0 24 24"><path d="M8 5v14l11-7z"></path></svg
      >
    </button>

    <button
      id="btnModal"
      aria-label="Ver en pantalla completa"
      class="p-2.5 md:p-3 rounded-full bg-stone-900/60 border border-stone-600 text-white hover:bg-amber-500 hover:border-amber-500 hover:text-black transition-all duration-300 backdrop-blur-md group"
    >
      <svg
        class="w-5 h-5 md:w-6 md:h-6 group-hover:scale-110 transition-transform"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"
        ></path></svg
      >
    </button>
  </div>
</section>

<style>
  .hero-mote {
    position: absolute;
    bottom: -10%;
    width: 3px;
    height: 3px;
    border-radius: 9999px;
    background: rgba(245, 158, 11, 0.5);
    box-shadow: 0 0 6px rgba(245, 158, 11, 0.6);
    animation: hero-mote-rise 12s ease-in infinite;
  }
  @keyframes hero-mote-rise {
    0% {
      transform: translateY(0) translateX(0);
      opacity: 0;
    }
    10% {
      opacity: 0.8;
    }
    90% {
      opacity: 0.3;
    }
    100% {
      transform: translateY(-110vh) translateX(20px);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-motes {
      display: none;
    }
  }

  .hero-title-halo {
    background: radial-gradient(
      ellipse at center,
      rgba(245, 158, 11, 0.35) 0%,
      rgba(245, 158, 11, 0.12) 45%,
      transparent 75%
    );
    filter: blur(30px);
    transform: scale(1.4);
    animation: hero-halo-breathe 5s ease-in-out infinite;
  }
  @keyframes hero-halo-breathe {
    0%,
    100% {
      opacity: 0.6;
    }
    50% {
      opacity: 1;
    }
  }
  .hero-title-flicker {
    animation: hero-title-flicker 7s ease-in-out infinite;
  }
  @keyframes hero-title-flicker {
    0%,
    19%,
    21%,
    28%,
    100% {
      text-shadow:
        0 5px 5px rgba(0, 0, 0, 0.8),
        0 0 30px rgba(245, 158, 11, 0.35);
    }
    20% {
      text-shadow:
        0 5px 5px rgba(0, 0, 0, 0.8),
        0 0 8px rgba(245, 158, 11, 0.15);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-title-halo {
      animation: none;
      opacity: 0.8;
    }
    .hero-title-flicker {
      animation: none;
    }
  }
  .hero-scroll-hint {
    opacity: 0;
    animation: hero-scroll-hint-in 0.8s ease-out 1.2s forwards;
  }
  .hero-scroll-chevron {
    animation: hero-scroll-bounce 1.8s ease-in-out infinite;
  }
  @keyframes hero-scroll-hint-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes hero-scroll-bounce {
    0%,
    100% {
      transform: translateY(0);
      opacity: 0.6;
    }
    50% {
      transform: translateY(5px);
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-scroll-hint {
      animation: none;
      opacity: 1;
      transform: translateY(0);
    }
    .hero-scroll-chevron {
      animation: none;
    }
    .hero-cta {
      transition:
        background-color 0.2s ease,
        border-color 0.2s ease,
        color 0.2s ease;
    }
    .hero-cta:hover {
      transform: none;
    }
  }
</style>
