---
// src/components/sections/Hero.astro
---

<section
  id="inicio"
  class="relative h-screen flex items-center justify-center overflow-hidden bg-black"
>
  <div
    class="absolute top-1/2 left-1/2 w-[100vw] h-[56.25vw] min-h-[100vh] min-w-[177.77vh] -translate-x-1/2 -translate-y-1/2 pointer-events-none opacity-40 z-0"
  >
    <div id="youtube-hero-player" class="w-full h-full"></div>
  </div>

  <div
    class="absolute inset-x-0 bottom-0 h-40 md:h-56 bg-gradient-to-t from-black to-transparent pointer-events-none z-[1]"
    aria-hidden="true"
  >
  </div>

  <div class="relative z-10 text-center space-y-6 px-6 pt-16">
    <h1
      class="text-6xl md:text-9xl font-cinzel text-amber-500 font-bold tracking-widest drop-shadow-[0_5px_5px_rgba(0,0,0,0.8)]"
      data-aos="zoom-in"
      data-aos-duration="1500"
    >
      DARK
    </h1>
    <p
      class="text-lg md:text-3xl font-light text-stone-100 tracking-[0.15em] font-cinzel max-w-3xl mx-auto drop-shadow-lg"
      data-aos="fade-up"
      data-aos-delay="500"
    >
      LA CUESTIÓN NO ES CÓMO, SINO CUÁNDO.
    </p>

    <div
      data-aos="fade-up"
      data-aos-delay="700"
      class="flex flex-wrap items-center justify-center gap-x-3 gap-y-2 pt-2"
    >
      <span
        class="font-mono text-[11px] md:text-xs tracking-[0.2em] uppercase text-stone-300 bg-black/40 border border-white/10 backdrop-blur-md rounded-full px-3 py-1"
      >
        3 Temporadas · 26 Episodios · 2017–2020
      </span>
      <span class="hidden sm:inline-flex items-center gap-2 text-stone-500" aria-hidden="true">
        <span class="w-1 h-1 rounded-full bg-amber-500"></span>
      </span>
      <span
        class="font-mono text-[11px] md:text-xs tracking-[0.2em] uppercase text-amber-400 bg-black/40 border border-amber-500/20 backdrop-blur-md rounded-full px-3 py-1"
      >
        Misterio · Ciencia Ficción · Familia
      </span>
    </div>

  </div>

  <a
    href="#sinopsis"
    aria-label="Bajar a la sinopsis"
    class="hero-scroll-hint absolute bottom-24 md:bottom-10 inset-x-0 mx-auto w-fit z-10 flex flex-col items-center gap-1.5 text-stone-400 hover:text-amber-500 transition-colors duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400 rounded-full p-1"
  >
    <span class="font-mono text-[9px] tracking-[0.3em] uppercase">Desplázate</span>
    <svg class="w-4 h-4 hero-scroll-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </a>

  <div
    class="absolute bottom-6 right-6 md:bottom-10 md:right-10 z-20 flex items-center space-x-3 md:space-x-4"
  >
    <button
      id="btnMute"
      aria-label="Mutear sonido"
      class="p-2.5 md:p-3 rounded-full bg-stone-900/60 border border-stone-600 text-white hover:bg-amber-500 hover:border-amber-500 hover:text-black transition-all duration-300 backdrop-blur-md group"
    >
      <svg
        id="icon-muted"
        class="w-5 h-5 md:w-6 md:h-6 block group-hover:scale-110 transition-transform"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"
          clip-rule="evenodd"></path><path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2"></path></svg
      >
      <svg
        id="icon-unmuted"
        class="w-5 h-5 md:w-6 md:h-6 hidden group-hover:scale-110 transition-transform"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"
        ></path></svg
      >
    </button>

    <button
      id="btnPlayPause"
      aria-label="Pausar vídeo"
      class="p-2.5 md:p-3 rounded-full bg-stone-900/60 border border-stone-600 text-white hover:bg-amber-500 hover:border-amber-500 hover:text-black transition-all duration-300 backdrop-blur-md group"
    >
      <svg
        id="icon-pause"
        class="w-5 h-5 md:w-6 md:h-6 block group-hover:scale-110 transition-transform"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M10 9v6m4-6v6m7-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg
      >
      <svg
        id="icon-play"
        class="w-5 h-5 md:w-6 md:h-6 hidden group-hover:scale-110 transition-transform"
        fill="currentColor"
        viewBox="0 0 24 24"><path d="M8 5v14l11-7z"></path></svg
      >
    </button>

    <button
      id="btnModal"
      aria-label="Ver en pantalla completa"
      class="p-2.5 md:p-3 rounded-full bg-stone-900/60 border border-stone-600 text-white hover:bg-amber-500 hover:border-amber-500 hover:text-black transition-all duration-300 backdrop-blur-md group"
    >
      <svg
        class="w-5 h-5 md:w-6 md:h-6 group-hover:scale-110 transition-transform"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"
        ></path></svg
      >
    </button>
  </div>
</section>

<style>
  .hero-scroll-hint {
    opacity: 0;
    animation: hero-scroll-hint-in 0.8s ease-out 1.2s forwards;
  }
  .hero-scroll-chevron {
    animation: hero-scroll-bounce 1.8s ease-in-out infinite;
  }
  @keyframes hero-scroll-hint-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes hero-scroll-bounce {
    0%,
    100% {
      transform: translateY(0);
      opacity: 0.6;
    }
    50% {
      transform: translateY(5px);
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-scroll-hint {
      animation: none;
      opacity: 1;
      transform: translateY(0);
    }
    .hero-scroll-chevron {
      animation: none;
    }
  }
</style>
