---
// src/components/sections/Testimonials.astro

// Esta era la unica seccion del sitio con un segundo (y tercero, y sexto)
// color de acento: esmeralda, azul, rosa, lima y cian saturados de Tailwind,
// contra la regla 2 — acento unico ambar, sin mas color que la semantica ya
// establecida. Los seis testimonios pasan a tres intensidades del mismo
// ambar: mantienen el ritmo visual del tablon sin romper la paleta.
const TONOS = {
  destacado: {
    borde: 'border-amber-500/50',
    texto: 'text-amber-700 dark:text-amber-400',
    fondo: 'bg-amber-500/15',
    punto: 'bg-amber-500',
  },
  medio: {
    borde: 'border-amber-500/25',
    texto: 'text-amber-800 dark:text-amber-300/90',
    fondo: 'bg-amber-500/10',
    punto: 'bg-amber-400',
  },
  tenue: {
    borde: 'border-stone-300 dark:border-white/10',
    texto: 'text-stone-700 dark:text-stone-300',
    fondo: 'bg-stone-500/10',
    punto: 'bg-stone-400 dark:bg-stone-500',
  },
};

const reviews = [
  {
    author: 'H.G. Tannhaus',
    role: 'Creador del aparato',
    date: '21 de Junio, 1986',
    comment: 'Esencial. El apocalipsis ha llegado, y es hermoso.',
    // Tenia 3 de 5 puntos para una reseña que empieza por "Esencial".
    rating: 5,
    tono: 'medio',
    rotate: '-rotate-1',
  },
  {
    author: 'Noah',
    role: 'Sacerdote del tiempo',
    date: '12 de Noviembre, 1953',
    comment:
      'La mejor serie que he visto en mi corta vida. Sic Mundus Creatus Est.',
    rating: 5,
    tono: 'destacado',
    rotate: 'rotate-1',
  },
  {
    author: 'Martha Nielsen',
    role: 'Viajera',
    date: '4 de Noviembre, 2019',
    comment:
      'Todo está conectado. Un viaje cinemático que me dejó sin aliento. Jamás volverás a ver el tiempo de la misma manera. Necesito verla otra vez para entenderla.',
    rating: 4,
    tono: 'tenue',
    rotate: '-rotate-2',
  },
  {
    author: 'Jonas Kahnwald',
    role: 'El Desconocido',
    date: '27 de Junio, 2052',
    comment: 'El final es el principio. Una obra maestra del suspense alemán.',
    rating: 5,
    tono: 'destacado',
    rotate: 'rotate-2',
  },
  {
    author: 'Anónimo',
    role: 'Espectador',
    date: 'Estreno 2017',
    comment:
      'Recomiendo esta serie a todo el mundo. Es un viaje emocional y mental que no olvidarás. No os arrepentiréis de verla.',
    rating: 5,
    tono: 'tenue',
    rotate: '-rotate-1',
  },
  {
    author: 'Periodista',
    role: 'Crítico de Cine',
    date: 'Reseña Destacada',
    comment:
      '¿Alguna vez os habéis preguntado por qué la serie de Dark es tan popular? Es simple: es una obra maestra del cine y la televisión.',
    rating: 5,
    tono: 'medio',
    rotate: 'rotate-1',
  },
];
---

<style>
  .testimonial-card {
    transition:
      transform 0.3s ease-out,
      box-shadow 0.4s ease-out,
      border-color 0.3s ease-out;
    break-inside: avoid;
  }
  .testimonial-card:hover,
  .testimonial-card:focus-within {
    transform: translateY(-6px) rotate(0deg) !important;
    box-shadow: 0 24px 50px -18px rgba(245, 158, 11, 0.3);
  }

  .testimonial-pin {
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.5);
  }

  @media (prefers-reduced-motion: reduce) {
    .testimonial-card {
      transition: none !important;
      transform: rotate(0deg) !important;
    }
  }
</style>

<section
  id="testimonios"
  class="py-24 bg-transparent transition-colors duration-300 overflow-hidden relative"
>
  <div class="container mx-auto px-6">
    <div class="text-center mb-16 space-y-3">
      <span
        class="font-mono text-[11px] tracking-[0.3em] uppercase text-amber-600 dark:text-amber-500/80"
        data-aos="fade-up"
      >
        Testimonios interceptados
      </span>
      <h2
        class="text-3xl md:text-5xl font-cinzel text-amber-500 font-bold transition-colors"
        data-aos="zoom-in"
      >
        Ecos del Futuro
      </h2>
      <p
        class="text-sm md:text-base text-stone-600 dark:text-stone-400 font-light max-w-xl mx-auto"
        data-aos="fade-up"
      >
        Si los propios habitantes de Winden pudieran dejar una reseña,
        dirían algo así.
      </p>
    </div>

    {/* `space-y-6` aplica margen superior a todos los hijos MENOS al primero
        del conjunto, no al primero de cada columna: en 2 y 3 columnas, la
        segunda y la tercera arrancaban 24 px mas abajo que la primera. Con
        `mb-6` en cada tarjeta las tres columnas empiezan a la misma altura. */}
    <div class="max-w-6xl mx-auto columns-1 sm:columns-2 lg:columns-3 gap-6">
      {
        reviews.map((review, index) => (
          <div
            tabindex="0"
            data-aos="fade-up"
            data-aos-delay={(index % 3) * 120}
            class={`testimonial-card ${review.rotate} group bg-stone-50/90 dark:bg-stone-900/80 p-6 mb-6 rounded-lg border ${TONOS[review.tono].borde} hover:border-amber-500/60 shadow-lg space-y-5 backdrop-blur-md relative focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-400`}
          >
            <span
              class={`testimonial-pin absolute -top-2.5 left-1/2 -translate-x-1/2 w-5 h-5 rounded-full border-2 border-black/40 dark:border-white/20 ${TONOS[review.tono].fondo}`}
              aria-hidden="true"
            />

            <div class="flex items-center gap-3 pt-1">
              <span
                class={`shrink-0 w-11 h-11 rounded-full border-2 flex items-center justify-center ${TONOS[review.tono].borde} ${TONOS[review.tono].fondo}`}
                aria-hidden="true"
              >
                <span class={`font-cinzel text-lg font-bold ${TONOS[review.tono].texto}`}>
                  {review.author.charAt(0)}
                </span>
              </span>
              <div class="min-w-0">
                <p
                  class={`text-sm font-bold font-cinzel uppercase tracking-wider truncate ${TONOS[review.tono].texto}`}
                >
                  {review.author}
                </p>
                <p class="text-[11px] text-stone-500 dark:text-stone-400 font-mono tracking-wide uppercase truncate">
                  {review.role}
                </p>
              </div>
            </div>

            <p class="text-sm md:text-base text-stone-800 dark:text-stone-100 leading-relaxed">
              "{review.comment}"
            </p>

            <div class="flex items-center justify-between pt-3 border-t border-stone-200/70 dark:border-white/10">
              <div
                class="flex gap-1"
                role="img"
                aria-label={`${review.rating} de 5`}
              >
                {Array.from({ length: 5 }).map((_, i) => (
                  <span
                    class={`w-1.5 h-1.5 rounded-full ${i < review.rating ? TONOS[review.tono].punto : 'bg-stone-300 dark:bg-stone-700'}`}
                  />
                ))}
              </div>
              <p class="text-[10px] text-stone-400/80 dark:text-stone-500/80 italic">
                {review.date}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
