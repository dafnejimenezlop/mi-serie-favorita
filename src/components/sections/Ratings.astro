---
// src/components/sections/Ratings.astro

// Las cifras estaban escritas a mano en cinco sitios distintos y no cuadraban
// entre si: el desglose sumaba 324 reseñas pero el pie decia 313, las barras
// sumaban un 120 % y la media ponderada real de esos votos era 4,2, no el 4,6
// que animaba el contador. Ahora todo sale de este array, asi que no puede
// volver a descuadrarse.
const distribucion = [
  { estrellas: 5, votos: 180 },
  { estrellas: 4, votos: 83 },
  { estrellas: 3, votos: 28 },
  { estrellas: 2, votos: 20 },
  { estrellas: 1, votos: 13 },
];

const totalVotos = distribucion.reduce((suma, fila) => suma + fila.votos, 0);
const media =
  distribucion.reduce((suma, fila) => suma + fila.estrellas * fila.votos, 0) /
  totalVotos;
const mediaTexto = media.toFixed(1);
const estrellasLlenas = Math.round(media);

// Un unico path de estrella: antes estaba copiado diez veces en el markup.
const ESTRELLA =
  'M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z';

// La intensidad del ambar baja con la puntuacion, como estaba.
const TONO_BARRA = [
  'bg-amber-600',
  'bg-amber-500',
  'bg-amber-500/80',
  'bg-amber-500/60',
  'bg-amber-500/40',
];
---

<section
  id="sinopsis"
  class="py-24 bg-stone-100 dark:bg-stone-950/20 transition-colors duration-300 overflow-hidden relative border-t border-stone-200 dark:border-stone-900"
>
  <div class="container mx-auto px-6 grid lg:grid-cols-2 gap-16 items-start">
    <div
      class="space-y-12 order-2 lg:order-1"
      data-aos="fade-right"
      data-aos-duration="1000"
    >
      <div class="space-y-6 md:space-y-8">
        <h2
          class="text-4xl md:text-5xl font-cinzel text-amber-950 dark:text-amber-500 font-bold tracking-[0.1em] transition-colors uppercase"
        >
          Sinopsis
        </h2>
        <p
          class="text-base md:text-lg text-stone-800 dark:text-stone-300 font-light leading-relaxed transition-colors tracking-wide"
        >
          Dark es una serie de suspense, drama y ciencia ficción creada por el
          director y guionista alemán Baran bo Odar y la productora Jantje
          Fiese. Es la primera serie alemana producida para la plataforma
          Netflix y fue estrenada en diciembre de 2017.
        </p>
        <p
          class="text-base md:text-lg text-stone-800 dark:text-stone-300 font-light leading-relaxed transition-colors tracking-wide"
        >
          La serie es una especie de rompecabezas que presenta una estructura
          narrativa compleja. En Winden, un pequeño pueblo alemán, varios
          linajes se sumergen en la búsqueda de un niño que ha desaparecido de
          forma misteriosa. Entonces, descubren que los acontecimientos abarcan
          diferentes generaciones.
        </p>
        <p
          class="text-base md:text-lg text-stone-800 dark:text-stone-300 font-light leading-relaxed transition-colors tracking-wide"
        >
          Dark es una ficción cargada de simbolismo y misterio que tiene la
          capacidad de hipnotizar al espectador obligándolo continuamente a
          reflexionar y a buscar una explicación.
        </p>
        <p
          class="text-md text-stone-600 dark:text-stone-400 font-light italic transition-colors tracking-wide"
        >
          ¿Qué relación existe entre el pasado, el presente y el futuro?
        </p>
        <div class="pt-2 h-px w-24 bg-amber-500 transition-colors"></div>
      </div>

      <div class="relative group">
        <div
          class="absolute -inset-2 rounded bg-amber-500/0 group-hover:bg-amber-500/10 blur-xl transition-all duration-700 pointer-events-none"
          aria-hidden="true"
        >
        </div>
        <!-- Era una de las dos unicas imagenes de Inicio sin `loading="lazy"`,
             y pesaba 430 KB de JPEG en el camino critico. En WebP al ancho
             real de pantalla baja a 103 KB. -->
        <img
          src="/maquina.webp"
          alt="Póster Cinemático de Winden"
          width="1400"
          height="634"
          loading="lazy"
          decoding="async"
          class="relative rounded border border-stone-200 dark:border-stone-900 group-hover:border-amber-500/40 shadow-2xl dark:shadow-amber-900/10 transition duration-300 filter grayscale hover:grayscale-0 w-full object-cover"
        />
      </div>
    </div>

    <div
      class="relative space-y-12 bg-stone-50 dark:bg-stone-900/40 p-6 md:p-12 rounded-lg border border-stone-200 dark:border-stone-800 hover:border-amber-500/30 shadow-xl hover:shadow-[0_0_40px_rgba(245,158,11,0.08)] w-full order-1 lg:order-2 transition-all duration-500"
      data-aos="fade-left"
      data-aos-duration="1000"
      data-aos-delay="300"
    >
      <span
        class="absolute top-4 right-4 md:top-6 md:right-6 font-mono text-[9px] tracking-[0.25em] uppercase text-stone-500 dark:text-stone-600"
        aria-hidden="true"
      >
        Expediente #01
      </span>

      <div class="space-y-6 text-center">
        <!-- 571 KB de JPEG a 1200x1778 px para mostrarse a 324x480. En WebP al
             tamaño real: 154 KB. -->
        <img
          src="/hola.webp"
          width="660"
          height="978"
          loading="lazy"
          decoding="async"
          class="h-120 w-auto object-contain mx-auto rounded drop-shadow-[0_0_25px_rgba(245,158,11,0.15)]"
          alt="Cartel de DARK"
        />

        <p
          class="font-mono text-[10px] tracking-[0.3em] uppercase text-stone-500 dark:text-stone-500"
        >
          Valoración de la Comunidad
        </p>

        <div
          class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:space-x-8"
        >
          {/* Era un <h3>, que metia un encabezado falso ("0.0") en el indice
              del documento entre "Sinopsis" y "Los Tres Ciclos del Tiempo".
              Es una cifra, no un titulo. */}
          <p
            id="ratings-score"
            data-target-score={mediaTexto}
            class="ratings-score-count text-6xl font-cinzel font-bold text-amber-950 dark:text-amber-300 tabular-nums"
            aria-hidden="true"
          >
            0.0
          </p>
          <div
            class="flex text-amber-500 space-x-0.5 transition-transform duration-300 hover:scale-110"
            role="img"
            aria-label={`${mediaTexto} de 5 estrellas, sobre ${totalVotos} reseñas`}
          >
            {
              Array.from({ length: 5 }).map((_, i) => (
                <svg
                  class={`w-8 h-8 ${i < estrellasLlenas ? '' : 'text-stone-300 dark:text-stone-700'}`}
                  fill="currentColor"
                  viewBox="0 0 20 20"
                  aria-hidden="true"
                >
                  <path d={ESTRELLA} />
                </svg>
              ))
            }
          </div>
        </div>
        <p
          class="text-xs text-stone-600 dark:text-stone-400 font-mono tracking-widest pt-2"
        >
          {mediaTexto} basado en {totalVotos} reseñas.
        </p>
      </div>

      <div
        class="space-y-4 pt-8 border-t border-amber-900/50 dark:border-amber-500/50 w-full"
      >
        {
          distribucion.map((fila, i) => (
            <div class="flex items-center space-x-2 md:space-x-4 w-full rounded-lg px-2 -mx-2 py-1 transition-colors duration-300 hover:bg-amber-500/5">
              <div class="w-24 md:w-32 shrink-0 flex items-center justify-between text-xs md:text-sm font-semibold font-mono">
                <div class="flex items-center space-x-1 text-stone-800 dark:text-stone-200">
                  <span>{fila.estrellas}</span>
                  <svg
                    class="w-3 h-3 md:w-4 md:h-4 text-amber-500 mb-0.5"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                    aria-hidden="true"
                  >
                    <path d={ESTRELLA} />
                  </svg>
                </div>
                <span class="text-stone-500 dark:text-stone-400 tracking-wider">
                  ({fila.votos})
                </span>
              </div>
              <div class="flex-1 h-2.5 md:h-3 bg-stone-200 dark:bg-stone-800 rounded-full overflow-hidden">
                <div
                  class={`rating-bar ${i === 0 ? 'rating-bar-shimmer relative' : ''} h-full ${TONO_BARRA[i]} transition-all duration-1000 ease-out w-0`}
                  data-target-width={`${((fila.votos / totalVotos) * 100).toFixed(1)}%`}
                />
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .rating-bar-shimmer::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      transparent 20%,
      rgba(255, 255, 255, 0.35) 50%,
      transparent 80%
    );
    background-size: 200% 100%;
    animation: rating-bar-sheen 3.5s ease-in-out infinite;
  }
  @keyframes rating-bar-sheen {
    0% {
      background-position: 150% 0;
    }
    60%,
    100% {
      background-position: -50% 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .rating-bar-shimmer::after {
      animation: none;
      display: none;
    }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const bars = document.querySelectorAll('.rating-bar');
    if (!bars.length) return;

    const reduceMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)',
    ).matches;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const track = entry.target;
          const bar = track.querySelector('.rating-bar');
          if (!bar) return;
          if (reduceMotion) bar.style.transitionDuration = '0ms';
          bar.style.width = bar.dataset.targetWidth || '0%';
          observer.unobserve(track);
        });
      },
      { threshold: 0.4 },
    );

    bars.forEach((bar) => observer.observe(bar.parentElement));

    const scoreEl = document.getElementById('ratings-score');
    if (scoreEl) {
      const target = parseFloat(scoreEl.dataset.targetScore || '0');
      if (reduceMotion) {
        scoreEl.textContent = target.toFixed(1);
      } else {
        const scoreObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const duration = 1200;
              const start = performance.now();
              function tick(now) {
                const progress = Math.min((now - start) / duration, 1);
                const eased = 1 - Math.pow(1 - progress, 3);
                scoreEl.textContent = (target * eased).toFixed(1);
                if (progress < 1) requestAnimationFrame(tick);
              }
              requestAnimationFrame(tick);
              scoreObserver.unobserve(scoreEl);
            });
          },
          { threshold: 0.5 },
        );
        scoreObserver.observe(scoreEl);
      }
    }
  });
</script>
