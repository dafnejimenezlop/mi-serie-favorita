---
// src/components/sections/Timeline.astro

const ciclos = [
  {
    year: '1953',
    title: 'El Origen',
    shortDesc: 'Se construye la planta nuclear.',
    longDesc:
      'En la época de la posguerra, los cimientos de la tragedia se establecen con la construcción de la central de Winden. Las acciones del pasado comienzan a reescribir el futuro.',
    delay: '100',
  },
  {
    year: '1986',
    title: 'El Nudo',
    shortDesc: 'El agujero de gusano se estabiliza.',
    longDesc:
      'Un misterioso incidente en la central nuclear crea el pasaje en las cuevas. Es la época central donde convergen todos los viajeros y los secretos más oscuros.',
    delay: '300',
  },
  {
    year: '2019',
    title: 'El Final',
    shortDesc: 'Mikkel Nielsen desaparece.',
    longDesc:
      'La aparente calma de Winden se rompe. La desaparición de un niño es el catalizador que detona el apocalipsis y cierra el círculo interminable de las tres épocas.',
    delay: '500',
  },
];
---

<section
  id="ciclos"
  class="py-16 md:py-24 bg-transparent transition-colors duration-300 overflow-hidden relative"
>
  <div class="container mx-auto px-6 text-center space-y-12 md:space-y-24">
    <div class="space-y-3">
      <span class="block font-mono text-[11px] tracking-[0.3em] uppercase text-amber-800 dark:text-amber-500" data-aos="fade-up">Cronología</span>
      <h2
        class="text-3xl md:text-5xl font-cinzel text-amber-700 dark:text-amber-500 font-bold tracking-[0.08em] leading-tight uppercase transition-colors text-center drop-shadow-lg"
        data-aos="zoom-in"
        data-aos-duration="1000"
      >
        Los Tres Ciclos del Tiempo
      </h2>
    </div>

    <div class="relative max-w-6xl mx-auto">
      <div
        class="hidden lg:block absolute top-[40%] left-10 right-10 h-[1px] bg-gradient-to-r from-transparent via-amber-500/50 to-transparent z-0"
      >
      </div>

      {/* Las tarjetas son oscuras en AMBOS temas por diseño: el ámbar
          brillante de los años solo funciona sobre fondo oscuro. Pero al 60%
          de opacidad, sobre la página clara quedaban en un gris medio y el
          texto stone-300 caía a 4.0:1. Al 88% vuelven a ser una superficie
          oscura de verdad en los dos modos. */}
      {/* Hilo vertical en móvil: une las tres épocas por los huecos entre
          tarjetas, igual que la línea horizontal lo hace en escritorio. */}
      <div
        class="lg:hidden absolute left-1/2 top-0 bottom-0 w-px -translate-x-1/2 bg-gradient-to-b from-transparent via-amber-500/40 to-transparent z-0"
        aria-hidden="true"
      >
      </div>

      {/* El revelado al pasar el ratón solo existe en escritorio (lg). En
          móvil no hay hover: las tarjetas eran cajas de 320 px casi vacías con
          un "Toca para revelar" parpadeando, y el texto importante quedaba
          escondido tras un gesto que nadie adivina. Ahora se lee directamente.
          Además el movimiento pasa a ser solo `transform` (antes animaba
          `margin-top`, que recalcula el layout en cada frame). */}
      <div
        class="grid grid-cols-1 lg:grid-cols-3 gap-6 md:gap-12 relative z-10 max-w-md lg:max-w-none mx-auto"
      >
        {
          ciclos.map((ciclo) => (
            <div
              tabindex="0"
              class="relative group bg-stone-950/95 dark:bg-[#0b0b0b]/95 lg:bg-stone-950/88 lg:dark:bg-black/60 lg:backdrop-blur-md px-6 py-8 md:p-10 rounded-xl border border-stone-800 hover:border-amber-500/60 focus:border-amber-500/60 focus:outline-none shadow-xl hover:shadow-[0_0_30px_rgba(245,158,11,0.15)] focus:shadow-[0_0_30px_rgba(245,158,11,0.15)] transition-[border-color,box-shadow] duration-500 overflow-hidden lg:min-h-[320px] flex flex-col items-center lg:cursor-pointer"
              data-aos="fade-up"
              data-aos-delay={ciclo.delay}
            >
              <div class="absolute inset-0 bg-gradient-to-b from-amber-500/0 to-amber-500/5 opacity-0 group-hover:opacity-100 group-focus:opacity-100 transition-opacity duration-500 z-0" />

              <div class="relative z-10 w-full flex flex-col items-center transition-transform duration-500 lg:mt-10 lg:group-hover:-translate-y-12 lg:group-focus:-translate-y-12">
                <div class="w-3 h-3 rounded-full bg-amber-500/70 lg:bg-stone-600 group-hover:bg-amber-500 group-focus:bg-amber-500 transition-colors duration-500 mb-4 lg:mb-6 shadow-lg group-hover:shadow-[0_0_15px_rgba(245,158,11,0.8)] group-focus:shadow-[0_0_15px_rgba(245,158,11,0.8)]" />

                <h3 class="text-5xl md:text-6xl font-cinzel font-bold text-stone-200 lg:text-stone-300 group-hover:text-amber-500 group-focus:text-amber-500 transition-colors duration-500">
                  {ciclo.year}
                </h3>

                <p class="text-amber-500 group-hover:text-amber-300 group-focus:text-amber-400 mt-3 lg:mt-4 tracking-[0.2em] uppercase text-sm font-bold transition-colors duration-500">
                  {ciclo.title}
                </p>
                <p class="hidden lg:block text-xs text-stone-400 mt-2 font-mono uppercase tracking-wider group-hover:opacity-0 group-focus:opacity-0 transition-opacity duration-300">
                  {ciclo.shortDesc}
                </p>
              </div>

              <div class="relative z-10 mt-5 text-center lg:mt-0 lg:absolute lg:bottom-6 lg:left-0 lg:w-full lg:px-8 lg:opacity-0 lg:translate-y-8 lg:group-hover:opacity-100 lg:group-focus:opacity-100 lg:group-hover:translate-y-0 lg:group-focus:translate-y-0 transition-[opacity,transform] duration-500 ease-out lg:delay-75 lg:pointer-events-none">
                <div class="h-px w-12 bg-amber-500/30 mx-auto mb-4" />
                <p class="text-sm text-stone-300 font-light leading-relaxed">
                  {ciclo.longDesc}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <div data-aos="fade-in" data-aos-delay="600">
      <p
        class="text-stone-600 dark:text-stone-400 font-cinzel italic tracking-widest text-sm md:text-base"
      >
        "El principio es el fin, y el fin es el principio."
      </p>
    </div>
  </div>
</section>
