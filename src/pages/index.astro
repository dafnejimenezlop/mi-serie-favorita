---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import Ratings from '../components/sections/Ratings.astro';
import Timeline from '../components/sections/Timeline.astro';
import Countdown from '../components/sections/Countdown.astro';
import Curiosidades from '../components/sections/Curiosidades.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import FraseDelDia from '../components/sections/FraseDelDia.astro';
import Explore from '../components/sections/Explore.astro';
import Whatsapp from '../components/Whatsapp.astro';
import Resumen from '../components/Resumen.astro';
import Aclaraciones from '../components/Aclaraciones.astro';
import Familias from '../components/Familias.astro';
import Recomendaciones from '../components/Recomendaciones.astro';
import AsistenteWinden from '../components/AsistenteWinden.astro';
import Galeria from '../components/Galeria.astro';
---

<BaseLayout title="DARK - Sic Mundus">
  <div id="vista-inicio" class="block transition-opacity duration-500">
    <Hero />
    <Ratings />
    <Timeline />
    <Countdown />
    <Curiosidades />
    <Testimonials />
    <FraseDelDia />
    <Explore />
  </div>

  <div id="vista-resumen" class="hidden transition-opacity duration-500">
    <Resumen />
  </div>

  <div id="vista-aclaraciones" class="hidden transition-opacity duration-500">
    <Aclaraciones />
  </div>

  <div id="vista-personajes" class="hidden transition-opacity duration-500">
    <Familias />
  </div>

  <div id="vista-recomendaciones" class="hidden transition-opacity duration-500">
    <Recomendaciones />
  </div>

  <div id="vista-galeria" class="hidden transition-opacity duration-500">
    <Galeria />
  </div>

  <Whatsapp />
  <AsistenteWinden />
</BaseLayout>

<script is:inline>
  // Recuerda la última vista mostrada para distinguir un cambio real de
  // sección (p.ej. #inicio -> #resumen, que debe resetear el scroll al
  // principio) de un ancla interna dentro de la misma vista (p.ej.
  // #sinopsis, #ciclos, #testimonios dentro de Inicio, que debe desplazar
  // hasta ese bloque en vez de cancelarlo).
  let vistaAnterior = null;

  function controlarVistas() {
    const hash = window.location.hash || '#inicio';
    const vistas = [
      'vista-inicio',
      'vista-resumen',
      'vista-aclaraciones',
      'vista-personajes',
      'vista-recomendaciones',
      'vista-galeria',
    ];

    // Decidir cuál es la vista activa
    let vistaActiva = 'vista-inicio';
    if (hash === '#resumen') vistaActiva = 'vista-resumen';
    if (hash === '#aclaraciones') vistaActiva = 'vista-aclaraciones';
    if (hash === '#personajes') vistaActiva = 'vista-personajes';
    if (hash === '#recomendaciones') vistaActiva = 'vista-recomendaciones';
    if (hash === '#galeria') vistaActiva = 'vista-galeria';

    // Mostrar solo la vista activa y ocultar el resto
    vistas.forEach((v) => {
      const el = document.getElementById(v);
      if (el) {
        if (v === vistaActiva) {
          el.classList.remove('hidden');
          el.classList.add('block');
        } else {
          el.classList.add('hidden');
          el.classList.remove('block');
        }
      }
    });

    const cambioDeVista = vistaActiva !== vistaAnterior;
    vistaAnterior = vistaActiva;

    if (cambioDeVista) {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    } else {
      // Misma vista: si el hash apunta a un ancla real dentro de ella
      // (como #sinopsis, #ciclos o #testimonios en Inicio), desplázate
      // hasta ese bloque en vez de no hacer nada.
      const target = document.getElementById(hash.slice(1));
      if (target) {
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }

    // Forzar a AOS a que actualice las animaciones al cambiar
    setTimeout(() => {
      if (typeof AOS !== 'undefined') AOS.refresh();
    }, 50);

    // Resetear las pestañas a la primera cuando entras en cada sección
    if (
      vistaActiva === 'vista-resumen' &&
      typeof window.resetResumenTabs === 'function'
    ) {
      window.resetResumenTabs();
    }
    if (
      vistaActiva === 'vista-aclaraciones' &&
      typeof window.resetAclaracionesTabs === 'function'
    ) {
      window.resetAclaracionesTabs();
    }
    if (
      vistaActiva === 'vista-personajes' &&
      typeof window.resetPersonajesTabs === 'function'
    ) {
      window.resetPersonajesTabs();
    }
    if (
      vistaActiva === 'vista-recomendaciones' &&
      typeof window.resetRecomendacionesTabs === 'function'
    ) {
      window.resetRecomendacionesTabs();
    }
    if (
      vistaActiva === 'vista-galeria' &&
      typeof window.resetGaleriaTabs === 'function'
    ) {
      window.resetGaleriaTabs();
    }
  }

  document.addEventListener('DOMContentLoaded', controlarVistas);
  window.addEventListener('hashchange', controlarVistas);
</script>
