---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import Ratings from '../components/sections/Ratings.astro';
import Timeline from '../components/sections/Timeline.astro';
import Countdown from '../components/sections/Countdown.astro';
import Curiosidades from '../components/sections/Curiosidades.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import FraseDelDia from '../components/sections/FraseDelDia.astro';
import Explore from '../components/sections/Explore.astro';
import Whatsapp from '../components/Whatsapp.astro';
import Resumen from '../components/Resumen.astro';
import Aclaraciones from '../components/Aclaraciones.astro';
import Familias from '../components/Familias.astro';
import Recomendaciones from '../components/Recomendaciones.astro';
import AsistenteWinden from '../components/AsistenteWinden.astro';
import Galeria from '../components/Galeria.astro';
---

<BaseLayout title="DARK - Sic Mundus">
  <div id="vista-inicio" class="block transition-opacity duration-200 ease-out">
    <Hero />
    <Ratings />
    <Timeline />
    <Countdown />
    <Curiosidades />
    <Testimonials />
    <FraseDelDia />
    <Explore />
  </div>

  <div id="vista-resumen" class="hidden transition-opacity duration-200 ease-out">
    <Resumen />
  </div>

  <div id="vista-aclaraciones" class="hidden transition-opacity duration-200 ease-out">
    <Aclaraciones />
  </div>

  <div id="vista-personajes" class="hidden transition-opacity duration-200 ease-out">
    <Familias />
  </div>

  <div id="vista-recomendaciones" class="hidden transition-opacity duration-200 ease-out">
    <Recomendaciones />
  </div>

  <div id="vista-galeria" class="hidden transition-opacity duration-200 ease-out">
    <Galeria />
  </div>

  <Whatsapp />
  <AsistenteWinden />
</BaseLayout>

<script is:inline>
  // Recuerda la última vista mostrada para distinguir un cambio real de
  // sección (p.ej. #inicio -> #resumen, que debe resetear el scroll al
  // principio) de un ancla interna dentro de la misma vista (p.ej.
  // #sinopsis, #ciclos, #testimonios dentro de Inicio, que debe desplazar
  // hasta ese bloque en vez de cancelarlo).
  let vistaAnterior = null;

  const VISTAS = [
    'vista-inicio',
    'vista-resumen',
    'vista-aclaraciones',
    'vista-personajes',
    'vista-recomendaciones',
    'vista-galeria',
  ];

  // hash -> id de la vista. Antes eran cinco `if` encadenados que había que
  // tocar en dos sitios cada vez que se añadía una sección.
  const VISTA_POR_HASH = {
    '#resumen': 'vista-resumen',
    '#aclaraciones': 'vista-aclaraciones',
    '#personajes': 'vista-personajes',
    '#recomendaciones': 'vista-recomendaciones',
    '#galeria': 'vista-galeria',
  };

  // Cada vista con pestañas expone su propio reset; el router solo necesita
  // saber a quién llamar.
  const RESET_POR_VISTA = {
    'vista-resumen': 'resetResumenTabs',
    'vista-aclaraciones': 'resetAclaracionesTabs',
    'vista-personajes': 'resetPersonajesTabs',
    'vista-recomendaciones': 'resetRecomendacionesTabs',
    'vista-galeria': 'resetGaleriaTabs',
  };

  // El fundido entre vistas NO existía: los seis contenedores llevaban
  // `transition-opacity duration-500`, pero el cambio se hacía con `hidden`
  // (display:none), que no transiciona — la clase no hacía absolutamente
  // nada y navegar entre secciones era un corte seco. Como las vistas son
  // páginas completas, superponerlas duplicaría la altura del documento: el
  // gesto correcto es fundir a cero, intercambiar y volver a entrar.
  const DURACION_SALIDA = 200;
  const sinMovimiento = window.matchMedia(
    '(prefers-reduced-motion: reduce)',
  ).matches;

  function pintarVista(vistaActiva, hash, cambioDeVista) {
    VISTAS.forEach((v) => {
      const el = document.getElementById(v);
      if (!el) return;
      const esActiva = v === vistaActiva;
      el.classList.toggle('hidden', !esActiva);
      el.classList.toggle('block', esActiva);
      if (!esActiva) el.classList.remove('opacity-0');
    });

    const activa = document.getElementById(vistaActiva);

    if (cambioDeVista) {
      // Instantáneo, no `smooth`: la vista anterior ya se ha desvanecido, así
      // que un desplazamiento suave sobre contenido que ya no está solo
      // retrasa la entrada de la nueva.
      window.scrollTo({ top: 0, behavior: 'auto' });

      if (activa && !sinMovimiento) {
        activa.classList.add('opacity-0');
        // Un reflujo forzado antes de quitar la clase: sin él el navegador
        // agrupa las dos escrituras y no hay transición que animar.
        void activa.offsetHeight;
        activa.classList.remove('opacity-0');
      }
    } else {
      // Misma vista: si el hash apunta a un ancla real dentro de ella
      // (como #sinopsis, #ciclos o #testimonios en Inicio), desplázate
      // hasta ese bloque en vez de no hacer nada.
      const target = document.getElementById(hash.slice(1));
      if (target) {
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }

    // Forzar a AOS a que actualice las animaciones al cambiar
    setTimeout(() => {
      if (typeof AOS !== 'undefined') AOS.refresh();
    }, 50);

    // Resetear las pestañas a la primera cuando entras en cada sección
    const reset = RESET_POR_VISTA[vistaActiva];
    if (reset && typeof window[reset] === 'function') window[reset]();
  }

  function controlarVistas() {
    const hash = window.location.hash || '#inicio';
    const vistaActiva = VISTA_POR_HASH[hash] || 'vista-inicio';

    const cambioDeVista = vistaActiva !== vistaAnterior;
    const anterior = vistaAnterior
      ? document.getElementById(vistaAnterior)
      : null;
    vistaAnterior = vistaActiva;

    if (!cambioDeVista || !anterior || sinMovimiento) {
      pintarVista(vistaActiva, hash, cambioDeVista);
      return;
    }

    anterior.classList.add('opacity-0');
    window.setTimeout(
      () => pintarVista(vistaActiva, hash, cambioDeVista),
      DURACION_SALIDA,
    );
  }

  document.addEventListener('DOMContentLoaded', controlarVistas);
  window.addEventListener('hashchange', controlarVistas);
</script>
